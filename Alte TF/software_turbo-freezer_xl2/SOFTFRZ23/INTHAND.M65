0100 ;
0110 ;-------------------------------
0120 ;IRQ & NMI INTERRUPT HANDLERS
0130 ;-------------------------------
0140 ;
0150 MYVBL INC RTCLOK+2
0160       BNE MYVB1
0170       INC RTCLOK+1
0180       BNE MYVB1
0190       INC RTCLOK
0200 ;
0210 MYVB1 LDA CDTMV1          ; PROCESS SYSTEM TIMER 1
0220       ORA CDTMV1+1
0230       BEQ MYVB3           ; NOT RUNNING
0240       LDA CDTMV1          ; DECREMENT
0250       BNE MYVB2
0260       DEC CDTMV1+1
0270 MYVB2 DEC CDTMV1
0280       LDA CDTMV1
0290       ORA CDTMV1+1
0300       BNE MYVB3           ; NOT YET ZERO
0310       JSR MYVB4           ; EXECUTE ROUTINE
0320 ;
0330 MYVB3 PLA 
0340       TAY 
0350       PLA 
0360       TAX 
0370       PLA 
0380       RTI 
0390 ;
0400 MYVB4 JMP (CDTMA1)
0410 ;
0420 ;INTERRUPT HANDLER & SIO SUPPORT
0430 ;
0440 MYIRQ PHA 
0450       TYA 
0460       PHA 
0470       LDA #$20            ; SERIN READY INT?
0480       BIT IRQST
0490       BNE MYIRQ7          ; NO
0500 ;
0510       JSR RIRQ
0520       LDA SKSTAT
0530       STA SKRES
0540       BMI MYIRQ1          ; NO FRAMING ERROR
0550       LDY #$8C
0560       STY STATUS
0570 MYIRQ1 AND #$20
0580       BNE MYIRQ2          ; NO OVERRUN ERROR
0590       LDY #$8E
0600       STY STATUS
0610 MYIRQ2 LDA BUFRFL
0620       BEQ MYIRQ4          ; BUFFER NOT YET FULL
0630 ;
0640       LDA SERIN           ; BYTE IS CHECKSUM
0650       CMP CHKSUM
0660       BEQ MYIRQ3          ; CHECKSUM MATCH
0670       LDY #$8F
0680       STY STATUS          ; CHECKSUM ERROR
0690 ;
0700 MYIRQ3 LDA #$FF
0710       STA RECVDN
0720 MYIRQX JMP MYIR16
0730 ;
0740 MYIRQ4 LDA SERIN          ; BYTE IS DATA
0750       LDY #0
0760       STA (BUFRLO),Y
0770       CLC                 ; ADD TO CHECKSUM
0780       ADC CHKSUM
0790       ADC #0
0800       STA CHKSUM
0810       INC BUFRLO          ; INC BUFFER POINTER
0820       BNE MYIRQ5
0830       INC BUFRHI
0840 MYIRQ5 LDA BUFRLO
0850       CMP BFENLO
0860       LDA BUFRHI
0870       SBC BFENHI
0880       BCC MYIRQX          ; BUFFER NOT YET FULL
0890 ;
0900       LDA NOCKSM
0910       BEQ MYIRQ6          ; CHECKSUM WILL FOLLOW
0920       LDA #0
0930       STA NOCKSM
0940       BEQ MYIRQ3          ; ALWAYS
0950 ;
0960 MYIRQ6 LDA #$FF           ; SET BUFFER FULL FLAG
0970       STA BUFRFL
0980       BNE MYIRQX          ; ALWAYS
0990 ;
1000 MYIRQ7 LSR A              ; SEROUT RDY INT?
1010       BIT IRQST
1020       BNE MYIR12          ; NO
1030 ;
1040       LSR A               ; COMMAND FRAME?
1050       BIT PBCTL
1060       BNE MYIRQ8          ; NO
1070       LDA TURFLG          ; TURBO ON?
1080       BEQ MYIRQ8          ; NO
1090       LDA CAUX2           ; ACTIVATE TURBO
1100       ORA #$80
1110       STA CAUX2
1120 ;
1130 MYIRQ8 LDA #$10
1140       JSR RIRQ
1150       INC BUFRLO          ; INC BUFFER POINTER
1160       BNE MYIRQ9
1170       INC BUFRHI
1180 MYIRQ9 LDA BUFRLO
1190       CMP BFENLO
1200       LDA BUFRHI
1210       SBC BFENHI
1220       BCC MYIR11          ; BUFFER NOT YET EMPTY
1230 ;
1240       LDA CHKSNT
1250       BNE MYIR10          ; CHECKSUM ALREADY SENT
1260       LDA CHKSUM          ; SEND CHECKSUM
1270       STA SEROUT
1280       LDA #$FF            ; SET CHECKSUM SENT FLAG
1290       STA CHKSNT
1300       BNE MYIR16          ; ALWAYS
1310 ;
1320 MYIR10 LDA POKMSK         ; ENABLE XMIT DONE INTERRUPT
1330       ORA #$08
1340       STA POKMSK
1350       STA IRQEN
1360       BNE MYIR16          ; ALWAYS
1370 ;
1380 MYIR11 LDY #0             ; SEND BYTE FROM BUFFER
1390       LDA (BUFRLO),Y
1400       STA SEROUT
1410       CLC                 ; ADD TO CHECKSUM
1420       ADC CHKSUM
1430       ADC #0
1440       STA CHKSUM
1450       JMP MYIR16
1460 ;
1470 MYIR12 LSR A              ; SEROUT COMPLETE IRQ?
1480       BIT POKMSK
1490       BEQ MYIR15          ; NO
1500       BIT IRQST
1510       BNE MYIR15
1520       JSR RIRQ
1530 ;
1540       LDA CHKSNT          ; CHECKSUM SENT?
1550       BEQ MYIR14          ; NO
1560       STA XMTDON          ; SET XMIT DONE FLAG
1570       LDA CAUX2           ; TURBO?
1580       BPL MYIR13          ; NO
1590       LDA #6
1600       STA AUDF3           ; SET 70000 BAUD
1610 ;
1620 MYIR13 LDA POKMSK         ; DISABLE TRANSMIT DONE IRQ
1630       AND #$F7
1640       STA POKMSK
1650       STA IRQEN
1660 ;
1670 MYIR14 JMP MYIR16
1680 ;
1690 MYIR15 BIT IRQST          ; BREAK KEY?
1700       PHP 
1710       LDA #$FF
1720       JSR RIRQ            ; RESET ALL INTS
1730       PLP 
1740       BMI MYIR16          ; NO
1750       LDA #0
1760       STA BRKKEY
1770 ;
1780 MYIR16 PLA 
1790       TAY 
1800       PLA 
1810       RTI 
1820 ;
1830 RIRQ  EOR #$FF            ; RESET INTERRUPT
1840       STA IRQEN
1850       LDA POKMSK
1860       STA IRQEN
1870       RTS 
