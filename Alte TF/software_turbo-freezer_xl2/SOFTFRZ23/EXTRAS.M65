0100 ;-------------------------------
0110 ;
0120 ;DISPLAY/ALTER CPU REGISTERS
0130 ;
0140 CPU   CMP #'<-$20
0150       BEQ CPU6            ; ALTER
0160       CMP #'E-$20
0170       BNE CPU1
0180       CPX #'N-$20
0190       BNE CPU1
0200       JMP RENCMD          ; RENAME FILE
0210 ;
0220 CPU1  JSR SCROLL
0230       LDY #6
0240       JSR PRTSTR
0250       JSR SCROLL
0260       JSR CPU3
0270       LDA REGA
0280       JSR CPU2
0290       LDA REGX
0300       JSR CPU2
0310       LDA REGY
0320       JSR CPU2
0330       LDA REGS
0340       JSR CPU2
0350       LDA #1
0360       STA RPNT+1
0370       CLC 
0380       ADC REGS
0390       STA RPNT
0400       LDY #0
0410       JSR GETBYT
0420       JSR CPU4
0430       JSR CPU3
0440       INC RPNT
0450       LDY #0
0460       JSR GETBYT
0470       PHA 
0480       INC RPNT
0490       LDY #0
0500       JSR GETBYT
0510       TAX 
0520       PLA 
0530       JSR PRTADR
0540       JMP DEBU3
0550 ;
0560 CPU2  JSR PRTBYT
0570 CPU3  LDA #$20
0580       JMP PUTBYT
0590 CPU4  LDX #8
0600 CPU5  ASL A
0610       PHA 
0620       LDA #$30
0630       ADC #0
0640       JSR PUTBYT
0650       PLA 
0660       DEX 
0670       BNE CPU5
0680       RTS 
0690 ;
0700 ;ALTER CPU REGISTERS
0710 ;
0720 CPU6  LDA #3
0730       STA NCOUNT
0740       JSR PARBYT          ; PARSE BYTE
0750       BCC CPU7
0760       STA REGA
0770 CPU7  JSR PARBYT
0780       BCC CPU8
0790       STA REGX
0800 CPU8  JSR PARBYT
0810       BCC CPU9
0820       STA REGY
0830 CPU9  JSR PARBYT
0840       BCC CP10
0850       STA REGS
0860 CP10  LDA #1
0870       STA RPNT+1
0880       CLC 
0890       ADC REGS
0900       STA RPNT
0910       JSR PARBYT
0920       BCC CP11
0930       LDY #0
0940       JSR STOBYT
0950 CP11  JMP CPU1
0960 ;
0970 ;PARSE BYTE
0980 ;
0990 PARBYT LDA #0
1000       JSR MATCH
1010       INC NCOUNT          ; IGNORE SEPERATOR
1020       RTS 
1030 ;
1040 ;STORE BYTE TO (RPNT),Y
1050 ;
1060 STOBYT PHA 
1070       TYA                 ; CALC ADDRESS
1080       CLC 
1090       ADC RPNT
1100       TAY 
1110       LDA RPNT+1
1120       ADC #0
1130       TAX 
1140       CMP #$41
1150       BEQ STOBY7          ; CPAGE, SPECIAL CASE
1160       CMP #$D1            ; DISK BUFFER?
1170       BEQ STOB11
1180       CMP #$D0
1190       BEQ STOB10          ; GTIA
1200       CMP #$D2
1210       BEQ STOBY9          ; POKEY
1220       CMP #$D4
1230       BEQ STOBY8          ; ANTIC
1240       CMP #$D3
1250       BEQ STOBY5          ; PIA
1260       AND #$F8
1270       CMP #$D0
1280       BEQ STOBY6          ; IO AREA
1290       TXA 
1300       PHA 
1310       LDX #$0B
1320 STOBY1 LDA CPAGE,X
1330       STA USEMAP,X
1340       LDA STOBY2,X
1350       STA CPAGE,X
1360       DEX 
1370       BPL STOBY1
1380       PLA 
1390       STA CPAGE+5
1400       STY CPAGE+4
1410       JSR NOJERK
1420       PLA 
1430       JMP CPAGE
1440 ;
1450 STOBY2 STA BRKCTL
1460       STA $EEEE
1470       STA BRKCTL
1480       JMP STOBY3
1490 ;
1500 STOBY3 LDA #$FF
1510       STA PORTB
1520       LDX #$0B
1530 STOBY4 LDA USEMAP,X
1540       STA CPAGE,X
1550       DEX 
1560       BPL STOBY4
1570       RTS 
1580 ;
1590 STOBY5 TYA 
1600       AND #$07
1610       CMP #6
1620       BCS STOBY6
1630       TAX 
1640       PLA 
1650       STA SPORTA,X
1660 STOBY6 RTS 
1670 ;
1680 STOBY7 PLA 
1690       STA CPAGE,Y
1700       RTS 
1710 ;
1720 STOBY8 TYA 
1730       AND #$0F
1740       TAX 
1750       PLA 
1760       STA SANTIC,X
1770       RTS 
1780 ;
1790 STOBY9 TYA 
1800       AND #$0F
1810       TAX 
1820       PLA 
1830       STA SPOKEY,X
1840       RTS 
1850 ;
1860 STOB10 TYA 
1870       AND #$1F
1880       TAX 
1890       PLA 
1900       STA SGTIA,X
1910       RTS 
1920 ;
1930 STOB11 PLA 
1940       STA DBUF,Y
1950       RTS 
1960 ;
1970 ;-------------------------------
1980 ;RENAME FILE
1990 ;
2000 RENCMD JSR GFNAME
2010       INC NCOUNT
2020       LDX #10
2030 RENCM1 LDA NAME,X
2040       STA VTOC,X
2050       DEX 
2060       BPL RENCM1
2070       JSR FDECOD
2080       LDX #10
2090 RENCM2 LDA NAME,X
2100       LDY VTOC,X
2110       STA VTOC,X
2120       TYA 
2130       STA NAME,X
2140       DEX 
2150       BPL RENCM2
2160       JSR GETOPT
2170       JSR RENAME
2180       JMP DEBU3
2190 ;
2200 RENAME JSR IUTILS
2210 RENAM1 JSR SEARC1
2220       BCC RENAM5          ; NO MATCH, EXIT
2230       LDA DENTRY
2240       AND #$20
2250       BNE RENAM3          ; LOCKED, SKIP
2260       LDA #7
2270       JSR QUERY
2280       BNE RENAM3          ; DON'T RENAME
2290 RENAM2 JSR DIRACC
2300       LDY #0
2310 RENAM6 LDA VTOC,Y         ; REPLACE PATTERN
2320       CMP #'?
2330       BNE RENAM7
2340       LDA DENTRY+5,Y
2350 RENAM7 STA DBUF+5,X
2360       INX 
2370       INY 
2380       CPY #11
2390       BNE RENAM6
2400       JSR WSEC
2410 RENAM3 JSR NEXENT
2420       BCC RENAM1
2430 RENAM5 RTS 
2440 ;
2450 ;-------------------------------
2460 ;UNLOCK FILES
2470 ;
2480 COMU  JSR GFNAME
2490       JSR GETOPT
2500       JSR UNLOCK
2510       JMP DEBU3
2520 ;
2530 UNLOCK JSR IUTILS
2540 UNLOC1 JSR SEARC1
2550       BCC UNLOC5          ; NO MATCH, EXIT
2560       LDA DENTRY
2570       AND #$20
2580       BEQ UNLOC3          ; UNLOCKED, SKIP
2590       LDA #9
2600       JSR QUERY
2610       BNE UNLOC3          ; DON'T UNLOCK
2620 UNLOC2 JSR DIRACC
2630       LDA DBUF,X
2640       AND #$DF
2650       STA DBUF,X
2660       JSR WSEC
2670 UNLOC3 JSR NEXENT
2680       BCC UNLOC1
2690 UNLOC5 RTS 
2700 ;
2710 ;LOCK FILES
2720 ;
2730 FLOCK JSR GFNAME
2740       JSR GETOPT
2750       JSR LOCK
2760       JMP DEBU3
2770 ;
2780 LOCK  JSR IUTILS
2790 LOC1  JSR SEARC1
2800       BCC LOC5            ; NO MATCH, EXIT
2810       LDA DENTRY
2820       AND #$20
2830       BNE LOC3            ; LOCKED, SKIP
2840       LDA #8
2850       JSR QUERY
2860       BNE LOC3            ; DON'T LOCK
2870 LOC2  JSR DIRACC
2880       LDA DBUF,X
2890       ORA #$20
2900       STA DBUF,X
2910       JSR WSEC
2920 LOC3  JSR NEXENT
2930       BCC LOC1
2940 LOC5  RTS 
2950 ;
2960 ;LOCK/LOAD FILE, DISASM COMMANDS
2970 ;
2980 COML  CMP #'O-$20
2990       BNE COML2
3000       CPX #'C-$20
3010       BNE COML1
3020       JMP FLOCK
3030 COML1 CPX #'A-$20
3040       BNE COML2
3050       JMP BLOAD
3060 ;
3070 ;DISASSEMBLY
3080 ;
3090 COML2 LDA #0
3100       STA OPTION
3110       JSR MATCH
3120       BCC DASM1
3130       STA RPNT            ; START ADDRESS
3140       STX RPNT+1
3150 DASM1 LDA #',
3160       JSR MATCH
3170       BCC DASM2
3180       LDA #0
3190       JSR MATCH
3200       BCS DASM3
3210 DASM2 LDA #16             ; DISASM 16 LINES
3220       STA OPTION
3230 DASM3 STA TPNT
3240       STX TPNT+1
3250 ;
3260 DASM4 JSR SCROLL
3270       JSR DISASM
3280       JSR ADVADR
3290       PHP 
3300       LDA OPTION
3310       BEQ DASM5           ; TEST FOR ADDRESS
3320       PLP 
3330       DEC OPTION          ; COUNT LINES
3340       BNE DASM4
3350       JMP DEBU3
3360 DASM5 PLP 
3370       BEQ DASM4
3380       BCC DASM4
3390       JMP DEBU3
3400 ;
3410 DISASM LDY #0
3420       JSR GETBYT
3430       STA NCOUNT          ; SAVE OPCODE
3440       LDX #43             ; IMPLIED/SPECIAL OPS
3450 DISAS1 CMP OPTAB1,X
3460       BEQ DISA11
3470       DEX 
3480       BPL DISAS1
3490       LDX #8              ; ILLEGAL OPS?
3500 DISAS2 CMP OPTAB2,X
3510       BEQ DISAS3
3520       DEX 
3530       BPL DISAS2
3540       AND #$0F            ; TRANSFORM OPCODES
3550       TAX 
3560       LDA NCOUNT
3570       LSR A
3580       LSR A
3590       LSR A
3600       LSR A
3610       ORA TRANTB,X
3620       BPL DISAS5
3630 DISAS3 LDA #57            ; ILLEGAL OP
3640       BNE DISA13
3650 DISAS5 PHA 
3660       LSR A
3670       BCC DISAS6
3680       ORA #$40
3690 DISAS6 LSR A
3700       LSR A
3710       LSR A
3720       TAX 
3730       LDA MODETB,X        ; GET MODE
3740       TAY 
3750       PLA 
3760       CMP #$69            ; SOME EXCEPTIONS
3770       BEQ DISAS7
3780       CMP #$6B
3790       BEQ DISAS7
3800       CMP #$7B
3810       BNE DISAS8
3820       LDY #9              ; ABS,Y
3830       BNE DISAS8
3840 DISAS7 LDY #12            ; ZP,Y
3850 DISAS8 LSR A              ; GET MNEMONIC INDEX
3860       CMP #$30
3870       BCC DISAS9
3880       AND #7
3890       TAX 
3900       LDA MNTAB1,X
3910       BNE DISA13
3920 DISAS9 CMP #$20
3930       BCC DISA10
3940       AND #7
3950       TAX 
3960       LDA MNTAB2,X
3970       BNE DISA13
3980 DISA10 AND #7
3990       TAX 
4000       LDA MNTAB3,X
4010       BNE DISA13
4020 DISA11 LDY #11            ; ASSUME IND?
4030       CPX #43
4040       BEQ DISA12
4050       LDY #1              ; ASSUME ABS
4060       CPX #41
4070       BCS DISA12
4080       DEY                 ; ASSUME IMM
4090       CPX #37
4100       BCS DISA12
4110       LDY #10             ; ASSUME REL
4120       CPX #29
4130       BCS DISA12
4140       LDY #3              ; ASSUME ACCUM
4150       CPX #25
4160       BCS DISA12
4170       LDY #4              ; IMPLIED
4180 DISA12 TXA 
4190 DISA13 CMP #57            ; A=MNEMONIC IDX
4200       BNE DISA14
4210       LDY #4              ; ILLEGAL ALWAYS IMP
4220 DISA14 PHA 
4230       TYA 
4240       PHA 
4250       LDA LENTAB,Y
4260       STA NCOUNT
4270       LDA #$20
4280       JSR PUTBYT
4290       LDA RPNT
4300       LDX RPNT+1
4310       JSR PRTADR
4320       LDA #$20
4330       JSR PUTBYT
4340       LDA #$20
4350       JSR PUTBYT
4360       LDY #0
4370 DISA15 STY NAME+3
4380       JSR GETBYT
4390       LDY NAME+3
4400       STA NAME,Y
4410       JSR PRTBYT
4420       LDA #$20
4430       JSR PUTBYT
4440       LDY NAME+3
4450       INY 
4460       DEC NCOUNT
4470       BNE DISA15
4480 DISA16 LDA #$20
4490       JSR PUTBYT
4500       LDA DCOUNT
4510       CMP #20
4520       BNE DISA16
4530       PLA 
4540       TAY 
4550       PLA 
4560       STA NCOUNT
4570       ASL A
4580       ADC NCOUNT
4590       TAX 
4600       STY NCOUNT
4610       LDY #3
4620 DISA17 LDA MNETAB,X
4630       JSR PUTBYT
4640       INX 
4650       DEY 
4660       BNE DISA17
4670       LDA #$20
4680       JSR PUTBYT
4690       LDX NCOUNT
4700       LDA PRFTAB,X
4710       STA NCOUNT
4720       LDA LENTAB,X
4730       STA NAME+3
4740 ;
4750       LDA #7
4760       STA NAME+4
4770 DISA18 ASL NCOUNT
4780       BCC DISA25
4790       LDY NAME+4
4800       LDA DPRTTB,Y
4810       BEQ DISA21          ; PRINT ADR OR DEST
4820       BMI DISA20          ; PRINT BYTE
4830       CMP #'X
4840       BCC DISA19          ; PRINT CHAR
4850       PHA 
4860       LDA #',             ; PRINT ,X OR ,Y
4870       JSR PUTBYT
4880       PLA 
4890 DISA19 JSR PUTBYT
4900       JMP DISA25
4910 DISA20 LDA #'$
4920       JSR PUTBYT
4930       LDA NAME+1
4940       JSR PRTBYT
4950       JMP DISA25
4960 DISA21 LDA #'$
4970       JSR PUTBYT
4980       LDA NAME+1
4990       LDX NAME+2
5000       LDY NAME+3
5010       CPY #2
5020       BNE DISA24
5030       LDX RPNT+1          ; CALC DEST
5040       TAY 
5050       BPL DISA22
5060       DEX 
5070 DISA22 SEC 
5080       ADC RPNT
5090       BCC DISA23
5100       INX 
5110 DISA23 CLC 
5120       ADC #1
5130       BCC DISA24
5140       INX 
5150 DISA24 JSR PRTADR
5160 DISA25 DEC NAME+4
5170       BPL DISA18
5180 DISA28 LDA NAME+3
5190       RTS 
5200 ;
5210 DPRTTB .BYTE "Y)X",0,$80,"(#A"
5220 ;
5230 MNETAB .BYTE "BRKCLCCLDCLI"
5240       .BYTE "CLVDEXDEYINX"
5250       .BYTE "INYNOPPHAPHP"
5260       .BYTE "PLAPLPRTIRTS"
5270       .BYTE "SECSEDSEITAX"
5280       .BYTE "TAYTSXTXATXS"
5290       .BYTE "TYAASLROLLSR"
5300       .BYTE "RORBCCBCSBEQ"
5310       .BYTE "BMIBNEBPLBVC"
5320       .BYTE "BVSLDXLDYCPX"
5330       .BYTE "CPYJSRJMPJMP"
5340       .BYTE "ADCANDCMPDEC"
5350       .BYTE "EORINCLDAORA"
5360       .BYTE "SBCSTASTXSTY"
5370       .BYTE "BIT???"
5380 ;
5390 OPTAB1 .BYTE $00,$18,$D8,$58
5400       .BYTE $B8,$CA,$88,$E8
5410       .BYTE $C8,$EA,$48,$08
5420       .BYTE $68,$28,$40,$60
5430       .BYTE $38,$F8,$78,$AA
5440       .BYTE $A8,$BA,$8A,$9A
5450       .BYTE $98,$0A,$2A,$4A
5460       .BYTE $6A,$90,$B0,$F0
5470       .BYTE $30,$D0,$10,$50
5480       .BYTE $70,$A2,$A0,$E0
5490       .BYTE $C0,$20,$4C,$6C
5500 ;
5510 OPTAB2 .BYTE $89,$9E,$9C,$34
5520       .BYTE $3C,$D4,$DC,$F4,$FC
5530 ;
5540 TRANTB .BYTE $80,$10,$80,$80
5550       .BYTE $50,$20,$60,$80
5560       .BYTE $80,$00,$80,$80
5570       .BYTE $40,$30,$70,$80
5580 ;
5590 MNTAB1 .BYTE 25,26,27,28
5600       .BYTE 54,37,47,49
5610 ;
5620 MNTAB2 .BYTE 57,56,57,57
5630       .BYTE 55,38,40,39
5640 ;
5650 MNTAB3 .BYTE 51,45,48,44
5660       .BYTE 53,50,46,52
5670 ;
5680 MODETB .BYTE 0,5,2,1,1,2,2,1
5690       .BYTE 9,6,7,8,8,7,7,8
5700 ;
5710 LENTAB .BYTE 2,3,2,1,1,2,2,2
5720       .BYTE 3,3,2,3,2
5730 ;
5740 PRFTAB .BYTE $50,$08,$10,$80
5750       .BYTE $00,$36,$33,$14
5760       .BYTE $0C,$09,$08,$2A,$11
5770 ;
5780 ;FORMAT DISK
5790 ;
5800 COMF  CMP #'M-$20
5810       BNE COMF1
5820       LDY #0
5830       CPX #'S-$20
5840       BEQ COMF4
5850       CPX #'E-$20
5860       BEQ COMF3
5870       CPX #'D-$20
5880       BEQ COMF2
5890 COMF1 JMP DEBU3
5900 COMF2 INY 
5910 COMF3 INY 
5920 COMF4 STY OPTION          ; FORMAT SD,ED,DD
5930       JSR DENSTY          ; FOR TURFLG
5940       LDA #12             ; GET PERCOM BLOCK
5950       STA SIZE
5960       LDA #$4E
5970       LDX #$40
5980       JSR WSE1
5990       DEY 
6000       BNE COMF8           ; NOT PERCOM
6010       LDY OPTION
6020       LDA #$1A
6030       CPY #1
6040       BEQ COMF5
6050       LDA #$12
6060 COMF5 STA DBUF+3
6070       LDA #0
6080       CPY #0
6090       BEQ COMF6
6100       LDA #4
6110 COMF6 STA DBUF+5
6120       LDA #1
6130       LDX #0
6140       CPY #2
6150       BEQ COMF7
6160       LDA #0
6170       LDX #$80
6180 COMF7 STA DBUF+6
6190       STX DBUF+7
6200       LDA #$4F
6210       LDX #$80
6220       JSR WSE1
6230       JSR DENSTY
6240       LDA DENTYP
6250       CMP OPTION
6260       BNE COMF1
6270       LDA #$21
6280       BNE COMF9
6290 ;
6300 COMF8 LDA #$21
6310       LDY OPTION
6320       BEQ COMF9
6330       LDA #$22
6340       DEY 
6350       BNE COMF1
6360 COMF9 PHA 
6370       LDA OPTION
6380       STA DENTYP
6390       JSR IBOOT
6400       PLA 
6410       LDX #$40
6420       JSR WSE1
6430       DEY 
6440       BNE COMF1
6441 ;
6442 ; I am not sure if this was a MAC 65 Bug or another
6443 ; problem, but the original ROM code had this JSR statement
6444 ; assembled to opcode $FF instead of $20.
6445 ; That's the reason for this workaround.
6446 ; Matthias Reichl
6447 ;
6450 ;      JSR DENTYP
6451       .BYTE $FF
6452       .WORD DENTYP
6460 ;
6470 ;DISK FORMATTED, BUILD VTOC
6480 ;
6490       LDA #0
6500       TAX 
6510 COF10 STA VTOC,X
6520       INX 
6530       BNE COF10
6540       LDA #2
6550       STA VTOC
6560       STA VTOC+2
6570       STA VTOC+4
6580       LDA #$C3
6590       STA VTOC+1
6600       STA VTOC+3
6610       LDA #$0F
6620       STA VTOC+$0A
6630       LDA #$64
6640       LDX DENTYP
6650       DEX 
6660       BNE COF11
6670       LDA #$F2
6680       STA VTOC+1
6690       INC VTOC+2
6700       LDA #$2F
6710       STA VTOC+$8A
6720       INC VTOC+$8B
6730       LDA #$8A
6740 COF11 STA OPTION
6750       LDX #$0B
6760       LDA #$FF
6770 COF12 STA VTOC,X
6780       INX 
6790       CPX OPTION
6800       BNE COF12
6810       INC VTOC+$37
6820       LSR VTOC+$38
6830       LDA #$FF
6840       STA FILENO
6850       JSR WVTOC
6860       LDY #10
6870       JSR FDECO5
6880       JSR SCROLL
6890       JSR DDIR
6900       JMP DEBU3
6910 ;
6920 ;READ/WRITE SECTOR
6930 ;
6940 COMS  CMP #'A-$20
6950       BEQ COMS2
6960       CMP #'R-$20
6970       BEQ COMS3
6980       CMP #'W-$20
6990       BEQ COMS5
7000 COMS1 JMP DEBU3
7010 COMS2 CPX #'V-$20
7020       BNE COMS1
7030       JMP BSAVE
7040 COMS3 INC NCOUNT          ; READ SECTOR
7050       JSR DENSTY
7060       JSR IVTOC
7070       LDA #0
7080       JSR MATCH
7090       BCC COMS4
7100       STA DAUX1
7110       STX DAUX2
7120 COMS4 JSR RSEC
7130       JMP DEBU3
7140 ;
7150 COMS5 INC NCOUNT          ; WRITE SECTOR
7160       LDX #0
7170 COMS6 LDA DBUF,X
7180       STA VTOC,X
7190       DEX 
7200       BNE COMS6
7210       JSR DENSTY
7220       JSR IVTOC
7230       LDX #0
7240 COMS7 LDA VTOC,X
7250       STA DBUF,X
7260       DEX 
7270       BNE COMS7
7280       LDA #0
7290       JSR MATCH
7300       BCC COMS8
7310       STA DAUX1
7320       STX DAUX2
7330 COMS8 JSR WSEC
7340       JMP DEBU3
7350 ;
7360 ;FILE DELETE
7370 ;
7380 FDELET JSR IUTILS
7390       JSR RVTOC
7400 FDELE1 JSR SEARC1
7410       BCC FDELE5          ; NO MATCH, EXIT
7420       LDA DENTRY
7430       AND #$20
7440       BNE FDELE3
7450       LDA #5
7460       JSR QUERY
7470       BNE FDELE3          ; DON'T DELETE
7480 FDELE2 JSR DELETE
7490       LDA #$80
7500       STA DENTRY
7510       JSR WVTOC
7520 FDELE3 JSR NEXENT
7530       BCC FDELE1
7540 FDELE5 RTS 
7550 ;
7560 ;GET FILE NAME
7570 ;
7580 GFNAME LDA #5
7590       STA NCOUNT
7600       JMP FDECOD
7610 ;
7620 ;INIT DUP UTILS
7630 ;
7640 IUTILS JSR DENSTY
7650       JSR IVTOC
7660       LDX #$FF
7670       STX MAPMSK
7680       INX 
7690       STX FILENO
7700       RTS 
7710 ;
7720 ;QUERY A
7730 ;
7740 QUERY PHA 
7750       LDA OPTION
7760       CMP #'Q
7770       BNE QUERY2
7780       JSR SCROLL
7790       PLA 
7800       TAY 
7810       JSR PRTSTR
7820       JSR PRTNAM
7830       LDA #'?
7840       JSR PUTBYT
7850       JSR GETKEY
7860       PHA 
7870       LDA #'-
7880       JSR PUTBYT
7890       PLA 
7900       CMP #'Y
7910       BEQ QUERY1
7920       LDA #'N
7930 QUERY1 PHA 
7940       JSR PUTBYT
7950       PLA 
7960       CMP #'Y
7970       RTS 
7980 QUERY2 PLA 
7990       LDA #0
8000       RTS 
8010 ;
8020 ;NEXT ENTRY FOR DUP UTILS
8030 ;CONTINUE IF CY=0
8040 ;
