0100 ;-------------------------------
0110 ;SAVER: DIVIDES SYSTEM STATUS IN
0120 ;       BLOCKS OF LENGTH NCOUNT
0130 ;       AND SAVES THEM VIA CALLS
0140 ;       TO THE DEVICE HANDLERS.
0150 ;-------------------------------
0160 ;
0170 SAVE  LDX #RSVECH-SGTIA
0180 SAV1  LDA SGTIA,X
0190       STA DBUF,X
0200       DEX 
0210       BPL SAV1
0220       JSR WRITE
0230 ;
0240       BIT FILENO
0250       BVS SAV7            ; DON'T COMPACT
0260 ;
0270       LDX #65             ; PREPARE MAP OF USED BLOCKS
0280       LDA #0
0290 SAV2  STA USEMAP,X
0300       DEX 
0310       BPL SAV2
0320       STA MAPIDX
0330       STA RPNT
0340       STA RPNT+1
0350       LDA #$80
0360       STA MAPMSK
0370 SAV3  JSR TOBUF           ; COPY BLOCK TO BUFFER
0380       LDX #0
0390 SAV4  LDA DBUF,X
0400       BNE SAV5            ; NOT ZERO
0410       INX 
0420       CPX DCOUNT
0430       BNE SAV4
0440       LDA NEXT
0450       ORA NEXT+1
0460       BEQ SAV5            ; LAST BLOCK ALWAYS USED
0470       LDX MAPIDX          ; SET BLOCK UNUSED BIT
0480       LDA USEMAP,X
0490       ORA MAPMSK
0500       STA USEMAP,X
0510 SAV5  JSR ADVMAP
0520       JSR ADVPNT
0530       BCC SAV3
0540       LDX #66             ; SAVE MAP
0550       STX DCOUNT
0560       DEX 
0570 SAV6  LDA USEMAP,X
0580       STA DBUF,X
0590       DEX 
0600       BPL SAV6
0610       INC NEXT            ; FORCE SECTOR ALLOCATION
0620       JSR WRITE
0630 ;
0640 SAV7  LDA #0
0650       STA RPNT
0660       STA RPNT+1
0670       STA MAPIDX
0680       LDA #$80
0690       STA MAPMSK
0700       LDA NCOUNT
0710       STA DCOUNT
0720 ;
0730 SAV8  JSR TOBUF
0740       BIT FILENO
0750       BVS SAV9
0760       LDX MAPIDX          ; UNUSED BLOCK?
0770       LDA USEMAP,X
0780       AND MAPMSK
0790       BNE SAV10           ; YES, SKIP
0800 SAV9  JSR WRITE
0810 SAV10 JSR ADVMAP
0820       JSR ADVPNT
0830       BCC SAV8
0840       LDA #$FF
0850       STA PORTB
0860       JMP DMAON
0870 ;
0880 ;COPY DATA FROM (RPNT) TO DBUF
0890 ;
0900 TOBUF LDA RPNT+1          ; (RPNT) TO DBUF
0910       CMP #$40
0920       BCS TOBU5
0930 ;
0940       LDA #0              ; 0000-3FFF
0950       STA DMACTL
0960       LDX #TOBU3-TOBU2
0970 TOBU1 LDA CPAGE,X
0980       STA SPAGE,X
0990       LDA TOBU2,X
1000       STA CPAGE,X
1010       DEX 
1020       BPL TOBU1
1030       LDA RPNT
1040       STA CPAGE+4
1050       LDA RPNT+1
1060       STA CPAGE+5
1070       LDY #0
1080       JMP CPAGE
1090 ;
1100 TOBU2 STA BRKCTL
1110       LDA $EEEE,Y
1120       STA BRKCTL
1130       STA DBUF,Y
1140       INY 
1150       CPY DCOUNT
1160       BNE TOBU2
1170       JMP TOBU3
1180 ;
1190 TOBU3 LDX #TOBU3-TOBU2
1200 TOBU4 LDA SPAGE,X
1210       STA CPAGE,X
1220       DEX 
1230       BPL TOBU4
1240       RTS 
1250 ;
1260 TOBU5 CMP #$BF
1270       BCS TOBU8
1280       LDA #$21            ; 4000-BF00
1290       STA DMACTL
1300 TOBU6 LDY #0
1310 TOBU7 LDA (RPNT),Y
1320       STA DBUF,Y
1330       INY 
1340       CPY DCOUNT
1350       BNE TOBU7
1360       LDA #$FF
1370       STA PORTB
1380       RTS 
1390 ;
1400 TOBU8 LDA #0              ; BF00-FFFF
1410       STA DMACTL
1420       LDA #$FE            ; OS OFF
1430       STA PORTB
1440       BNE TOBU6           ; ALWAYS
1450 ;
1460 ;ADVANCE ONE BIT POS IN USEMAP
1470 ;
1480 ADVMAP LSR MAPMSK
1490       BCC ADVMA1
1500       ROR MAPMSK
1510       INC MAPIDX
1520 ADVMA1 RTS 
1530 ;
1540 ;ADVANCE RPNT ONE BLOCK
1550 ;
1560 ADVPNT LDA NCOUNT
1570       STA DCOUNT
1580       SEC 
1590       BEQ ADVPN0
1600       CLC 
1610       ADC RPNT
1620       STA RPNT
1630 ADVPN0 LDA RPNT+1
1640       ADC #0
1650       STA RPNT+1
1660       BCS ADVPN3          ; ALL BLOCKS DONE
1670       CMP #$CF            ; END PAGES?
1680       BEQ ADVPN1          ; YES
1690       CMP #$FF
1700       BEQ ADVPN1          ; YES
1710       AND #$F8            ; IO AREA?
1720       CMP #$D0
1730       BNE ADVPN2          ; NO
1740       LDA #0              ; SKIP IO AREA
1750       STA RPNT
1760       LDA #$D8
1770       STA RPNT+1
1780       BNE ADVPN2          ; ALWAYS
1790 ADVPN1 LDA RPNT           ; PROCESS END PAGES
1800       CLC 
1810       ADC NCOUNT
1820       BCC ADVPN2          ; STILL ENOUGH DATA
1830       BEQ ADVPN2          ; EXACTLY ONE BLOCK LEFT
1840       LDA #0              ; CALC REMAINING BYTES COUNT
1850       SBC RPNT
1860       STA DCOUNT
1870       LDX RPNT+1          ; LAST BLOCK?
1880       INX 
1890       BNE ADVPN2          ; NO
1900       STX NEXT
1910       STX NEXT+1
1920 ADVPN2 CLC 
1930 ADVPN3 RTS 
1940 ;
1950 ;JUMP TO DEVICE HANDLERS TO
1960 ;SAVE DBUF TO DEVICES
1970 ;
1980 WRITE LDX DEVICE
1990       BEQ WRITE1
2000       DEX 
2010       BEQ WRITE2
2020       JMP WCASS
2030 WRITE1 JMP WRAMD
2040 WRITE2 JMP WDISK
