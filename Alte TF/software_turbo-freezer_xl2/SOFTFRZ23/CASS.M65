0100 ;-------------------------------
0110 ;    CASSETTE DEVICE HANDLER
0120 ;-------------------------------
0130 ECASS JSR OPCR            ; EXEC CASSETTE
0140       JSR INCA
0150       JSR LOAD
0160       JSR CLCR
0170       JMP RSTART
0180 ;
0190 SCASS JSR OPCW            ; SAVE CASSETTE
0200       JSR INCA
0210       JSR SAVE
0220       JSR CLCW
0230       JMP ENDCMD
0240 ;
0250 ;INIT CASSETTE
0260 ;
0270 INCA  LDA #0
0280       STA NEXT+1
0290       STA TURFLG
0300       LDA #$80
0310       STA SIZE
0320       STA NCOUNT
0330       STA FILENO
0340       LDA #2
0350       STA DEVICE
0360       STA NEXT
0370       RTS 
0380 ;
0390 ;OPEN CASSETTE READ
0400 ;
0410 OPCR  JSR BEEP
0420       JSR GETKEY
0430       LDA #$34
0440       STA PACTL
0450       LDA #2
0460       BNE OPC1
0470 ;
0480 ;OPEN CASSETTE WRITE
0490 ;
0500 OPCW  JSR BEEP
0510       JSR BEEP
0520       JSR GETKEY
0530       LDA #$CC
0540       STA AUDF3
0550       LDA #5
0560       STA AUDF4
0570       LDA #$60
0580       STA DDEVIC
0590       JSR SENDEV
0600       LDA #$34
0610       STA PACTL
0620       LDA #4
0630 OPC1  CLC 
0640       ADC RTCLOK+1
0650       LDX #$40
0660       STX NMIEN
0670 OPC2  CMP RTCLOK+1
0680       BNE OPC2
0690       LDA #0
0700       STA NMIEN
0710       RTS 
0720 ;
0730 ;CLOSE READ
0740 ;
0750 CLCR
0760 ;
0770 ;CLOSE WRITE
0780 ;
0790 CLCW  LDA #$3C
0800       STA PACTL
0810       RTS 
0820 ;
0830 ;WRITE CASSETTE BLOCK
0840 ;
0850 WCASS JSR CSIOIN
0860       LDA #$57
0870       STA DCOMND
0880       ASL DSTATS
0890       LDA #$55
0900       STA DBUF-1
0910       STA DBUF-2
0920       BNE RCAS1
0930 ;
0940 ;READ CASSETTE BLOCK
0950 ;
0960 RCASS JSR CSIOIN
0970 RCAS1 LDA #$80
0980       STA POKMSK
0990       STA IRQEN
1000       CLI 
1010       LDA #$40
1020       STA NMIEN
1030       BIT DSTATS
1040       BMI RCAS5
1050       LDA RTCLOK+2
1060       CLC 
1070       ADC #5
1080 RCAS6 CMP RTCLOK+2
1090       BNE RCAS6
1100 RCAS5 JSR SIOV
1110       LDA #0
1120       STA POKMSK
1130       STA IRQEN
1140       SEI 
1150       DEY 
1160       BEQ RCAS2
1170       LDY #8
1180       LDA #$3C
1190       STA PACTL
1200       JMP ERROR
1210 RCAS2 LDA DCOMND
1220       CMP #$57
1230       BNE RCAS4
1240       LDA RTCLOK+2
1250       CLC 
1260       ADC #10
1270 RCAS3 CMP RTCLOK+2
1280       BNE RCAS3
1290 RCAS4 LDA #0
1300       STA NMIEN
1310       RTS 
1320 ;
1330 ;INIT CASSETTE SIO OPERATION
1340 ;
1350 CSIOIN LDX #$0B
1360 CSIOI1 LDA CSITAB,X
1370       STA DDEVIC,X
1380       DEX 
1390       BPL CSIOI1
1400       RTS 
1410 ;
1420 CSITAB .BYTE $60,0,$52,$40
1430       .WORD DBUF-2
1440       .WORD 35
1450       .WORD 130
1460       .BYTE 0,$80
1470 ;
1480 ;BEEP
1490 ;
1500 BEEP  LDA #$40
1510       STA NMIEN
1520 BEEP1 LDA RTCLOK+2
1530       CLC 
1540       ADC #30
1550       TAX 
1560 BEEP2 LDA #$08
1570       STA CONSOL
1580       LDY #$F0
1590 BEEP3 DEY 
1600       BNE BEEP3
1610       STY CONSOL
1620       LDY #$F0
1630 BEEP4 DEY 
1640       BNE BEEP4
1650       CPX RTCLOK+2
1660       BNE BEEP2
1670       LDA RTCLOK+2
1680       CLC 
1690       ADC #10
1700 BEEP5 CMP RTCLOK+2
1710       BNE BEEP5
1720       LDA #0
1730       STA NMIEN
1740       RTS 
