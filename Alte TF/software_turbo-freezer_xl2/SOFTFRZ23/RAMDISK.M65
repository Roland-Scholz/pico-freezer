0100 ;-------------------------------
0110 ;SAVE/EXEC RAMDISK AND HANDLER
0120 ;-------------------------------
0130 DKEY  JSR IRAMD           ; SAVE TO RAMDISK
0140       JSR SAVE
0150       JMP ENDCMD
0160 ;
0170 EKEY  JSR IRAMD           ; EXEC RAMDISK
0180       JSR LOAD
0190       JMP RSTART
0200 ;
0210 ;INIT RAMDISK ACTIONS
0220 ;
0230 IRAMD LDA #0
0240       STA NEXT+1
0250       STA SIZE
0260       STA NCOUNT
0270       STA DEVICE
0280       STA BPNT
0290       LDA #$40
0300       STA BPNT+1
0310       LDA #$E3
0320       STA BANK
0330       STA FILENO
0340       STA NEXT
0350       RTS 
0360 ;
0370 ;WRITE DBUF TO RAMDISK
0380 ;
0390 WRAMD LDA BANK
0400       STA PORTB
0410       LDY #0
0420 WRAM1 LDA DBUF,Y
0430       STA (BPNT),Y
0440       INY 
0450       BNE WRAM1
0460       BEQ RRAM2
0470 ;
0480 ;LOAD DBUF FROM RAMDISK
0490 ;
0500 RRAMD LDA BANK
0510       STA PORTB
0520       LDY #0
0530 RRAM1 LDA (BPNT),Y
0540       STA DBUF,Y
0550       INY 
0560       BNE RRAM1
0570 ;
0580 RRAM2 LDA #$FF
0590       STA PORTB
0600       INC BPNT+1
0610       BPL RRAM3
0620       LDA #$40
0630       STA BPNT+1
0640       LDA BANK
0650       CLC 
0660       ADC #4
0670       STA BANK
0680 RRAM3 RTS 
