0100 ;
0110 ;-------------------------------
0120 ;STOP PAGE: THE HARDWARE WILL
0130 ;           "BEND" THE VECTORS
0140 ;           TO THIS PAGE, HIGH
0150 ;           BYTES ONLY.
0160 ;-------------------------------
0170        NOX  
0180       NOP 
0190       NOP 
0200       NOP 
0210       NOP 
0220       NOP 
0230       NOP 
0240       NOP 
0250       NOP 
0260       JMP STOP
0270        NOX  
0280        NOX  
0290        NOX  
0300        NOX  
0310        NOX  
0320        NOX  
0330        NOX  
0340        NOX  
0350        NOX  
0360        NOX  
0370        NOX  
0380        NOX  
0390        NOX  
0400        NOX  
0410 ;
0420 ;-------------------------------
0430 ;SAVE SYSTEM STATUS, RESET THE
0440 ;CUSTOM CHIPS AND SHOW MENU.
0450 ;-------------------------------
0460 ;
0470 STOP  STA REGA
0480       LDA VCOUNT
0490       STA VCNT
0500       LDA NMIST
0510       STA NMIF
0520       LDA #0
0530       STA NMIEN
0540       STA POKMSK
0550       STA IRQEN
0560       STA DMACTL
0570       STA GRACTL
0580       STA COLBK
0590       STA GRAFM
0600       STA GRAFP0
0610       STA GRAFP1
0620       STA GRAFP2
0630       STA GRAFP3
0640       STX REGX
0650       STY REGY
0660       TSX 
0670       STX REGS
0680       LDX #$FF
0690       TXS 
0700 ;
0710 ;SAVE PIA REGISTERS
0720 ;
0730       LDA PACTL-OFFSET
0740       STA SCTLA
0750       LDA PBCTL-OFFSET
0760       STA SCTLB
0770       LDA #$38            ; ACCESS DIRC
0780       STA PACTL
0790       STA PBCTL
0800       LDA PORTA
0810       STA SDIRA
0820       LDA PORTB
0830       STA SDIRB
0840       LDA #$FF
0850       STA PORTA
0860       STA PORTB
0870       LDA #$3C            ; ACCESS PORTS
0880       STA PACTL
0890       STA PBCTL
0900       LDA PORTA
0910       STA SPORTA
0920       LDA PORTB
0930       STA SPORTB
0940 ;
0950 ;SAVE ANTIC, POKEY, GTIA REGS
0960 ;
0970       LDX #15
0980 SAPGR LDA GTIA-OFFSET,X
0990       STA SGTIA,X
1000       LDA GTIA-OFFSET+16,X
1010       STA SGTIA+16,X
1020       LDA POKEY-OFFSET,X
1030       STA SPOKEY,X
1040       LDA ANTIC-OFFSET,X
1050       STA SANTIC,X
1060       DEX 
1070       BPL SAPGR
1080 ;
1090 ;RESET ANTIC, POKEY AND GTIA
1100 ;
1110 RES   LDX #15
1120       LDA #0
1130 RES1  STA GTIA,X
1140       STA GTIA+16,X
1150       STA ANTIC,X
1160       STA POKEY,X
1170       DEX 
1180       BPL RES1
1190 ;
1200 ;RESET PIA
1210 ;
1220       LDY #$38
1230       STY PACTL
1240       STY PBCTL
1250       STA PORTA
1260       STX PORTB
1270       LDY #$3C
1280       STY PACTL
1290       STY PBCTL
1300       STX PORTB
1310 ;
1320 ;SET COLORS
1330 ;
1340       LDX #4
1350 RES2  LDA COLTAB,X
1360       STA COLPF0,X
1370       DEX 
1380       BPL RES2
1390 ;
1400 ;DISPLAY LIST
1410 ;
1420 RES3  LDA #SCREEN&$FF
1430       STA DLISTL
1440       LDA #SCREEN/256
1450       STA DLISTH
1460 ;
1470 ;CHARACTER BASE
1480 ;
1490       LDA #$E0
1500       STA CHBASE
1510 ;
1520       LDA #2
1530       STA CHACTL
1540 ;
1550 ;COPY PLAYFIELD FROM ROM TO RAM
1560 ;
1570       LDX #0
1580 COPYPF LDA DLIST,X
1590       STA SCREEN,X
1600       INX 
1610       CPX #DLEND-DLIST
1620       BNE COPYPF
1630 ;
1640 ;DMA ON
1650 ;
1660       JSR DMAON
1670 ;
1680 ;TO COMMAND PROCESSOR
1690 ;
1700       JMP KEY
1710 ;
1720 COLTAB .BYTE $D8,$0A,$C2,$88,$C2
1730 ;
1740 DLIST .BYTE $70,$70,$70,$70,$70
1750       .BYTE $70,$70,$70,$70
1760       .BYTE $70,$70
1770       .BYTE $49
1780       .WORD BARLIN-DLIST+SCREEN
1790       .BYTE 6,2,$49
1800       .WORD BARLIN-DLIST+SCREEN
1810       .BYTE $42
1820       .WORD MENU-DLIST+SCREEN
1830       .BYTE 2,2,$49
1840       .WORD BARLIN-DLIST+SCREEN
1850       .BYTE $41
1860       .WORD SCREEN
1870 ;
1880 BARLIN .BYTE $FF,$FF,$FF,$FF,$FF
1890       .BYTE $FF,$FF,$FF
1900       .SBYTE "TURBO-FREEZER XL"
1910       .SBYTE "COPYRIGHT 1987  BY BERNHARD ENGL"
1920 ;
1930 MENU  .SBYTE "[S] SAVE EXTERN [R] SAVE RAMDISK"
1940       .SBYTE "[E] EXEC EXTERN [X] EXEC RAMDISK"
1950       .SBYTE "[Z] ZERO OS RAM [D] DOS/DEBUGGER"
1960 DLEND
