; JED2EQN -- JEDEC file to Boolean Equations disassembler (Version V063)
; Copyright (c) National Semiconductor Corporation 1990-1993
; Disassembled from galf1.jed. Date: 2-17-104
;$GALMODE REGISTERED

chip galf1 GAL16V8

F_CLK=1 A14=2 A15=3 A11=4 A13=5 Reset=6 A12=7 RW=8 PHI2=9 GND=10 /OE=11 RomOE=12 
F_o13=13 F_o14=14 RamCE=15 F_o16=16 F_rf17=17 F_rf18=18 Activate2=19 VCC=20 

; clk = /PHI2

@ues 0000000000000000
@ptd unused

equations

; Reset = RST * G_o15

/Activate2 = ActivateFreezer * A10 * A9 * A8 * A7 * A6 * A5 * A4 * A3
Activate2.oe = vcc

/Activate2 = gnd
Activate2.oe = gnd

F_rf18 := /F_rf18 * F_rf17 * /Reset * /RW
    + F_rf18 * F_rf17 * Reset
    + ActivateFreezer * A15 * A14 * A13 * A12 * A11 * A10 * A9 * A8 * A7 * A6 * A5 * A4 * A3 * /F_rf18 * /F_rf17 * RW
F_rf18.oe = OE

F_rf17 := F_rf17 * /RW
    + F_rf17 * Reset
    + ActivateFreezer * A15 * A14 * A13 * A12 * A11 * A10 * A9 * A8 * A7 * A6 * A5 * A4 * A3 * F_rf18 * /F_rf17 * RW
F_rf17.oe = OE

F_o16 = A15 * A14 * /A12
    + A15 * A14 * /A11
    + A15 * A14 * A13
F_o16.oe = vcc

F_o14 = /A15 * A14
    + /A15 * A11 * /F_rf18 * F_rf17
    + /A15 * A12 * /F_rf18 * F_rf17
    + /A15 * A13 * /F_rf18 * F_rf17
    + A14 * A13
F_o14.oe = vcc

F_o13 = /A15 * A14
    + A14 * /A13 * A12 * /A11
    + /A15 * /A13 * /A12 * /A11 * /F_rf18 * F_rf17
    + ActivateFreezer * A14 * A13 * A12 * A11 * A10 * A9 * A8 * A7 * A6 * A5 * A4 * A3 * F_rf18 * /F_rf17 * RW
F_o13.oe = vcc

/RamCE = /A15 * /A14 * /A13 * /A12 * /A11 * /F_rf18 * F_rf17 * PHI2
    + A15 * A14 * /A13 * A12 * /A11 * /F_rf18 * /F_rf17 * /RW * PHI2
RamCE.oe = vcc

/RomOE = /A15 * /A14 * A11 * /F_rf18 * F_rf17 * RW
    + /A15 * /A14 * A12 * /F_rf18 * F_rf17 * RW
    + /A15 * /A14 * A13 * /F_rf18 * F_rf17 * RW
    + ActivateFreezer * A15 * A13 * A12 * A11 * A10 * A9 * A8 * A7 * A6 * A5 * A4 * A3 * F_rf18 * /F_rf17 * RW
RomOE.oe = vcc

/OldRomOE = /F_o13 * F_o14 * F_o16 * /OSselect

; JED2EQN -- JEDEC file to Boolean Equations disassembler (Version V063)
; Copyright (c) National Semiconductor Corporation 1990-1993
; Disassembled from galg1.jed. Date: 2-17-104

chip galg1 PAL16L8

A10=1 A9=2 A8=3 A1=4 A3=5 A5=6 A7=7 A6=8 A4=9 GND=10 M_o17=11 Activate2=12 
LatchPortB=13 ActivateFreezer=14 G_o15=15 RamA4=16 RamA5=17 RamA6=18 RamA7=19 VCC=20 

equations

/RamA7 = /A7
    + /M_o17
RamA7.oe = vcc

/RamA6 = /A6
    + /M_o17
RamA6.oe = vcc

/RamA5 = /A5
    + /M_o17
RamA5.oe = vcc

/RamA4 = A10 * /M_o17
    + /A4
    + A8 * /M_o17
    + A9 * /M_o17
RamA4.oe = vcc

/G_o15 = A10 * A9 * A8 * /M_o17
G_o15.oe = vcc

/LatchPortB = A1
    + A10
    + /A8
    + /A9
    + M_o17
LatchPortB.oe = vcc

; JED2EQN -- JEDEC file to Boolean Equations disassembler (Version V063)
; Copyright (c) National Semiconductor Corporation 1990-1993
; Disassembled from galm1.jed. Date: 2-17-104

chip galm1 PAL16L8

F_o13=1 M_i2=2 F_o14=3 PBD6=4 PBD5=5 RAS=6 F_o16=7 PBD4=8 M_i9=9 GND=10 OSselect=11 Dram3=12 
Dram2=13 ExtSel=14 Refresh=15 Dram1=16 M_o17=17 Dram0=18 OldRomOE=19 VCC=20 

equations

/M_o17 = F_o13 * /F_o14 * /RAS * F_o16

/Refresh = F_o13 * F_o14 * F_o16
    + /F_o13 * F_o16 * /OSselect

/ExtSel = /F_o13 * F_o14 * /F_o16
    + F_o13 * /F_o14 * /F_o16
    + F_o13 * F_o14 * F_o16
    + /F_o13 * F_o16 * /OSselect
    + F_o14 * /PBD6 * /F_o16 * OSselect
    + /M_i2 * F_o14 * /PBD5 * /F_o16 * OSselect
    + M_i2 * F_o14 * /F_o16 * /PBD4 * OSselect

/Dram0 = /M_i2 * F_o13 * F_o14 * PBD6 * /PBD5 * /RAS * /F_o16 * /M_i9 * OSselect
    + M_i2 * F_o13 * F_o14 * PBD6 * /RAS * /F_o16 * /PBD4 * /M_i9 * OSselect
    + F_o13 * F_o14 * /PBD5 * /RAS * /F_o16 * /PBD4 * /M_i9 * OSselect

/Dram1 = F_o13 * F_o14 * /PBD6 * /PBD5 * /RAS * /F_o16 * PBD4 * /M_i9 * OSselect

/Dram2 = F_o13 * F_o14 * /PBD6 * PBD5 * /RAS * /F_o16 * /PBD4 * /M_i9 * OSselect
Dram2.oe = vcc

/Dram3 = F_o13 * F_o14 * /PBD6 * PBD5 * /RAS * /F_o16 * PBD4 * /M_i9 * OSselect
Dram3.oe = vcc
