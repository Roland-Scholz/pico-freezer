0100 ;
0110 ;-------------------------------
0120 ;RESTART: RESTORE CONDITIONS BE-
0130 ;         FORE BREAK AND RESTART
0140 ;-------------------------------
0150 ;
0160 RSTART LDX #0             ; SAVE CPAGE
0170       STX DMACTL          ; DMA OFF
0180 RSTAR1 LDA CPAGE,X
0190       STA SPAGE,X
0200       DEX 
0210       BNE RSTAR1
0220 ;
0230       LDX #11             ; MOVE ROUTINE
0240 RSTAR2 LDA READST,X
0250       STA CPAGE,X
0260       DEX 
0270       BPL RSTAR2
0280       LDX #0              ; READ STACK
0290 RSTAR3 JMP CPAGE          ; GET BYTE
0300 READST STA BRKCTL
0310       LDA $0100,X
0320       STA BRKCTL
0330       JMP RSTAR4
0340 RSTAR4 STA $0100,X
0350       DEX 
0360       BNE RSTAR3
0370 ;
0380       LDX REGS            ; RESTORE SP
0390       TXS 
0400       LDA REGA            ; PUSH SAVED ACCU
0410       PHA 
0420       LDA SANTIC+14       ; PUSH NMIEN
0430       PHA 
0440       LDA VCNT
0450       SEC 
0460       SBC #1
0470       PHA 
0480       LDX #20             ; PUSH LAST RESTART PHASE
0490 RSTAR5 LDA LPHASE,X
0500       PHA 
0510       DEX 
0520       BPL RSTAR5
0530       TSX                 ; CALC START VECTOR
0540       INX 
0550       STX RSVECL
0560       LDA #1
0570       STA RSVECH
0580       LDX REGS            ; RESTORE SP
0590       DEX 
0600       DEX 
0610       DEX 
0620       TXS 
0630 ;
0640       LDX #11             ; MOVE STORE ROUTINE
0650 RSTAR6 LDA WRITES,X
0660       STA CPAGE,X
0670       DEX 
0680       BPL RSTAR6
0690       LDX #0              ; MOVE STACK
0700 RSTAR7 LDA $0100,X
0710       JMP CPAGE
0720 WRITES STA BRKCTL
0730       STA $0100,X
0740       STA BRKCTL
0750       JMP RSTAR8
0760 RSTAR8 DEX 
0770       BNE RSTAR7
0780 ;
0790       LDX #0              ; RESTORE CPAGE
0800 RSTAR9 LDA SPAGE,X
0810       STA CPAGE,X
0820       DEX 
0830       BNE RSTAR9
0840 ;
0850 ;RESTORE ANTIC, POKEY, GTIA REGS
0860 ;
0870       SEI 
0880       LDX #15
0890 RSTA10 LDA SANTIC,X
0900       STA ANTIC-OFFSET,X
0910       CPX #14
0920       BEQ RSTA11          ; NO NMIS
0930       CPX #0              ; NO DMA
0940       BEQ RSTA11
0950       STA ANTIC,X
0960 RSTA11 LDA SGTIA,X
0970       STA GTIA-OFFSET,X
0980       STA GTIA,X
0990       LDA SGTIA+16,X
1000       STA GTIA-OFFSET+16,X
1010       STA GTIA+16,X
1020       LDA SPOKEY,X
1030       STA POKEY-OFFSET,X
1040       STA POKEY,X
1050       DEX 
1060       BPL RSTA10
1070 ;
1080 ;RESTORE PIA REGISTERS
1090 ;
1100       LDA #$38
1110       STA PACTL
1120       STA PBCTL
1130       LDA SDIRA
1140       STA PORTA
1150       LDA SDIRB
1160       STA PORTB
1170       LDA #$3C
1180       STA PACTL
1190       STA PBCTL
1200       LDA SPORTA
1210       STA PORTA
1220       LDA SPORTB
1230       STA PORTB
1240       LDA SCTLA
1250       STA PACTL
1260       STA PACTL-OFFSET
1270       LDA SCTLB
1280       STA PBCTL
1290       STA PBCTL-OFFSET
1300 ;
1310 ;RESTART, LAST PHASE
1320 ;
1330       SEI 
1340       LDX REGX
1350       LDY REGY
1360       LDA #3
1370 RSTA12 CMP VCOUNT
1380       BNE RSTA12
1390       STA WSYNC
1400       LDA SANTIC
1410       JMP (RSVECL)
1420 ;
1430 LPHASE BIT BRKCTL
1440       STA WSYNC
1450       STA DMACTL
1460       PLA 
1470 LPHAS1 CMP VCOUNT
1480       BNE LPHAS1
1490       PLA 
1500       STA NMIEN
1510       PLA 
1520       RTI 
