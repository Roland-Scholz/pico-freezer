0100 ;
0110 ;-------------------------------
0120 ;    DEBUGGER AND DIRECTORY
0130 ;-------------------------------
0140 ;
0150 FKEY
0160 DEBUG LDA #0
0170       STA DMACTL
0180       LDA #XDLIST&$FF
0190       LDX #XDLIST/256
0200       STA DLISTL
0210       STX DLISTH
0220       LDA #$22
0230       STA DMACTL
0240       LDA #0
0250       STA COLPF0+4
0260       TAX 
0270 DEBU2 STA MONSCR,X
0280       STA MONSCR+256,X
0290       STA MONSCR+512,X
0300       INX 
0310       BNE DEBU2
0320       STA DCOUNT
0330 ;
0340 DEBU3 LDA #0              ; CLEAR CMD LINE
0350       LDX #39
0360 DEBU4 STA MONSCR+40*16,X
0370       DEX 
0380       BPL DEBU4
0390       STA NCOUNT
0400       LDA #0
0410       STA IRQEN
0420       LDA #'>             ; SHOW PROMPT
0430       BNE DEBU6
0440 ;
0450 DEBU5 LDX NCOUNT          ; SET CURSOR
0460       LDA MONSCR+40*16,X
0470       ORA #$80
0480       STA MONSCR+40*16,X
0490       JSR GETKEY
0500 DEBU6 PHA                 ; CLEAR CURSOR
0510       LDX NCOUNT
0520       LDA MONSCR+40*16,X
0530       AND #$7F
0540       STA MONSCR+40*16,X
0550       PLA 
0560       CMP #$9B
0570       BEQ DEB15           ; EOL
0580       CMP #$FF
0590       BEQ DEB12           ; INSERT
0600       CMP #$FE
0610       BEQ DEB11           ; DELETE
0620       CMP #$7E
0630       BEQ DEBU7           ; BACKSPACE
0640       CMP #$1F
0650       BEQ DEB10           ; CURSOR ->
0660       CMP #$1E
0670       BEQ DEBU8           ; CURSOR <-
0680       SEC 
0690       SBC #$20
0700       STA MONSCR+40*16,X
0710       JMP DEB10
0720 ;
0730 DEBU7 LDA #0
0740       STA MONSCR+40*16,X
0750 DEBU8 DEX 
0760       BEQ DEBU5
0770 DEBU9 STX NCOUNT
0780       JMP DEBU5
0790 DEB10 INX 
0800       CPX #40
0810       BCC DEBU9
0820       BCS DEBU5
0830 DEB11 LDA MONSCR+40*16+1,X
0840       STA MONSCR+40*16,X
0850       INX 
0860       CPX #39
0870       BCC DEB11
0880       LDA #0
0890       STA MONSCR+40*16+39
0900       BEQ DEBU5
0910 DEB12 LDX #38
0920 DEB13 LDA MONSCR+40*16,X
0930       STA MONSCR+40*16+1,X
0940       DEX 
0950       CPX NCOUNT
0960       BCS DEB13
0970       LDA #0
0980       STA MONSCR+40*16+1,X
0990       BEQ DEBU5
1000 ;
1010 DEB15 LDX #8              ; NO OF CMD-1
1020       LDA MONSCR+40*16+1
1030 DEB16 CMP COMTB,X
1040       BEQ DEB17
1050       DEX 
1060       BPL DEB16
1070       JSR SCROLL
1080       JMP DEBU3
1090 ;
1100 DEB17 TXA 
1110       ASL A
1120       TAX 
1130       LDA #2
1140       STA NCOUNT
1150       SEI 
1160       LDA #$80
1170       STA IRQEN
1180       LDA COMAD+1,X
1190       PHA 
1200       LDA COMAD,X
1210       PHA 
1220       LDA MONSCR+40*16+2
1230       LDX MONSCR+40*16+3
1240       RTS 
1250 ;
1260 COMTB .SBYTE "DQRLGFSCU"
1270 COMAD .WORD DISP-1
1280       .WORD RES3-1
1290       .WORD CPU-1
1300       .WORD COML-1
1310       .WORD COMG-1
1320       .WORD COMF-1
1330       .WORD COMS-1
1340       .WORD COMC-1
1350       .WORD COMU-1
1360 ;
1370 ;PRINT ADDRESS IN A,X
1380 ;
1390 PRTADR PHA 
1400       TXA 
1410       JSR PRTBYT
1420       PLA 
1430 ;
1440 ;PRINT BYTE A
1450 ;
1460 PRTBYT PHA 
1470       LSR A
1480       LSR A
1490       LSR A
1500       LSR A
1510       JSR PRTBY1
1520       PLA 
1530       AND #$0F
1540 PRTBY1 CLC 
1550       ADC #$30
1560       CMP #$3A
1570       BCC PUTBYT
1580       ADC #6
1590 ;
1600 ;PUT A TO MONSCR
1610 ;
1620 PUTBYT STA MAPMSK
1630       TYA 
1640       PHA 
1650       TXA 
1660       PHA 
1670       LDA MAPMSK
1680       ROL A
1690       ROL A
1700       ROL A
1710       ROL A
1720       AND #3
1730       TAX 
1740       LDA MAPMSK
1750       AND #$9F
1760       ORA SCRCOD,X
1770       LDX DCOUNT
1780       STA MONSCR+40*15,X
1790       INC DCOUNT
1800       CPX #39
1810       BNE PUTBY1
1820       JSR SCROLL
1830 PUTBY1 PLA 
1840       TAX 
1850       PLA 
1860       TAY 
1870       RTS 
1880 ;
1890 SCRCOD .BYTE $40,$00,$20,$60
1900 ;
1910 SCROLL LDA IRQST
1920       BMI SCROL5
1930 SCROL8 JMP DEBU3          ; BREAK ABORT
1940 SCROL5 LDA KBCODE         ; S=STOP?
1950       CMP #$3E
1960       BNE SCROL7          ; NO
1970 SCROL6 LDA IRQST
1980       BPL SCROL8
1990       LDA KBCODE          ; Q=CONT?
2000       CMP #$2F
2010       BNE SCROL6
2020 SCROL7 LDA #MONSCR&$FF
2030       LDX #MONSCR/256
2040       STA BPNT
2050       STX BPNT+1
2060       LDX #15
2070       STX DCOUNT
2080 SCROL1 LDX #40
2090 SCROL2 LDY #40
2100       LDA (BPNT),Y
2110       LDY #0
2120       STA (BPNT),Y
2130       INC BPNT
2140       BNE SCROL3
2150       INC BPNT+1
2160 SCROL3 DEX 
2170       BNE SCROL2
2180       DEC DCOUNT
2190       BNE SCROL1
2200       LDA #0
2210       LDX #39
2220 SCROL4 STA MONSCR+40*15,X
2230       DEX 
2240       BPL SCROL4
2250       RTS 
2260 ;
2270 ;-------------------------------
2280 ;
2290 ;MATCH CHAR A OR ADDRESS IF A=0
2300 ;CY=MATCH FLAG
2310 ;
2320 MATCH LDX NCOUNT
2330       CPX #40
2340       BCS MATC6
2350       TAY 
2360       BEQ MATC2           ; MATCH ADDRESS
2370       SEC                 ; MATCH CHAR
2380       SBC #$20
2390       CMP MONSCR+40*16,X
2400       BNE MATC6           ; NO MATCH
2410       INX 
2420       BPL MATC6           ; ALWAYS
2430 MATC2 STA TPNT
2440       STA TPNT+1
2450 MATC3 LDA MONSCR+40*16,X
2460       SEC 
2470       SBC #$10
2480       BCC MATC6
2490       CMP #10
2500       BCC MATC4           ; 0...9
2510       SBC #7
2520       CMP #10
2530       BCC MATC6
2540       CMP #16
2550       BCS MATC6           ; NOT A...F
2560 MATC4 ASL A
2570       ASL A
2580       ASL A
2590       ASL A
2600       LDY #4
2610 MATC5 ASL A
2620       ROL TPNT
2630       ROL TPNT+1
2640       DEY 
2650       BNE MATC5
2660       INX 
2670       CPX #40
2680       BCC MATC3
2690 MATC6 CPX NCOUNT
2700       STX NCOUNT
2710       BNE MATC7
2720       CLC 
2730       RTS 
2740 MATC7 LDA TPNT
2750       LDX TPNT+1
2760       SEC 
2770       RTS 
2780 ;
2790 ;ADVANCE RPNT BY A AND CMP TPNT
2800 ;
2810 ADVADR CLC 
2820       ADC RPNT
2830       STA RPNT
2840       LDA RPNT+1
2850       ADC #0
2860       STA RPNT+1
2870       BCS ADVAD2          ; STOP IF CY
2880       LDA RPNT
2890       CMP TPNT
2900       LDA RPNT+1
2910       SBC TPNT+1
2920       BNE ADVAD1
2930       LDA RPNT
2940       EOR TPNT
2950 ADVAD1 RTS 
2960 ADVAD2 CLC 
2970       LDA #1
2980       RTS 
2990 ;
3000 ;DISPLAY BYTES COMMAND PROCESSOR
3010 ;
3020 DISP  LDA MONSCR+40*16+2  ; MIGHT BE
3030       LDX MONSCR+40*16+3  ; DIR OR DEL
3040       CMP #'I-$20
3050       BNE DISP01
3060       CPX #'R-$20
3070       BEQ DISD
3080 DISP01 CMP #'E-$20
3090       BNE DISP02
3100       CPX #'L-$20
3110       BNE DISP02
3120       JMP DELF
3130 DISP02 LDA #0
3140       JSR MATCH
3150       BCC DISP1
3160       STA RPNT
3170       STX RPNT+1
3180 DISP1 LDA #',
3190       JSR MATCH
3200       BCC DISP2
3210       LDA #0
3220       JSR MATCH
3230       BCS DISP3
3240 DISP2 LDA RPNT
3250       LDX RPNT+1
3260       CLC 
3270       ADC #7
3280       BCC DISP3
3290       INX 
3300 DISP3 STA TPNT
3310       STX TPNT+1
3320 DISP4 JSR SCROLL
3330       LDA #$20
3340       JSR PUTBYT
3350       LDA RPNT            ; PRINT ADDRESS
3360       LDX RPNT+1
3370       JSR PRTADR
3380       LDA #$20
3390       JSR PUTBYT
3400       LDY #0
3410 DISP5 TYA                 ; PRINT DATA BYTES
3420       PHA 
3430       LDA #$20
3440       JSR PUTBYT
3450       JSR GETBYT
3460       JSR PRTBYT
3470       PLA 
3480       TAY 
3490       INY 
3500       CPY #8
3510       BCC DISP5
3520       LDA #$20
3530       JSR PUTBYT
3540       LDY #0
3550 DISP6 TYA 
3560       PHA 
3570       JSR GETBYT
3580       JSR PUTBYT
3590       PLA 
3600       TAY 
3610       INY 
3620       CPY #8
3630       BCC DISP6
3640       LDA #8
3650       JSR ADVADR
3660       BCC DISP4
3670       BEQ DISP4
3680       JMP DEBU3
3690 ;
3700 ;DISPLAY DIRECTORY
3710 ;
3720 DISD  JSR SCROLL
3730       JSR SCROLL
3740       LDA #5
3750       STA NCOUNT
3760       JSR FDECOD
3770       JSR DDIR            ; IN DISK.M65
3780       JMP DEBU3
3790 ;
3800 ;GET BYTE FROM (RPNT),Y
3810 ;
3820 GETBYT TYA                ; CALC ADDRESS
3830       CLC 
3840       ADC RPNT
3850       TAY 
3860       LDA RPNT+1
3870       ADC #0
3880       TAX 
3890       CMP #$41
3900       BEQ GETBY7          ; CPAGE, SPECIAL CASE
3910       CMP #$D1            ; DISK BUFFER?
3920       BEQ GETB11
3930       CMP #$D0
3940       BEQ GETB10          ; GTIA
3950       CMP #$D2
3960       BEQ GETBY9          ; POKEY
3970       CMP #$D4
3980       BEQ GETBY8          ; ANTIC
3990       CMP #$D3
4000       BEQ GETBY5          ; PIA
4010       AND #$F8
4020       CMP #$D0
4030       BEQ GETBY6          ; IO AREA
4040       TXA 
4050       PHA 
4060       LDX #$0B
4070 GETBY1 LDA CPAGE,X
4080       STA USEMAP,X
4090       LDA GETBY2,X
4100       STA CPAGE,X
4110       DEX 
4120       BPL GETBY1
4130       PLA 
4140       STA CPAGE+5
4150       STY CPAGE+4
4160       JSR NOJERK
4170       JMP CPAGE
4180 ;
4190 GETBY2 STA BRKCTL
4200       LDA $EEEE
4210       STA BRKCTL
4220       JMP GETBY3
4230 ;
4240 GETBY3 PHA 
4250       LDA #$FF
4260       STA PORTB
4270       LDX #$0B
4280 GETBY4 LDA USEMAP,X
4290       STA CPAGE,X
4300       DEX 
4310       BPL GETBY4
4320       PLA 
4330       RTS 
4340 ;
4350 GETBY5 TYA 
4360       AND #$07
4370       CMP #6
4380       BCS GETBY6
4390       TAX 
4400       LDA SPORTA,X
4410       RTS 
4420 ;
4430 GETBY6 LDA #0
4440       RTS 
4450 ;
4460 GETBY7 LDA CPAGE,Y
4470       RTS 
4480 ;
4490 GETBY8 TYA 
4500       AND #$0F
4510       TAX 
4520       LDA SANTIC,X
4530       RTS 
4540 ;
4550 GETBY9 TYA 
4560       AND #$0F
4570       TAX 
4580       LDA SPOKEY,X
4590       RTS 
4600 ;
4610 GETB10 TYA 
4620       AND #$1F
4630       TAX 
4640       LDA SGTIA,X
4650       RTS 
4660 ;
4670 GETB11 LDA DBUF,Y
4680       RTS 
4690 ;
4700 NOJERK LDA VCOUNT
4710       CMP #93
4720       BCC NOJERK
4730       LDA #$FE
4740       STA PORTB
4750       RTS 
4760 ;
