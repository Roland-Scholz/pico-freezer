4780 ;
4790 ;PRINT TEXT Y
4800 ;
4810 PRTSTR LDX #0
4820 PRTST1 LDA PRTTAB,X
4830       BMI PRTST2
4840       INX 
4850       BNE PRTST1
4860 PRTST2 INX 
4870       DEY 
4880       BPL PRTST1
4890       LDA #$20
4900       JSR PUTBYT
4910 PRTST3 LDA PRTTAB,X
4920       PHP 
4930       AND #$7F
4940       JSR PUTBYT
4950       INX 
4960       PLP 
4970       BPL PRTST3
4980       RTS 
4990 ;
5000 PRTTAB .CBYTE " "
5010       .CBYTE "SINGLE"
5020       .CBYTE "ENHANCED"
5030       .CBYTE "DOUBLE"
5040       .CBYTE "DENSITY, "
5050       .CBYTE "SECTORS FREE"
5060       .CBYTE "DELETE: "
5070       .CBYTE "A  X  Y  S  NV-BDIZC  PC"
5080       .CBYTE "RENAME: "
5090       .CBYTE "LOCK: "
5100       .CBYTE "UNLOCK: "
5110 ;
5120 ;PRINT TPNT IN DECIMAL
5130 ;
5140 PRTTPN LDX #7
5150 PRTTP1 LDY #0
5160 PRTTP2 LDA TPNT
5170       CMP DECTAB-1,X
5180       LDA TPNT+1
5190       SBC DECTAB,X
5200       BCC PRTTP3
5210       STA TPNT+1
5220       LDA TPNT
5230       SBC DECTAB-1,X
5240       STA TPNT
5250       INY 
5260       BPL PRTTP2
5270 PRTTP3 TYA 
5280       ADC #$30
5290       JSR PUTBYT
5300       DEX 
5310       DEX 
5320       BPL PRTTP1
5330       RTS 
5340 ;
5350 DECTAB .WORD 1
5360       .WORD 10
5370       .WORD 100
5380       .WORD 1000
5390 ;
5400 ;-------------------------------
5410 ;
5420 ;DELETE FILE HANDLER
5430 ;
5440 DELF  LDA #5
5450       STA NCOUNT
5460       JSR FDECOD
5470       JSR GETOPT
5480       JSR FDELET
5490       JMP DEBU3
5500 ;
5510 ;DECODE FILENAME FROM (NCOUNT)
5520 ;TO /NAME/. CY=0 IF DEFAULT.
5530 ;
5540 FDECOD LDY #0
5550       LDX NCOUNT
5560       LDA #8
5570       STA FILENO
5580 FDECO1 LDA MONSCR+40*16,X
5590       INX 
5600       CLC 
5610       ADC #$20
5620 FDECO2 CMP #$20
5630       BEQ FDECO3
5640       CMP #'/
5650       BEQ FDECO3
5660       CMP #',
5670       BNE FDECO7          ; NO TERMINAL
5680 FDECO3 CPY #11
5690       BCS FDECO4
5700       LDA #$20
5710       STA NAME,Y
5720       INY 
5730       BNE FDECO3
5740 FDECO4 DEX 
5750       STX NCOUNT
5760       LDA NAME
5770       CMP #$20
5780       BNE FDECO6
5790       LDY #10
5800 FDECO5 LDA #'?
5810       STA NAME,Y
5820       DEY 
5830       BPL FDECO5
5840       CLC 
5850 FDECO6 RTS 
5860 FDECO7 CPY FILENO
5870       BNE FDECO9
5880       CMP #'.
5890       BNE FDECO1
5900 FDECO8 LDA #11
5910       STA FILENO
5920       BNE FDECO1
5930 FDECO9 CMP #'.
5940       BEQ FDEC10
5950       CMP #'*
5960       BEQ FDEC11
5970       STA NAME,Y
5980       INY 
5990       BNE FDECO1
6000 FDEC10 LDA #$20
6010       BNE FDEC12
6020 FDEC11 LDA #'?
6030 FDEC12 STA NAME,Y
6040       INY 
6050       CPY FILENO
6060       BNE FDEC12
6070       CMP #$20
6080       BEQ FDECO8
6090       BNE FDECO1
6100 ;
6110 ;PRINT FILE NAME
6120 ;
6130 PRTNAM LDX #0
6140 PRTNA1 LDA DENTRY+5,X
6150       JSR PUTBYT
6160       INX 
6170       CPX #8
6180       BNE PRTNA1
6190       LDA #'.
6200       JSR PUTBYT
6210 PRTNA2 LDA DENTRY+5,X
6220       JSR PUTBYT
6230       INX 
6240       CPX #11
6250       BNE PRTNA2
6260       LDA #$20
6270       JMP PUTBYT
6280 ;
6290 ;GET CMD LINE OPTIONS
6300 ;
6310 GETOPT LDX NCOUNT
6320       LDA MONSCR+40*16,X
6330       CMP #'/-$20
6340       BNE GETOP1          ; NO OPTION
6350       LDA MONSCR+40*16+1,X
6360       CLC 
6370       ADC #$20
6380 GETOP2 STA OPTION
6390       RTS 
6400 GETOP1 LDA #0
6410       BEQ GETOP2
6420 ;
6430 ;CHANGE START ADDRESS
6440 ;
6450 COMG  JSR PARBYT
6460       BCC COMG1
6470       LDA #1
6480       STA RPNT+1
6490       CLC 
6500       ADC REGS
6510       STA RPNT
6520       LDA TPNT
6530       LDY #1
6540       JSR STOBYT
6550       LDA TPNT+1
6560       LDY #2
6570       JSR STOBYT
6580       JMP CPU1
6590 COMG1 JMP DEBU3
6600 ;
6610 ;CHANGE BYTES
6620 ;
6630 COMC  LDA #0
6640       JSR MATCH
6650       BCC COMC1
6660       STA RPNT
6670       STX RPNT+1
6680 COMC1 LDA #'<
6690       JSR MATCH
6700       BCC COMG1
6710 COMC2 LDA #0
6720       JSR MATCH
6730       BCC COMC4
6740       LDY #0
6750       JSR STOBYT
6760 ;
6770       JSR SCROLL
6780       LDA #$20
6790       JSR PUTBYT
6800       LDA RPNT
6810       LDX RPNT+1
6820       JSR PRTADR
6830       LDA #'<
6840       JSR PUTBYT
6850       LDA TPNT
6860       JSR PRTBYT
6870 ;
6880       INC RPNT
6890       BNE COMC3
6900       INC RPNT+1
6910 COMC3 LDA #',
6920       JSR MATCH
6930       BCS COMC2
6940       BCC COMG1
6950 ;
6960 COMC4 LDA #',
6970       JSR MATCH
6980       BCC COMG1
6990       INC RPNT
7000       BNE COMC2
7010       INC RPNT+1
7020       JMP COMC2
7030 ;
7040 ;GET DISK BYTE
7050 ;
7060 GDIBYT LDX NCOUNT
7070       LDY MAPIDX
7080       TYA 
7090       CMP DBUF+2,X
7100       BCC GDIBY2
7110       LDA DAUX1
7120       ORA DAUX2
7130       BEQ GDIBY1
7140       JSR RDISK
7150       LDA #0
7160       STA MAPIDX
7170       BEQ GDIBYT
7180 GDIBY1 SEC 
7190       RTS 
7200 GDIBY2 LDA DBUF,Y
7210       INC MAPIDX
7220       RTS 
7230 ;
7240 OSRCLR LDY #0
7250       STY RPNT
7260       STY NMIEN
7270       STY DMACTL
7280       LDA #$FE            ; OS OFF
7290       STA PORTB
7300       LDA #$C0
7310 OSRCL1 STA RPNT+1
7320       LDA #0
7330 OSRCL2 STA (RPNT),Y
7340       INY 
7350       BNE OSRCL2
7360       INC RPNT+1
7370       BEQ OSRCL3
7380       LDA RPNT+1
7390       CMP #$D0
7400       BNE OSRCL1
7410       LDA #$D8
7420       BNE OSRCL1
7430 OSRCL3 LDA #$FF
7440       STA PORTB
7450       JMP DMAON
7460 ;
7470 XDLIST .BYTE $70,$70,$70
7480       .BYTE $42
7490       .WORD MONSCR
7500       .BYTE 0,2,0,2,0,2,0
7510       .BYTE 2,0,2,0,2,0,2,0
7520       .BYTE 2,0,2,0,2,0,2,0
7530       .BYTE 2,0,2,0,2,0,2
