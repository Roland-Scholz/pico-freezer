0870 ;RAM LOCATIONS
0880 ;
0890       *=  $30
0900 ;
0910 STATUS *= *+1             ; ZP LOCS FOR SIO
0920 CHKSUM *= *+1
0930 BUFRLO *= *+1
0940 BUFRHI *= *+1
0950 BFENLO *= *+1
0960 BFENHI *= *+1
0970 CRETRY *= *+1
0980 DRETRY *= *+1
0990 BUFRFL *= *+1
1000 RECVDN *= *+1
1010 XMTDON *= *+1
1020 CHKSNT *= *+1
1030 NOCKSM *= *+1
1040 ;
1050       *=  $80
1060 ;
1070 SGTIA *=  *+32            ; GTIA SHADOW
1080 SPOKEY *= *+16            ; POKEY SHADOW
1090 SANTIC *= *+16            ; ANTIC SHADOW
1100 SPORTA *= *+1             ; PORTA OUT
1110 SPORTB *= *+1             ; PORTB OUT
1120 SDIRA *=  *+1             ; PORTA DIRC
1130 SDIRB *=  *+1             ; PORTB DIRC
1140 SCTLA *=  *+1             ; PORTA CONTROL
1150 SCTLB *=  *+1             ; PORTB CONTROL
1160 REGA  *=  *+1             ; CPU ACCU
1170 REGX  *=  *+1             ; CPU X
1180 REGY  *=  *+1             ; CPU Y
1190 REGS  *=  *+1             ; CPU SP
1200 VCNT  *=  *+1             ; VCOUNT
1210 NMIF  *=  *+1             ; NMI STATUS
1220 IRQF  *=  *+1             ; IRQ STATUS
1230 RSVECL *= *+1             ; RESTART VECTOR
1240 RSVECH *= *+1
1250 ;
1260 RPNT  *=  *+2
1270 BPNT  *=  *+2
1280 TURFLG *= *+1             ; FLOPPY HAS 1050 TURBO
1290 BANK  *=  *+1             ; CURRENT BANK CNTRL BYTE
1300 NAME  *=  *+11            ; FILE NAME
1310 DHOLE *=  *+1             ; DIRECTORY HOLE
1320 DENTYP *= *+1             ; DENSITY TYPE
1330 DENTRY *= *+16            ; DIRECTORY ENTRY
1340 NEXT  *=  *+2             ; NEXT SECTOR
1350 SIZE  *=  *+1             ; BLOCK SIZE IN BYTES MOD 256
1360 DCOUNT *= *+1             ; DATA BYTE COUNT
1370 NCOUNT *= *+1             ; NORMAL DATA BYTE COUNT
1380 MAPIDX *= *+1             ; USEMAP INDEX
1390 MAPMSK *= *+1             ; USEMAP MASK
1400 FILENO *= *+1             ; FILE NUMBER & TYPE
1410 DEVICE *= *+1             ; DEVICE RAMD/DISK/CASS
1420 KEYTIM *= *+1             ; KEYBOARD AUTOREP TIMER
1430 TPNT  *=  *+2             ; TEMP ADDRESS
1440 OPTION *= *+1             ; COMMAND OPTION
1450 ;
1460       *=  $0100
1470 ;
1480 USEMAP *= *+66            ; MAP OF USED SECTORS
1490 ;
1500 ;-------------------------------
1510 ;
1520       *=  $0800
