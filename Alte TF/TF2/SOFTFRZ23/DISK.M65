0100 ;-------------------------------
0110 ;     DISK DEVICE HANDLER
0120 ;-------------------------------
0130 ;
0140 ;ENTRY --- SAVE DISK BOOT
0150 ;
0160 SAVDBO JSR DENSTY
0170       JSR IBOOT
0180       JSR SAVE
0190       JMP ENDCMD
0200 ;
0210 ;ENTRY --- EXEC DISK BOOT
0220 ;
0230 EXEDBO JSR DENSTY
0240       JSR IBOOT
0250       JSR LOAD
0260       JMP RSTART
0270 ;
0280 ;ENTRY --- SAVE DISK FILE
0290 ;
0300 SAVFIL JSR DENSTY
0310       JSR RVTOC
0320       JSR SEARCH
0330       BCS SAVFI0          ; FOUND, DELETE
0340       BIT FILENO          ; FOUND HOLE?
0350       BPL SAVFI1          ; YES
0360       LDY #7              ; DIRECTORY FULL
0370       JMP ERROR
0380 SAVFI0 LDX #10            ; GET REAL NAME
0390 SAVFI3 LDA DENTRY+5,X
0400       STA NAME,X
0410       DEX 
0420       BPL SAVFI3
0430       JSR DELETE          ; DELETE FILE
0440 SAVFI1 JSR IWFILE
0450       JSR SAVE
0460       JSR WVTOC
0470 SAVFI2 JMP ENDCMD
0480 ;
0490 ;ENTRY --- EXEC DISK FILE
0500 ;
0510 EXEFIL JSR DENSTY
0520       JSR IVTOC
0530       JSR SEARCH
0540       BCS *+7
0550       LDY #0              ; FILE NOT FOUND
0560       JMP ERROR
0570       JSR IRFILE
0580       JSR LOAD
0590       JMP RSTART
0600 ;
0610 ;READ DISK BLOCK
0620 ;
0630 RDISK JSR RSEC
0640       BIT FILENO          ; BOOT?
0650       BMI RDIS1           ; YES
0660       LDX NCOUNT
0670       LDA DBUF,X
0680       LSR A
0690       LSR A
0700       EOR FILENO
0710       AND #$3F
0720       BEQ *+7
0730       LDY #1              ; FILE STRUCTURE DAMAGED
0740       JMP ERROR
0750       LDA DBUF,X
0760       AND #3
0770       STA DAUX2
0780       INX 
0790       LDA DBUF,X
0800       STA DAUX1
0810       RTS 
0820 RDIS1 INC DAUX1
0830       BNE RDIS2
0840       INC DAUX2
0850 RDIS2 RTS 
0860 ;
0870 ;WRITE BLOCK TO DISK
0880 ;
0890 WDISK BIT FILENO          ; BOOT?
0900       BMI WDIS2           ; YES
0910       LDA NEXT            ; LAST SECTOR?
0920       ORA NEXT+1
0930       BEQ WDIS1           ; YES
0940       JSR ALLOCS          ; ALLOCATE SECTOR
0950 WDIS1 LDX NCOUNT          ; SET UP LINK BYTES
0960       LDA FILENO
0970       ASL A
0980       ASL A
0990       ORA NEXT+1
1000       STA DBUF,X
1010       INX 
1020       LDA NEXT
1030       STA DBUF,X
1040       INX 
1050       LDA NCOUNT
1060       STA DBUF,X
1070 WDIS2 JSR WSEC
1080       BIT FILENO          ; BOOT?
1090       BMI RDIS1           ; YES
1100       LDA NEXT
1110       STA DAUX1
1120       LDA NEXT+1
1130       STA DAUX2
1140       RTS 
1150 ;
1160 ;READ SECTOR
1170 ;
1180 RSEC  LDA #$52
1190       LDX #$40
1200       BNE WSE1
1210 ;
1220 ;WRITE SECTOR
1230 ;
1240 WSEC  LDA #$50
1250       LDX #$80
1260 WSE1  PHA 
1270       LDY #9
1280 WSE2  LDA SIOTAB,Y
1290       STA DDEVIC,Y
1300       DEY 
1310       BPL WSE2
1320       PLA 
1330       STA DCOMND
1340       STX DSTATS
1350       CMP #$23
1360       BCS WSE3
1370       LDA #40
1380       STA DTIMLO
1390 WSE3  LDA SIZE
1400       STA DBYTLO
1410       BNE WSE4
1420       INC DBYTHI
1430 WSE4  LDA #$80
1440       STA POKMSK
1450       STA IRQEN
1460       CLI 
1470       LDA #$40
1480       STA NMIEN
1490       JSR SIOV
1500       LDA #0
1510       STA POKMSK
1520       STA IRQEN
1530       SEI 
1540       STA NMIEN
1550       CPY #1
1560       BEQ WSE5
1570       LDA DCOMND          ; STATUS?
1580       CMP #$4E            ; PERCOM?
1590       BEQ WSE5
1600       CMP #$53
1610       BEQ WSE5
1620       LDY #3              ; DISK I/O ERROR
1630       JMP ERROR
1640 WSE5  RTS 
1650 SIOTAB .BYTE $31,1,0,0
1660       .WORD DBUF,7,$80
1670 ;
1680 ;DETERMINE DENSITY
1690 ;SET TURFLG IF 1050 TURBO FLOPPY
1700 ;
1710 DENSTY LDA #0
1720       STA TURFLG
1730       JSR FDSTAT
1740       DEY 
1750       BEQ DENST0
1760       LDY #4              ; DRIVE DOES NOT RESPOND
1770       JMP ERROR
1780 DENST0 LDX #1             ; ASSUME ED
1790       LDA DBUF
1800       BMI DENST1          ; TRUE
1810       INX                 ; ASSUME DD
1820       AND #$20
1830       BNE DENST1
1840       LDX #0              ; SD
1850 DENST1 STX DENTYP
1860       INC TURFLG          ; DEVICE TURBO?
1870       LDA #0
1880       STA SOUNDR
1890       JSR FDSTAT
1900       DEY 
1910       BEQ DENST2          ; YES
1920       DEC TURFLG
1930       JSR FDSTAT          ; NO
1940 DENST2 INC SOUNDR
1950       RTS 
1960 ;
1970 FDSTAT LDA #4
1980       STA SIZE
1990       LDA #$53
2000       LDX #$40
2010       JMP WSE1
2020 ;
2030 ;INIT LOAD/SAVE FOR BOOT DISKS
2040 ;
2050 IBOOT LDA #1
2060       STA NEXT
2070       STA DEVICE
2080       LDA #4
2090       STA DAUX1
2100       LDA #0
2110       STA NEXT+1
2120       STA DAUX2
2130       LDA #$C0
2140       STA FILENO
2150       LDX DENTYP
2160       LDA SIZTAB,X
2170       STA SIZE
2180       STA NCOUNT
2190       RTS 
2200 ;
2210 ;INIT FOR FILE LOAD
2220 ;
2230 IRFILE LDA #1
2240       STA NEXT
2250       STA DEVICE
2260       LDX DENTYP
2270       LDA SIZTAB,X
2280       STA SIZE
2290 ;
2300       LDA LNKTAB,X
2310       STA NCOUNT
2320       LDA #0
2330       STA NEXT+1
2340       LDA DENTRY+3
2350       STA DAUX1
2360       LDA DENTRY+4
2370       STA DAUX2
2380       RTS 
2390 ;
2400 ;INIT FOR FILE WRITE
2410 ;
2420 IWFILE LDA #0
2430       STA DENTRY+1
2440       STA DENTRY+2
2450       LDA #$42
2460       STA DENTRY
2470       LDX #10
2480 IWFIL1 LDA NAME,X
2490       STA DENTRY+5,X
2500       DEX 
2510       BPL IWFIL1
2520       JSR ALLOCS
2530       LDA NEXT
2540       STA DENTRY+3
2550       LDA NEXT+1
2560       STA DENTRY+4
2570       JMP IRFILE
2580 ;
2590 SIZTAB .BYTE 128,128,0
2600 LNKTAB .BYTE 125,125,253
2610 ;
2620 ;INIT FOR VTOC READ/WRITE
2630 ;
2640 IVTOC LDX DENTYP
2650       LDA SIZTAB,X
2660       STA SIZE
2670       LDA #$68
2680       STA DAUX1
2690       LDA #1
2700       STA DAUX2
2710       RTS 
2720 ;
2730 ;READ VTOC
2740 ;
2750 RVTOC JSR IVTOC
2760       JSR RSEC
2770       LDX #0
2780       STX VTOC+$8A
2790       STX VTOC+$8B
2800 RVTO1 LDA DBUF,X
2810       STA VTOC,X
2820       INX 
2830       BPL RVTO1
2840       LDA #0
2850 RVTO2 STA VTOC,X
2860       INX 
2870       BNE RVTO2
2880       LDX DENTYP          ; ED?
2890       DEX 
2900       BNE RVTO4           ; NO
2910       LDA VTOC            ; DOS 2.5 FORMAT?
2920       CMP #2
2930       BNE RVTO4           ; NO
2940       JSR SVTOC2          ; SET DAUX=VTOC2
2950       JSR RSEC
2960       LDX #0
2970 RVTO3 LDA DBUF,X
2980       STA VTOC+$10,X
2990       INX 
3000       BPL RVTO3
3010 RVTO4 RTS 
3020 ;
3030 SVTOC2 LDA #0
3040       STA DAUX1
3050       LDA #4
3060       STA DAUX2
3070       RTS 
3080 ;
3090 ;WRITE VTOC & UPDATE DIRECTORY
3100 ;
3110 WVTOC JSR IVTOC
3120       LDX DENTYP          ; ED?
3130       DEX 
3140       BNE WVTO3           ; NO
3150       LDA VTOC            ; DOS 2.5 FORMAT?
3160       CMP #2
3170       BNE WVTO3           ; NO
3180       LDX #0
3190 WVTO1 LDA VTOC+$10,X
3200       STA DBUF,X
3210       INX 
3220       BPL WVTO1
3230       JSR SVTOC2
3240       JSR WSEC
3250       JSR IVTOC
3260       LDA #0
3270       LDX #$64
3280 WVTO2 STA VTOC,X
3290       INX 
3300       BPL WVTO2
3310 WVTO3 LDX #0
3320 WVTO4 LDA VTOC,X
3330       STA DBUF,X
3340       INX 
3350       BNE WVTO4
3360       JSR WSEC
3370       BIT FILENO
3380       BVS WVTO6
3390       JSR DIRACC
3400       TXA                 ; SAVE INDEX
3410       PHA 
3420       JSR RSEC            ; DIRECTORY SECTOR LESEN
3430       PLA 
3440       TAX                 ; COPY DENTRY TO DIRECTORY
3450       LDY #0
3460 WVTO5 LDA DENTRY,Y
3470       STA DBUF,X
3480       INX 
3490       INY 
3500       CPY #16
3510       BNE WVTO5
3520       JSR WSEC            ; DIRECTORY SECTOR SCHREIBEN
3530 WVTO6 RTS 
3540 ;
3550 ;ALLOCATE SECTOR
3560 ;
3570 ALLOCS LDX #10            ; SEARCH VTOC FOR FREE SECTOR
3580 ALLOC1 LDA VTOC,X
3590       BNE ALLOC2          ; FOUND
3600       INX 
3610       BNE ALLOC1
3620       LDY #5              ; DISK FULL
3630       JMP ERROR
3640 ALLOC2 LDY #0             ; CALC SECTOR NO
3650 ALLOC3 ASL A
3660       BCS ALLOC4
3670       INY 
3680       BNE ALLOC3
3690 ALLOC4 LDA VTOC,X         ; CLEAR BIT
3700       EOR BITMSK,Y
3710       STA VTOC,X
3720       STY NEXT
3730       LDA #0
3740       STA NEXT+1
3750       TXA 
3760       SEC 
3770       SBC #10
3780       ASL A
3790       ROL NEXT+1
3800       ASL A
3810       ROL NEXT+1
3820       ASL A
3830       ROL NEXT+1
3840       ORA NEXT
3850       STA NEXT
3860       INC DENTRY+1
3870       BNE ALLOC5
3880       INC DENTRY+2
3890 ALLOC5 CPX #$64           ; DEC FREE SECTOR COUNT
3900       BCC ALLOC7          ; VTOC1
3910       LDA #3              ; SET VTOC2 USED FLAG
3920       STA DENTRY
3930       LDA VTOC+$8A
3940       BNE ALLOC6
3950       DEC VTOC+$8B
3960 ALLOC6 DEC VTOC+$8A
3970       RTS 
3980 ALLOC7 LDA VTOC+3
3990       BNE ALLOC8
4000       DEC VTOC+4
4010 ALLOC8 DEC VTOC+3
4020       RTS 
4030 ;
4040 BITMSK .BYTE $80,$40,$20,$10,8,4,2,1
4050 ;
4060 ;ACCESS DIRECTORY SECTOR:
4070 ;SET DAUX1,2 FROM FILENO
4080 ;X=ENTRY INDEX
4090 ;
4100 DIRACC LDA FILENO
4110       AND #$3F
4120       LSR A
4130       LSR A
4140       LSR A
4150       SEC 
4160       ADC #$68
4170       STA DAUX1
4180       LDA #1
4190       STA DAUX2
4200       LDA FILENO
4210       AND #7
4220       ASL A
4230       ASL A
4240       ASL A
4250       ASL A
4260       TAX 
4270       RTS 
4280 ;
4290 ;DELETE FILE
4300 ;
4310 DELETE LDA DENTRY
4320       AND #$20            ; LOCKED?
4330       BEQ DELET1
4340       LDY #6              ; FILE LOCKED
4350       JMP ERROR
4360 DELET1 JSR IRFILE
4370 DELET2 LDA DAUX1
4380       TAX 
4390       AND #7
4400       TAY 
4410       LDA DAUX2
4420       STA NEXT
4430       TXA 
4440       LSR NEXT
4450       ROR A
4460       LSR NEXT
4470       ROR A
4480       LSR NEXT
4490       ROR A
4500       CLC 
4510       ADC #10
4520       TAX 
4530       LDA VTOC,X          ; SET VTOC BIT
4540       ORA BITMSK,Y
4550       STA VTOC,X
4560 DELET3 CPX #$64
4570       BCC DELET4
4580       INC VTOC+$8A
4590       BNE DELET5
4600       INC VTOC+$8B
4610       BNE DELET5          ; ALWAYS
4620 DELET4 INC VTOC+3
4630       BNE DELET5
4640       INC VTOC+4
4650 DELET5 JSR RSEC           ; READ SECTOR
4660       LDX NCOUNT
4670       LDA DBUF,X
4680       LSR A
4690       LSR A
4700       EOR FILENO
4710       AND #$3F
4720       BEQ DELET6
4730       LDY #1              ; FILE STRUCTURE DAMAGED
4740       JMP ERROR
4750 DELET6 LDA DBUF,X
4760       AND #3
4770       STA DAUX2
4780       INX 
4790       LDA DBUF,X
4800       STA DAUX1
4810       ORA DAUX2
4820       BNE DELET2
4830       RTS 
4840 ;
4850 ;SEARCH FILE NAME IN DIRECTORY
4860 ;IF FOUND, COPY TO DENTRY, CY=1
4870 ;IF NOT FOUND, FILENO=HOLE, CY=0
4880 ;
4890 SEARCH LDX #$FF           ; INIT HOLE
4900       STX MAPMSK
4910       INX 
4920       STX FILENO
4930 SEARC1 JSR DIRACC
4940       CPX #0
4950       BNE SEARC2          ; SAME SECTOR
4960       JSR RSEC            ; NEW SECTOR
4970       LDX #0
4980 SEARC2 LDY #0             ; COPY ENTRY TO DENTRY
4990 SEARC3 LDA DBUF,X
5000       STA DENTRY,Y
5010       INX 
5020       INY 
5030       CPY #16
5040       BNE SEARC3
5050       LDA DENTRY          ; LOOK AT FLAG
5060       BMI SEARC8          ; DELETED, HOLE, SKIP
5070       BEQ SEARC8          ; LAST, HOLE, EXIT
5080       AND #$41
5090       BEQ SEARC8          ; FREE, HOLE, SKIP
5100       CMP #$41
5110       BEQ SEARC9          ; TRASH, AVOID, SKIP
5120       LDX #10             ; FOUND LIVE ENTRY
5130 SEARC4 LDA NAME,X         ; COMPARE NAMES
5140       CMP #'?
5150       BEQ SEARC5
5160       CMP DENTRY+5,X
5170       BNE SEARC9          ; NO MATCH
5180 SEARC5 DEX 
5190       BPL SEARC4
5200       SEC 
5210       RTS 
5220 SEARC8 BIT MAPMSK         ; FIRST HOLE?
5230       BPL SEARC9          ; NO
5240       LDA FILENO
5250       STA MAPMSK
5260 SEARC9 INC FILENO         ; GO TO NEXT ENTRY
5270       BIT FILENO
5280       BVS SEAR10
5290       LDA DENTRY
5300       BNE SEARC1
5310 SEAR10 LDA MAPMSK         ; GET HOLE
5320       STA FILENO
5330       CLC 
5340       RTS 
5350 ;
5360 ;PRINT DIRECTORY
5370 ;
5380 DDIR  JSR DENSTY
5390       JSR IVTOC
5400       LDX #$FF
5410       STX MAPMSK
5420       INX 
5430       STX FILENO
5440 ;
5450 DDI1  JSR SEARC1
5460       BCC DDI2            ; NOT FOUND, END
5470       JSR DDI6            ; PRINT DENTRY
5480       INC FILENO
5490       BIT FILENO
5500       BVC DDI1
5510 ;
5520 DDI2  JSR RVTOC
5530       LDA VTOC+3
5540       CLC 
5550       ADC VTOC+$8A
5560       STA TPNT
5570       LDA VTOC+4
5580       ADC VTOC+$8B
5590       STA TPNT+1
5600 ;
5610 DDI5  LDA DCOUNT
5620       BEQ DDI11
5630       JSR SCROLL
5640 DDI11 LDY DENTYP
5650       JSR PRTSTR
5660       LDY #3
5670       JSR PRTSTR
5680       JSR PRTTPN
5690       LDY #4
5700       JMP PRTSTR
5710 ;
5720 DDI6  LDA DCOUNT
5730       CMP #21
5740       BCC DDI10
5750       JSR SCROLL
5760 DDI10 LDA #$20
5770       TAX 
5780       JSR PUTBYT
5790       LDA DENTRY
5800       AND #$20
5810       BEQ DDI7
5820       LDX #'*             ; LOCKED
5830 DDI7  TXA 
5840       JSR PUTBYT
5850       JSR PRTNAM
5860       LDA DENTRY+1
5870       LDX DENTRY+2
5880       STA TPNT
5890       STX TPNT+1
5900       JMP PRTTPN
5910       LDA #$20
5920       JMP PUTBYT
