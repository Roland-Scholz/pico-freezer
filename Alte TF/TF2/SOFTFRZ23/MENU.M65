0100 ;
0110 ;-------------------------------
0120 ;MAIN MENU: WAIT FOR KEY AND
0130 ;           CALL ACTION ROUTINES
0140 ;           FORCE COLD START IF
0150 ;           RESET DURING WAITING
0160 ;-------------------------------
0170 ;
0180 ;END OF COMMAND, UNMARK CHOICE
0190 ;
0200 ENDCMD LDX SELTAB+6
0210       LDA #0
0220 ENDCM1 LDA SCREEN,X
0230       AND #$7F
0240       STA SCREEN,X
0250       DEX 
0260       CPX SELTAB
0270       BCS ENDCM1
0280       LDX #$FF
0290       TXS 
0300 ;
0310 ;WAIT FOR KEY
0320 ;
0330 KEY   LDA COLTAB+4
0340       STA COLPF0+4
0350       LDA #0
0360       STA SKCTL
0370       STA CDTMV1
0380       STA CDTMV1+1
0390       STA PDVMSK
0400       LDA #$03
0410       STA SSKCTL
0420       STA SKCTL
0430       LDX #RESTO1-RESTOG  ; RESET ON
0440 RESON1 LDA CPAGE,X
0450       STA SPAGE,X
0460       LDA RESTOG,X
0470       STA CPAGE,X
0480       DEX 
0490       BPL RESON1
0500       JSR CPAGE
0510       LDA #MYIRQ&$FF      ; SET IRQ VECTOR
0520       LDX #MYIRQ/256
0530       STA VIMIRQ
0540       STX VIMIRQ+1
0550       LDA #MYVBL&$FF      ; SET VBLANK VECTOR
0560       LDX #MYVBL/256
0570       STA VVBLKI
0580       STX VVBLKI+1
0590       LDA #1              ; NOISY I/O
0600       STA SOUNDR
0610       STA BRKKEY
0620       LDA #$CC            ; SET BAUD RATE
0630       LDX #$05            ; FOR CASSETTE
0640       STA CBAUDL
0650       STX CBAUDH
0660       LDA PAL
0670       LSR A
0680       AND #1
0690       EOR #1
0700       STA PALNTS
0710 KEY1  LDA SKSTAT          ; WAIT FOR NEW KEY
0720       AND #4
0730       BEQ KEY1
0740 KEY2  LDA SKSTAT
0750       AND #4
0760       BNE KEY2
0770       LDA RTCLOK+2        ; SET AUTOREPEAT TIMER
0780       CLC 
0790       ADC #25
0800       STA KEYTIM
0810 ;
0820       JSR CPAGE           ; RESET OFF
0830       LDX #RESTO1-RESTOG
0840 RESON2 LDA SPAGE,X
0850       STA CPAGE,X
0860       DEX 
0870       BPL RESON2
0880 ;
0890       LDA KBCODE          ; VALID?
0900       AND #$3F
0910       LDX #6
0920 KEY3  CMP KEYTAB,X
0930       BEQ KEY4
0940       DEX 
0950       BPL KEY3
0960 KEY7  LDA SKSTAT
0970       AND #4
0980       BEQ KEY7
0990       JMP KEY
1000 ;
1010 KEY4  LDY #$7F            ; CLICK
1020 KEY5  STY CONSOL
1030       STY WSYNC
1040       DEY 
1050       BPL KEY5
1060 ;
1070       CPX #6
1080       BEQ SPACE
1090       LDY SELTAB,X        ; MARK CHOICE
1100       TXA                 ; AND BRANCH
1110       ASL A
1120       TAX 
1130       LDA CMDV+1,X
1140       PHA 
1150       LDA CMDV,X
1160       PHA 
1170       LDX #3
1180 KEY6  LDA SCREEN,Y
1190       ORA #$80
1200       STA SCREEN,Y
1210       INY 
1220       DEX 
1230       BNE KEY6
1240       LDA #2
1250       STA CHACTL
1260       RTS 
1270 ;
1280 KEYTAB .BYTE $3E,$2A,$17,$28,$16,$3A,$21
1290 ;
1300 SELTAB .BYTE MENU-DLIST
1310       .BYTE MENU-DLIST+32
1320       .BYTE MENU-DLIST+64
1330       .BYTE MENU-DLIST+16
1340       .BYTE MENU-DLIST+48
1350       .BYTE MENU-DLIST+80
1360       .BYTE MENU-DLIST+82
1370 ;
1380 CMDV  .WORD AKEY-1
1390       .WORD BKEY-1
1400       .WORD CKEY-1
1410       .WORD DKEY-1
1420       .WORD EKEY-1
1430       .WORD FKEY-1
1440 ;
1450 RESTOG STA BRKCTL
1460       LDA PUPBT1
1470       EOR #$FF
1480       STA PUPBT1
1490       STA BRKCTL
1500 RESTO1 RTS 
1510 ;
1520 SPACE LDA SKSTAT          ; WAIT FOR KEY RELEASED
1530       AND #4
1540       BEQ SPACE
1550       JMP RSTART
1560 ;
1570 ;-------------------------------
1580 ;USER INTERFACE ROUTINES
1590 ;-------------------------------
1600 ;
1610 ;WAIT FOR KEY, CODE TO A
1620 ;
1630 GETKEY LDA #3
1640       STA SSKCTL
1650       STA SKCTL
1660       LDA #$40
1670       STA NMIEN
1680 GETKE1 LDA KEYTIM         ; WAIT FOR KEY
1690       CMP RTCLOK+2        ; RELEASED OR TIMER
1700       BNE GETKE2
1710       ADC #4
1720       STA KEYTIM
1730       JMP GETKE4
1740 GETKE2 LDA SKSTAT
1750       AND #4
1760       BEQ GETKE1
1770 ;
1780 GETKE3 LDA RTCLOK+2       ; WAIT FOR KEY
1790       CLC 
1800       ADC #25
1810       STA KEYTIM
1820       LDA SKSTAT
1830       AND #4
1840       BNE GETKE3
1850 ;
1860 GETKE4 LDA #0
1870       STA NMIEN
1880       LDY #$7F            ; CLICK
1890 GETKE5 STY CONSOL
1900       STY WSYNC
1910       DEY 
1920       BPL GETKE5
1930 ;
1940       LDA KBCODE          ; DETERMINE KEY CODE
1950       CMP #$C0
1960       BCC GETKE6
1970       AND #$BF            ; CONTROL OVERRIDES SHIFT
1980 GETKE6 TAX 
1990       LDA KEYCOD,X
2000       BEQ GETKEY
2010       RTS 
2020 ;
2030 KEYCOD .BYTE $4C,$4A,$3A,0,0,$4B,$2B,$2A
2040       .BYTE $4F,0,$50,$55,$9B,$49,$2D,$3D
2050       .BYTE $56,0,$43,0,0,$42,$58,$5A
2060       .BYTE $34,0,$33,$36,$1B,$35,$32,$31
2070       .BYTE $2C,$20,$2E,$4E,0,$4D,$2F,0
2080       .BYTE $52,0,$45,$59,0,$54,$57,$51
2090       .BYTE $39,0,$30,$37,$7E,$38,$3C,$3E
2100       .BYTE $46,$48,$44,0,0,$47,$53,$41
2110 ;
2120       .BYTE $4C,$4A,$3A,0,0,$4B,$5C,$5E
2130       .BYTE $4F,0,$50,$55,$9B,$49,$5F,$7C
2140       .BYTE $56,0,$43,0,0,$42,$58,$5A
2150       .BYTE $24,0,$23,$26,$1B,$25,$22,$21
2160       .BYTE $5B,$20,$5D,$4E,$00,$4D,$3F,0
2170       .BYTE $52,0,$45,$59,0,$54,$57,$51
2180       .BYTE $28,0,$29,$27,$9C,$40,$7D,$9D
2190       .BYTE $46,$48,$44,0,0,$47,$53,$41
2200 ;
2210       .BYTE 0,0,0,0,0,0,$1E,$1F
2220       .BYTE 0,0,0,0,$9B,0,$1C,$1D
2230       .BYTE 0,0,0,0,0,0,0,0
2240       .BYTE 0,0,0,0,0,0,0,0
2250       .BYTE 0,$20,0,0,0,0,0,0
2260       .BYTE 0,0,0,0,0,0,0,0
2270       .BYTE 0,0,0,0,$FE,0,$7D,$FF
2280       .BYTE 0,0,0,0,0,0,0,0
2290 ;
2300 ;SAVE EXTERN MENU
2310 ;
2320 AKEY  LDX #0
2330 SEXT  STA WSYNC
2340       STA WSYNC
2350       STA WSYNC
2360       DEX 
2370       BNE SEXT
2380       LDX #$5F
2390 SEX1  LDA SCREEN+$56,X
2400       STA SPAGE,X
2410       LDA MENUA,X
2420       STA SCREEN+$56,X
2430       DEX 
2440       BPL SEX1
2450       LDA #0
2460       STA SCREEN+22
2470 ;
2480 SEX2  JSR GETKEY
2490       CMP #'C
2500       BEQ SEX3            ; SAVE CASSETTE
2510       CMP #'B
2520       BEQ SEX4            ; SAVE BOOT
2530       CMP #'F
2540       BNE SEX5
2550       JSR FNAME           ; SAVE FILE
2560       JSR OLDSCR
2570       JMP SAVFIL
2580 SEX3  JSR OLDSCR
2590       JMP SCASS
2600 SEX4  JSR OLDSCR
2610       JMP SAVDBO
2620 SEX5  JSR OLDSCR
2630       JMP ENDCMD
2640 ;
2650 MENUA .SBYTE +$80,"SAVE PROGRAM TO EXTERNAL STORAGE"
2660       .SBYTE "[C] CASSETTE  [B] BOOT  [F] FILE"
2670 ;
2680 ;RESTORE MAIN MENU
2690 ;
2700 OLDSCR LDX #$5F
2710 OLDSC1 LDA SPAGE,X
2720       STA SCREEN+$56,X
2730       DEX 
2740       BPL OLDSC1
2750       LDA #2
2760       STA SCREEN+22
2770       RTS 
2780 ;
2790 ;ASK FOR FILE NAME (TO /NAME/)
2800 ;
2810 FNAME LDX #$1F
2820 FNAM1 LDA MENUN,X
2830       STA SCREEN+$76,X
2840       DEX 
2850       BPL FNAM1
2860 ;
2870 FNAM2 LDX #$87            ; INIT CURSOR
2880 FNAM3 CPX #$87            ; CURSOR BOUNDARY CHECK
2890       BCC FNAM2
2900       CPX #$94
2910       BCC FNAM4
2920       LDX #$94
2930 FNAM4 LDA SCREEN,X        ; SHOW CURSOR
2940       ORA #$80
2950       STA SCREEN,X
2960       TXA 
2970       PHA 
2980       JSR GETKEY
2990       TAY 
3000       PLA 
3010       TAX 
3020       LDA SCREEN,X        ; REMOVE CURSOR
3030       AND #$7F
3040       STA SCREEN,X
3050       TYA 
3060       CMP #$7E            ; BS?
3070       BNE FNAM6
3080       LDA #0
3090       STA SCREEN,X
3100 FNAM5 DEX 
3110       BNE FNAM3           ; ALWAYS
3120 FNAM6 CMP #$1E            ; CURSOR <-?
3130       BEQ FNAM5
3140       CMP #$1F            ; CURSOR ->?
3150       BNE FNAM7
3160       INX 
3170       BNE FNAM3           ; ALWAYS
3180 FNAM7 CMP #$9B            ; EOL?
3190       BEQ FNAM9
3200       CMP #'.
3210       BEQ FNAM8
3220       CMP #'?
3230       BEQ FNAM8
3240       CMP #'*
3250       BEQ FNAM8
3260       CMP #$20
3270       BEQ FNAM8
3280       CMP #'0
3290       BCC FNAM3
3300       CMP #'9+1
3310       BCC FNAM8
3320       CMP #'A
3330       BCC FNAM3
3340       CMP #'Z+1
3350       BCS FNAM3
3360 FNAM8 SEC 
3370       SBC #$20
3380       STA SCREEN,X
3390       INX 
3400       JMP FNAM3
3410 ;
3420 FNAM9 SEC 
3430       SBC #$20
3440       STA SCREEN,X
3450       LDA #8
3460       STA FILENO
3470       LDX #$87
3480       LDY #0
3490 FNA10 LDA SCREEN,X        ; CONVERT FILENAME
3500       INX 
3510       CLC 
3520       ADC #$20
3530 FNA11 CMP #$9B
3540       BEQ FNA12
3550       CMP #$20
3560       BNE FNA15
3570 FNA12 CPY #11
3580       BCS FNAX1
3590       LDA #$20
3600       STA NAME,Y
3610       INY 
3620       BNE FNA12           ; ALWAYS
3630 FNAX1 LDA NAME
3640       CMP #$20
3650       BNE FNA14           ; LEGAL NAME
3660       LDX #10             ; USE DEFAULT NAME
3670 FNA13 LDA DEFNAM,X
3680       STA NAME,X
3690       DEX 
3700       BPL FNA13
3710 FNA14 RTS 
3720 DEFNAM .BYTE "CORE       "
3730 FNA15 CPY FILENO
3740       BNE FNA16
3750       CMP #'.
3760       BNE FNA10
3770 FNAX2 LDA #11
3780       STA FILENO
3790       BNE FNA10
3800 FNA16 CMP #'.
3810       BEQ FNA17
3820       CMP #'*
3830       BEQ FNA18
3840       STA NAME,Y
3850       INY 
3860       BNE FNA10
3870 FNA17 LDA #$20
3880       BNE FNA19
3890 FNA18 LDA #'?
3900 FNA19 STA NAME,Y
3910       INY 
3920       CPY FILENO
3930       BNE FNA19
3940       CMP #$20
3950       BEQ FNAX2
3960       BNE FNA10
3970 ;
3980 MENUN .SBYTE "ENTER FILENAME ->              <"
3990 ;
4000 ;LOAD EXTERN MENU
4010 ;
4020 BKEY  LDX #0
4030 LEXT  STA WSYNC
4040       STA WSYNC
4050       STA WSYNC
4060       DEX 
4070       BNE LEXT
4080       LDX #$5F
4090 LEX1  LDA SCREEN+$56,X
4100       STA SPAGE,X
4110       LDA MENUB,X
4120       STA SCREEN+$56,X
4130       DEX 
4140       BPL LEX1
4150       LDA #0
4160       STA SCREEN+22
4170 ;
4180 LEX2  JSR GETKEY
4190       CMP #'C
4200       BEQ LEX3            ; LOAD CASSETTE
4210       CMP #'B
4220       BEQ LEX4            ; LOAD BOOT
4230       CMP #'F
4240       BNE LEX5
4250       JSR FNAME           ; LOAD FILE
4260       JSR OLDSCR
4270       JMP EXEFIL
4280 LEX3  JSR OLDSCR
4290       JMP ECASS
4300 LEX4  JSR OLDSCR
4310       JMP EXEDBO
4320 LEX5  JSR OLDSCR
4330       JMP ENDCMD
4340 ;
4350 MENUB .SBYTE +$80, "EXEC PROGRAM FROM EXTERNAL STORE"
4360       .SBYTE "[C] CASSETTE  [B] BOOT  [F] FILE"
4370 ;
4380 ;ERROR HANDLER, Y=ERROR CODE
4390 ;
4400 ERROR LDA #$FF
4410       STA PORTB           ; OS ON
4420       LDA #0              ; DMA OFF
4430       STA DMACTL
4440       LDA #SCREEN&$FF
4450       STA DLISTL
4460       LDA #SCREEN/256
4470       STA DLISTH
4480       LDX #0
4490 ERRO0 LDA DLIST,X
4500       STA SCREEN,X
4510       INX 
4520       CPX #DLEND-DLIST
4530       BNE ERRO0
4540       LDA COLTAB+4
4550       STA COLPF0+4
4560       JSR DMAON
4570       LDX #$5F            ; SAVE SCREEN
4580 ERRO1 LDA SCREEN+$56,X
4590       STA SPAGE,X
4600       LDA MENUE,X
4610       STA SCREEN+$56,X
4620       DEX 
4630       BPL ERRO1
4640       LDA #0
4650       STA SCREEN+22
4660       LDX #0              ; INDEX INTO ERROR TEXTS
4670 ERRO2 LDA MENUE,X
4680       BMI ERRO3
4690       INX 
4700       BNE ERRO2
4710 ERRO3 INX 
4720       DEY 
4730       BPL ERRO2
4740       LDY #7              ; COPY TEXT TO SCREEN
4750 ERRO4 LDA MENUE,X
4760       PHP 
4770       AND #$7F
4780       SEC 
4790       SBC #$20
4800       STA SCREEN+$56,Y
4810       INX 
4820       INY 
4830       PLP 
4840       BPL ERRO4
4850       LDY #10             ; BEEP
4860 ERRO6 LDX #0
4870 ERRO7 STX CONSOL
4880       STX WSYNC
4890       INX 
4900       BNE ERRO7
4910 ERRO8 INX 
4920       BPL ERRO8
4930       DEY 
4940       BNE ERRO6
4950       JSR GETKEY          ; WAIT FOR KEY
4960       JSR OLDSCR
4970       JMP ENDCMD
4980 ;
4990 MENUE .SBYTE "ERROR:                          "
5000       .SBYTE "OPERATION TERMINATED, HIT RETURN",$80
5010       .CBYTE "FILE NOT FOUND"
5020       .CBYTE "FILE# MISMATCH"
5030       .CBYTE " "
5040       .CBYTE "BAD DISK I/O"
5050       .CBYTE "NO DRIVE"
5060       .CBYTE "DISK FULL"
5070       .CBYTE "FILE LOCKED"
5080       .CBYTE "DIRECTORY FULL"
5090       .CBYTE "BAD CASSETTE I/O"
5100 ;
5110 ;CLEAR OS RAM COMMAND
5120 ;
5130 CKEY  JSR OSRCLR          ; IN DEBUGGER
5140       JMP ENDCMD
5150 ;
5160 ;ENTER DEBUGGER
5170 ;
5180 ;
5190 ;DMA ON
5200 ;
5210 DMAON LDA VCOUNT
5220       CMP #124
5230       BCC DMAON
5240       LDA #$21
5250       STA DMACTL
5260       RTS 
