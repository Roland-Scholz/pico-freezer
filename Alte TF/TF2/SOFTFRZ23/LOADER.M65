0100 ;-------------------------------
0110 ;LOADER:DIVIDES SYSTEM STATUS IN
0120 ;       BLOCKS OF LENGTH NCOUNT
0130 ;       AND LOADS THEM VIA CALLS
0140 ;       TO THE DEVICE HANDLERS.
0150 ;-------------------------------
0160 ;
0170 LOAD  JSR READ
0180       LDX #RSVECH-SGTIA
0190 LOA1  LDA DBUF,X
0200       STA SGTIA,X
0210       DEX 
0220       BPL LOA1
0230 ;
0240       BIT FILENO
0250       BVS LOA3            ; NOT COMPACTED DATA
0260 ;
0270       JSR READ            ; READ MAP OF USED BLOCKS
0280       LDX #65
0290 LOA2  LDA DBUF,X
0300       STA USEMAP,X
0310       DEX 
0320       BPL LOA2
0330 ;
0340 LOA3  LDA #0
0350       STA RPNT
0360       STA RPNT+1
0370       STA MAPIDX
0380       LDA #$80
0390       STA MAPMSK
0400       LDA NCOUNT
0410       STA DCOUNT
0420 ;
0430 LOA4  BIT FILENO          ; ACTUAL LOAD LOOP
0440       BVS LOA6            ; NOT COMPACTED DATA
0450       LDX MAPIDX
0460       LDA USEMAP,X
0470       AND MAPMSK
0480       BEQ LOA6            ; BLOCK NOT ZERO
0490       LDX #0
0500       TXA 
0510 LOA5  STA DBUF,X
0520       INX 
0530       BNE LOA5
0540       BEQ LOA7
0550 ;
0560 LOA6  JSR READ
0570 LOA7  JSR TORAM
0580       JSR ADVMAP
0590       JSR ADVPNT
0600       BCC LOA4
0610 ;
0620       LDA #$FF
0630       STA PORTB
0640       JMP DMAON
0650 ;
0660 ;MOVE BLOCK FROM DBUF TO (RPNT)
0670 ;
0680 TORAM LDA RPNT+1          ; DBUF TO (RPNT)
0690       CMP #$40
0700       BCS TORA4
0710 ;
0720       LDA #0
0730       STA DMACTL          ; 0000-3FFF
0740       LDX #TORA3-TORA2
0750 TORA1 LDA TORA2,X
0760       STA CPAGE,X
0770       DEX 
0780       BPL TORA1
0790       LDA RPNT
0800       STA CPAGE+7
0810       LDA RPNT+1
0820       STA CPAGE+8
0830       LDY #0
0840       JMP CPAGE
0850 ;
0860 TORA2 LDA DBUF,Y
0870       STA BRKCTL
0880       STA $EEEE,Y
0890       STA BRKCTL
0900       INY 
0910       CPY DCOUNT
0920       BNE TORA2
0930       JMP TORA3
0940 ;
0950 TORA3 RTS 
0960 TORA4 CMP #$BF
0970       BCS TORA7
0980       LDA #$21            ; 4000-BF00
0990       STA DMACTL
1000 TORA5 LDY #0
1010 TORA6 LDA DBUF,Y
1020       STA (RPNT),Y
1030       INY 
1040       CPY DCOUNT
1050       BNE TORA6
1060       LDA #$FF
1070       STA PORTB
1080       RTS 
1090 ;
1100 TORA7 LDA #0              ; BF00-FFFF
1110       STA DMACTL
1120       LDA #$FE
1130       STA PORTB           ; OS OFF
1140       BNE TORA5           ; ALWAYS
1150 ;
1160 ;JUMP TO DEVICE HANDLERS TO
1170 ;LOAD BLOCK INTO DBUF
1180 ;
1190 READ  LDX DEVICE
1200       BEQ READ1
1210       DEX 
1220       BEQ READ2
1230       JMP RCASS
1240 READ1 JMP RRAMD
1250 READ2 JMP RDISK
