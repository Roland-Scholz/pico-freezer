library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
library synplify;
use synplify.components.all;

entity DFF is
port(
  Q :  out std_logic;
  D :  in std_logic;
  CLK :  in std_logic);
end DFF;

architecture beh of DFF is
  signal VCC : std_logic ;
  signal GND : std_logic ;
  component MACH_DFF
    port(
      Q : out std_logic;
      D : in std_logic;
      CLK : in std_logic;
      R : in std_logic;
      S : in std_logic;
      NOTIFIER : in std_logic  );
  end component;
begin
  II_INS4: MACH_DFF port map (
      Q => Q,
      D => D,
      CLK => CLK,
      R => VCC,
      S => VCC,
      NOTIFIER => GND);
  VCC <= '1';
  GND <= '0';
end beh;

