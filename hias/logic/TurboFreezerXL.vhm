library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
library synplify;
use synplify.components.all;

entity DFFRSH is
port(
  Q :  out std_logic;
  D :  in std_logic;
  CLK :  in std_logic;
  R :  in std_logic;
  S :  in std_logic);
end DFFRSH;

architecture beh of DFFRSH is
  signal un2 : std_logic ;
  signal un1 : std_logic ;
  signal VCC : std_logic ;
  signal GND : std_logic ;
  component MACH_DFF
    port(
      Q : out std_logic;
      D : in std_logic;
      CLK : in std_logic;
      R : in std_logic;
      S : in std_logic;
      NOTIFIER : in std_logic  );
  end component;
begin
  II_INS7: MACH_DFF port map (
      Q => Q,
      D => D,
      CLK => CLK,
      R => un2,
      S => un1,
      NOTIFIER => GND);
  un1 <= not S;
  un2 <= not R;
  VCC <= '1';
  GND <= '0';
end beh;

