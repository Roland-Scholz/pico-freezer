end DFFRH;

architecture beh of DFFRH is
  signal un1 : std_logic ;
  signal VCC : std_logic ;
  signal GND : std_logic ;
  component MACH_DFF
    port(
      Q : out std_logic;
      D : in std_logic;
      CLK : in std_logic;
      R : in std_logic;
      S : in std_logic;
      NOTIFIER : in std_logic  );
  end component;
begin
  II_INS1: MACH_DFF port map (
      Q => Q,
      D => D,
      CLK => CLK,
      R => un1,
      S => VCC,
      NOTIFIER => GND);
  un1 <= not R;
  VCC <= '1';
  GND <= '0';
end beh;

