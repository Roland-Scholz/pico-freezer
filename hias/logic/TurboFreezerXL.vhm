  \II_use_vector_bankno_0.n\: AND2 port map (
      O => \use_vector_bankno_0.un0\,
      I0 => use_vector_bankno,
      I1 => \use_vector_bankno_0.un3\);
  \II_use_vector_bankno_0.p\: OR2 port map (
      O => N_10,
      I0 => \use_vector_bankno_0.un1\,
      I1 => \use_vector_bankno_0.un0\);
  GND <= '0';
  VCC <= '1';
end beh;

