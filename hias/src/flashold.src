	.include "cio.inc"
	.include "flash05.inc"

ORG = $2000

; flash destiniation address ($0000-$3fff)
SRCADR	= $E0 ; $E1
DSTADR	= $E2 ; $E3
TMPADR	= $E4 ; $E5

BASE	= $A000
END	= $C000

; flash type definitions
TAMD	= 0	; AMD 29F010
TAMD40	= 1	; AMD 29F040 / ST 29F010
TSSTWIN	= 2	; SST 29EE010 / Winbond 29EE011

; program modes
PMFLASH	= 0
PMRAM	= 1

	* = ORG

	JSR INIT

MAINLP	BPUT 0, TITLEN, TITLE
	JSR DETECT
	BPL MOK
	STA WRDIS
	STA DISABLE
	JMP AGAIN

MOK	LDX BLKSIZE
	DEX
	STX BLKMSK1
	TXA
	EOR #$FF
	STA BLKMSK2

	BPUT 0, BSIZTL, BSIZT

	LDA BLKSIZE
	JSR PRDEC
	LDA #32
	JSR PUTCHAR
	LDA #'(
	JSR PUTCHAR
	LDA BLKSIZE
	ASL
	ASL
	ASL
	JSR PRDEC
	LDA #'k
	JSR PUTCHAR
	LDA #')
	JSR PUTCHAR
	LDA #155
	JSR PUTCHAR
	
	JSR SETREAD
	STA WRDIS
        JSR CHKVER
	STA DISABLE

	BPUT 0, MENULEN, MENU
MENULP	JSR GETCHAR
	CPY #128
	BNE MENUL1
	JMP MAINLP
MENUL1	CMP #'0
	BNE NEXIT
EXIT	JSR CLEANUP
	JMP ($A)
NEXIT	CMP #'1
	BNE NO1

	LDX #PMFLASH
	STX PMODE
	JMP DOFLASH

NO1	CMP #'2
	BNE NO2

	LDX #PMFLASH
	STX PMODE
	JMP DOWRITE

NO2	CMP #'3
	BEQ DOERAS

	CMP #'4
	BNE NO4

	LDX #PMRAM
	STX PMODE
	JMP DOFLASH

NO4	CMP #'5
	BNE NO5

	LDX #PMRAM
	STX PMODE
	JMP DOWRITE

NO5	CMP #'6
	BNE NO6
	JMP DOERASR

NO6	CMP #'7
	BNE MENULP
	JMP DOSTRT

DOERAS	JSR PUTCHAR
	LDA #155
	JSR PUTCHAR

	BPUT 0, REALLYL, REALLYT
	JSR YESNO
	BPL DOERAS1
	JMP MAINLP
DOERAS1 BEQ DOERAS2
	JMP AGAIN

DOERAS2	LDA #155
	JSR PUTCHAR
	LDA #155
	JSR PUTCHAR

	LDA #$FF
	STA BANKNO

	BPUT 0, ERAS2L, ERAS2

	STA ENABLE
	STA WREN
	JSR ERASE
	STA DISABLE
	STA WRDIS

	BPL EOK0
	JSR PERROR
	JMP AGAIN
EOK0	JSR POK
	JMP AGAIN	

; erase freezer RAM

DOERASR	JSR PUTCHAR
	LDA #155
	JSR PUTCHAR

	BPUT 0, REALLYRL, REALLYR
	JSR YESNO
	BPL DOERAR1
	JMP MAINLP
DOERAR1	BEQ DOERAR2
	JMP AGAIN

DOERAR2	LDA #155
	JSR PUTCHAR
	LDA #155
	JSR PUTCHAR

	LDA #0
	STA BANKNO

	BPUT 0, ERAS2L, ERAS2

	STA ENABLE
	STA WREN
	STA MODERAM

DOERAR3 LDX BANKNO
	STA BANKREG,X
	LDA #<BASE
	STA DSTADR
	LDA #>BASE
	STA DSTADR+1
	LDY #0
	LDX #$20
	LDA #$FF
ERARLP	STA (DSTADR),Y
	INY
	BNE ERARLP
	INC DSTADR+1
	DEX
	BNE ERARLP

	INC BANKNO
	LDA BANKNO
	CMP #15
	BNE DOERAR3

	STA MODEROM
	STA WRDIS
	STA DISABLE

	JSR POK
	JMP AGAIN

; write flash to file

DOWRITE	JSR PUTCHAR
	LDA #155
	JSR PUTCHAR

	LDA PMODE
	CMP #PMFLASH
	BEQ WFL1

	SEC
	LDA NUMRAM
	SBC #1
	JMP WIBNK
WFL1	SEC
	LDA NUMFLSH
	SBC #1
WIBNK	LDX #0
	LDY #0
	STA TMPADR
	JSR INPBANK
	BPL WB1OK
WB1X	JMP MAINLP
WB1OK	BCS WB2OK
WB2X	JMP AGAIN
WB2OK	LDA BANKNO
	STA MINBANK

	LDA TMPADR
	LDX #0
	LDY MINBANK
	JSR INPEBNK
	BMI WB1X
	BCC WB2X
	LDA BANKNO
	STA MAXBANK
	LDA MINBANK
	STA BANKNO

	JSR GETFN
	BPL DOWR1
	JMP MAINLP
DOWR1	BCS DOWR11
	JMP AGAIN

DOWR11	OPEN 1,8,0,BUF
	BPL WRFLP
	CLOSE 1
	PRINT 0, OPENERR
	JMP AGAIN

WRFLP	JSR PBANK

	LDX BANKNO
	STA BANKREG,X

	LDA #<BASE
	STA SRCADR
	LDA #>BASE
	STA SRCADR+1
	LDA #<DATA
	STA DSTADR
	LDA #>DATA
	STA DSTADR+1

	LDA PMODE
	CMP #PMFLASH
	BEQ DOWR2
	STA MODERAM
	JMP DOWR3
DOWR2	STA MODEROM
DOWR3	STA ENABLE
	STA WRDIS

	LDX #>(END-BASE)
	LDY #0
DOWR4	LDA (SRCADR),Y
	STA (DSTADR),Y
	INY
	BNE DOWR4
	INC SRCADR+1
	INC DSTADR+1
	DEX
	BNE DOWR4

	STA MODEROM
	STA DISABLE

	BPUT 0, BNKWRL, BNKWR
	BPUT 1, 8192, DATA
	BPL WRFOK

	JSR PERROR
	CLOSE 1
	JMP AGAIN

WRFOK	JSR POK
	LDA BANKNO
	CMP MAXBANK
	BEQ WRFIN
	INC BANKNO
	JMP WRFLP

WRFIN	CLOSE 1
	JMP AGAIN


; program flash

DOFLASH	JSR PUTCHAR
	LDA #155
	JSR PUTCHAR

	LDA PMODE
	CMP #PMFLASH
	BEQ PFL1

	SEC
	LDA NUMRAM
	STA LBANK
	SBC #1
	LDX #0
	BEQ PIBNK

PFL1	SEC
	LDA NUMFLSH
	STA LBANK
	SBC #1
	AND BLKMSK2
	LDX BLKMSK1
PIBNK	LDY #0
	JSR INPBANK
	BPL INBOK1
	JMP MAINLP
INBOK1	BCS INBOK2
	JMP AGAIN
	
INBOK2	LDA BANKNO
	STA BANKNOR	; remember starting bank

	JSR GETFN
	BPL INBOK3
	JMP MAINLP
INBOK3	BCS FNDDRV
	JMP AGAIN

FNDDRV	OPEN 1,4,0,BUF
	BPL PROGLP
	CLOSE 1
	PRINT 0, OPENERR
	JMP AGAIN

PROGLP	BGET 1, 1, DATA
	BPL NXTBLK
	JMP NNXT

NXTBLK	JSR PBANK

	BPUT 0, BNKRDL, BNKRD
	BGET 1, 8191, DATA+1
	BPL RDFOK

RDERR	JSR PERROR
	CLOSE 1
	JMP AGAIN

RDFOK	JSR POK
	LDA PMODE
	CMP #PMRAM
	BEQ NOERAS

	LDA NEEDERA
	BEQ NOERAS

	LDA BANKNO
	AND BLKMSK1
	BNE NOERAS

	BPUT 0, ERASL, ERAS

	STA ENABLE
	STA WREN
	JSR ERASE
	STA DISABLE
	STA WRDIS

	BPL EOK1
	JSR PERROR
XPRG	CLOSE 1
	JMP AGAIN

EOK1	JSR POK

NOERAS	LDA #<DATA
	STA SRCADR
	LDA #>DATA
	STA SRCADR+1
	LDA #<BASE
	STA DSTADR
	LDA #>BASE
	STA DSTADR+1

	BPUT 0, PROGL, PROG

	STA ENABLE
	STA WREN

	LDA PMODE
	CMP #PMFLASH
	BEQ PFL2

	STA MODERAM
	JSR PRGRAM
	STA MODEROM
	JMP CHKPRG

PFL2	JSR PROGBLK
CHKPRG	STA DISABLE
	STA WRDIS
	BPL POK1

	BPUT 0, PRGERRL, PRGERRT

	LDA DSTADR+1
	JSR PUTHEX
	LDA DSTADR
	JSR PUTHEX
	LDA #155
	JSR PUTCHAR
	JMP XPRG

POK1	JSR POK
	LDA #<DATA
	STA SRCADR
	LDA #>DATA
	STA SRCADR+1
	LDA #<BASE
	STA DSTADR
	LDA #>BASE
	STA DSTADR+1

	BPUT 0, VFYTL, VFYT

	STA ENABLE
	LDA PMODE
	CMP #PMFLASH
	BEQ PFL3
	STA MODERAM
PFL3	JSR VERIFY
	STA MODEROM
	STA DISABLE

	BPL VOK1

	BPUT 0, VFYERRL, VFYERRT

	LDA DSTADR+1
	JSR PUTHEX
	LDA DSTADR
	JSR PUTHEX
	LDA #155
	JSR PUTCHAR
	JMP XPRG
	
VOK1	JSR POK
	INC BANKNO
	LDA BANKNO
	CMP LBANK
	BCS NNXT
	JMP PROGLP

NNXT	CLOSE 1

; wait for key to restart or run cartridge

AGAINR	LDA #'O
	LDX PMODE
	CPX #PMFLASH
	BEQ AGAINR1
	LDA #'A
AGAINR1	STA RUNSRC
	LDA BANKNOR
	JSR TODEC
	TXA
	CLC
	ADC #'0
	STA RUNBNK
	TYA
	CLC
	ADC #'0
	STA RUNBNK+1

	BPUT 0, AGATRL, AGART
AGARLP	LDA #255
	STA 764
	JSR GETCHAR
	CPY #128
	BEQ AGARX

	CMP #'R
	BEQ RAGA
	CMP #'r
	BEQ RAGA
AGARX	JMP MAINLP

; run cartridge

RAGA	JSR PUTCHAR
	BPUT 0, RUNCTTL, RUNCTT

RAGA1	JSR GETCHAR
	CPY #128
	BEQ AGARX

	LDX #<MODE16K
	CMP #'1
	BEQ CRUN
	LDX #<MODE8K
	CMP #'8
	BEQ CRUN
	LDX #<MODEOSS
	CMP #'O
	BEQ CRUN
	CMP #'o
	BEQ CRUN
	LDX #<MODESDX
	CMP #'S
	BEQ CRUN
	CMP #'s
	BEQ CRUN

	LDA #155
	JSR PUTCHAR
	JMP AGAINR

CRUN	LDA #0
	STA 559
	STA $D400
	STA WRDIS

	STA MODEROM
	LDA PMODE
	CMP #PMFLASH
	BEQ CRUN1
	STA MODERAM
	
CRUN1	STA MODKEEP
	STA ENABLE
	STA $D500,X	; set mode

	LDY BANKNOR
	STA BANKREG,Y

	CPX #<MODEOSS
	BNE CRUN2
	STA OSSBNK1

CRUN2	CPX #<MODESDX
	BNE CRUN3
	STA SDXBANK

CRUN3	JMP $E477

; wait for any key and restart program

AGAIN	BPUT 0, AGATL, AGAT
AGALP	LDA #255
	STA 764
	JSR GETCHAR
;	BMI AGALP
	JMP MAINLP


YESNO	JSR GETCHAR
	CPY #128
	BEQ YBRK
	CMP #'Y
	BEQ YYES
	CMP #'y
	BEQ YYES
	CMP #'N
	BEQ YNO
	CMP #'n
	BEQ YNO
	JMP YESNO
YNO	LDX #1
YYES	PHP
	JSR PUTCHAR
	PLP
	RTS

YBRK	LDY #$FF
	RTS	; return with N=1


CURSEC	.WORD 0
CURBYT	.BYTE 0

GR0	CLOSE 0
	OPEN 0,12,0,EDITOR
	LDA 20
	CLC
	ADC #2
WVBI	CMP 20
	BNE WVBI
	RTS

; input starting bank number A=maximum number
; return: N=1 on break (exit), C=0 on error, C=1 if OK

INPBANK	STA MAXBANK
	STX BMASK
	STY MINBANK
	LDA #0
	STA BANKNO

	BPUT 0, STBKL1, STBK1

	LDA MINBANK
	JSR PRDEC
	LDA #'-
	JSR PUTCHAR
	LDA MAXBANK
	JSR PRDEC

	BPUT 0, STBKL2, STBK2

	INPUT 0,BUF
	BPL IOK1
IERR1	LDA #$FF
	RTS

IOK1	LDA BUF
	CMP #155
	BEQ IERR1

	JSR GETDEC
	BMI DECERR
	LDA BUF+1
	CMP #155
	BEQ ENDDEC
	JSR GETDEC
	BMI DECERR
	LDA BUF+2
	CMP #155
	BNE DECERR
ENDDEC	LDA BANKNO
	CMP MINBANK
	BCC DECERR
	CMP MAXBANK
	BEQ DECOK1
	BCS DECERR
DECOK1	LDA BANKNO
	AND BMASK
	BEQ DECOK2
	BPUT 0, IBANKBL, IBANKB
	LDA #0
	CLC
	RTS
DECOK2	LDA #0
	SEC
	RTS
DECERR	BPUT 0, IBANKL, IBANK
	LDA #0
	CLC
	RTS

; input ending bank number

INPEBNK	STA MAXBANK
	STX BMASK
	STY MINBANK
	LDA #0
	STA BANKNO

	BPUT 0, ENBKL1, ENBK1

	LDA MINBANK
	JSR PRDEC
	LDA #'-
	JSR PUTCHAR
	LDA MAXBANK
	JSR PRDEC

	BPUT 0, STBKL2, STBK2

	INPUT 0,BUF
	BPL IOK2
	RTS
IOK2	JMP IOK1


GETDEC	CMP #'0
	BCC DECERR1
	CMP #('9)+1
	BCS DECERR1
	SEC
	SBC #'0
	PHA
	ASL BANKNO
	LDA BANKNO
	ASL
	ASL
	CLC
	ADC BANKNO
	STA BANKNO
	PLA
	CLC
	ADC BANKNO
	STA BANKNO
	LDA #0
	RTS
DECERR1	LDA #$FF
	RTS

; input filename

GETFN	BPUT 0, FNTXTL, FNTXT
	INPUT 0, BUF
	BPL GETFN1
GETFNER	LDA #$FF
	RTS

GETFN1	LDA BUF
	CMP #155
	BEQ GETFNER
	LDX #0
GETFN2	LDA BUF,X
	CMP #':
	BEQ GETFNOK
	CMP #155
	BEQ GETFN3
	INX
	BPL GETFN2

GETFNX	LDA #0
	CLC
	RTS

GETFN3	LDA BUF,X
	STA BUF+2,X
	DEX
	BPL GETFN3
	LDA #'D
	STA BUF
	LDA #':
	STA BUF+1
GETFNOK	LDA #0
	SEC
	RTS

; start cartridge

DOSTRT	STA MODEROM
	STA MODKEEP
	STA MODE8K
	STA SELBANK
	STA ENABLE
	STA WRDIS
	JMP $E477

INIT	LDA 106
	STA M106
	LDA 740
	STA M740
	LDA #$80
	STA 106
	STA 740
	JSR GR0

	LDA $D301
	STA MD301
	ORA #2
	STA $D301
	
	STA DISABLE

	LDA BASE
	EOR #$FF
	STA BASE
	CMP BASE
	BNE INIERR

	RTS

INIERR	PRINT 0,REMCART
	JMP AGAIN

CLEANUP	LDA MD301
	STA $D301
	LDA M106
	STA 106
	LDA M740
	STA 740
	JMP GR0

; program an 8k RAM block

PRGRAM	STA MODERAM
	LDX BANKNO
	STA BANKREG,X
	LDY #0
	LDX #$20
PRAMLP	LDA (SRCADR),Y
	STA (DSTADR),Y
	INY
	BNE PRAMLP
	INC SRCADR+1
	INC DSTADR+1
	DEX
	BNE PRAMLP
	STA MODEROM
	LDA #0
	RTS

; program an 8k flash block

PROGBLK	SEI
	LDA #0
	STA $D40E
	STA $D400
	LDA BANKNO
	ASL
	ASL
	ASL
	ASL
	STA BANKCOL

	LDA TYPE
	CMP #TAMD
	BNE PRGN1

	LDA #<PRGOLD
	STA PROGLP2+1
	LDA #>PRGOLD
	STA PROGLP2+2
	JMP PROGLP1

PRGN1	CMP #TAMD40
	BNE PRGN2

	LDA #<PRGNEW
	STA PROGLP2+1
	LDA #>PRGNEW
	STA PROGLP2+2
	JMP PROGLP1

PRGN2	JSR SIGPRG
	JMP PROGSST

PROGLP1	LDA #0
	STA PROGIDX
	
PROGLP2	JSR $1234
	LDX BANKNO
	STA BANKREG,X
	LDY PROGIDX
	LDA (SRCADR),Y
	STA (DSTADR),Y

	JSR WTDATA

	BPL PROGOK
	CLI
	LDA #$40
	STA $D40E
	STY DSTADR
	LDA #$FF
	RTS

PROGOK	INC PROGIDX
	BNE PROGLP2
	INC SRCADR+1
	INC DSTADR+1
	LDA DSTADR+1
	CMP #>END
	BEQ PROGEND
	LSR
	AND #$0F
	ORA BANKCOL
	STA $D01A
	JMP PROGLP1

PROGIDX	.BYTE 0

PROGEND	CLI
	LDA #$40
	STA $D40E
	RTS

PROGSST JSR SENDSIG
	LDX BANKNO
	STA BANKREG,X
	
	LDY #0
PPAGLP	LDA (SRCADR),Y
	STA (DSTADR),Y
	INY
	CPY #$80
	BNE PPAGLP

	LDY #127
WTDLP2	LDA (DSTADR),Y
	EOR (DSTADR),Y
	AND #$40
	BNE WTDLP2

	CLC
	LDA SRCADR
	ADC #128
	STA SRCADR
	BCC NI2
	INC SRCADR+1
NI2	CLC
	LDA DSTADR
	ADC #128
	STA DSTADR
	BCC PROGSST
	INC DSTADR+1
	LDA DSTADR+1
	CMP #>END
	BEQ SSTEND
	LSR
	AND #$0F
	ORA BANKCOL
	STA $D01A
	JMP PROGSST

SSTEND	LDA #$40
	STA $D40E
	CLI
	LDA #0
	RTS

PWERR	TYA
	CLC
	ADC DSTADR
	STA DSTADR
	BCC XSST
	INC DSTADR+1
XSST	LDA #$40
	STA $D40E
	CLI
	LDA #$FF
	RTS

WAIT	LDY #0
WTLP	DEY
	BNE WTLP
	DEX
	BNE WTLP
	RTS

VERIFY	LDX BANKNO
	STA BANKREG,X

	LDY #0
VERLP	LDA (DSTADR),Y
	CMP (SRCADR),Y
	BNE VERERR
	INY
	BNE VERLP
	BEQ VEROK

VERERR	STY DSTADR
	LDA #$FF
	RTS

VEROK	INC SRCADR+1
	INC DSTADR+1
	LDA DSTADR+1
	CMP #>END
	BNE VERIFY
	LDA #0
	RTS

	.MACRO ADDSIG ; address, value
	.IF %0 <> 2
	.ERROR "ADDSIG requires 2 parameters"
	.ELSE
	LDX SIGLEN
	LDA #>%1
	LSR
	LSR
	LSR
	LSR
	LSR
	STA SIGBUFB,X
	LDA #<%1
	STA SIGBUFL,X
	CLC
	LDA #>%1
	AND #$1F
	ADC #>BASE
	STA SIGBUFH,X
	LDA #%2
	STA SIGBUFA,X
	INC SIGLEN
	.ENDIF
	.ENDM

SETSIG	LDA #0
	STA SIGLEN
	LDA TYPE
	CMP #TAMD40
	BEQ SIGA40

; signature AMD 29F010, SST 29EE010, Winbond 29EE011
	ADDSIG $5555, $AA
	ADDSIG $2AAA, $55
	RTS

; signature AMD 29F040 / ST 29F010
SIGA40	ADDSIG $0555, $AA
	ADDSIG $02AA, $55
	RTS

SIGTMP	.BYTE 0

SIGBUFB	.DC 16 0
SIGBUFL	.DC 16 0
SIGBUFH	.DC 16 0
SIGBUFA	.DC 16 0

SIGLEN	.BYTE 0

; set read mode
SIGREAD	JSR SETSIG
	ADDSIG $5555, $F0
	RTS

; erase signature
SIGERAS	JSR SETSIG
	LDA TYPE
	CMP #TAMD40
	BEQ SERA40

; block erase AMD 29F010, SST 29EE010, Winbond 29EE011
SERAMD	ADDSIG $5555, $80
	ADDSIG $5555, $AA
	ADDSIG $2AAA, $55
	RTS

; signature AMD 29F040 / ST 29F010
SERA40	ADDSIG $0555, $80
	ADDSIG $0555, $AA
	ADDSIG $02AA, $55
	RTS

; chip id signature
SIGID	JSR SETSIG
	LDA TYPE
	CMP #TAMD
	BEQ SIDAMD
	CMP #TAMD40
	BEQ SIDA40
	JMP SIDSST

; id AMD 29F010
SIDAMD	ADDSIG $5555, $90
	RTS

; id AMD 29F040 / ST 29F010
SIDA40	ADDSIG $0555, $90
	RTS

; id SST 29EE010, Winbond 29EE011
SIDSST	ADDSIG $5555, $80
	ADDSIG $5555, $AA
	ADDSIG $2AAA, $55
	ADDSIG $5555, $60
	RTS

; program byte/page signature
SIGPRG	JSR SETSIG
	LDA TYPE
	CMP #TAMD40
	BEQ SPRA40

; program AMD 29F010, SST 29EE010, Winbond 29EE011
SPRAMD	ADDSIG $5555, $A0
	RTS

; program AMD 29F040 / ST 29F010
SPRA40	ADDSIG $0555, $A0
	RTS

SENDSIG	LDA #0
	STA SIGTMP
SSLP	LDY SIGTMP
	LDX SIGBUFB,Y
	STA BANKREG,X
	LDA SIGBUFL,Y
	STA TMPADR
	LDA SIGBUFH,Y
	STA TMPADR+1
	LDA SIGBUFA,Y
	LDY #0
	STA (TMPADR),Y
	INC SIGTMP
	LDA SIGTMP
	CMP SIGLEN
	BNE SSLP
	RTS


; new fast programming signature for older chips

PRGOLD
; $5555 = $AA
	LDA #$AA
	STA BANKREG+2
	STA BASE+$1555
; $2AAA = $55
	LDA #$55
	STA BANKREG+1
	STA BASE+$AAA
; $5555 = $A0
	LDA #$A0
	STA BANKREG+2
	STA BASE+$1555

	RTS

; new fast programming signature for newer chips

PRGNEW
; $555 = $AA
	LDA #$AA
	STA BANKREG
	STA BASE+$555
; $2AA = $55
	LDA #$55
	STA BASE+$2AA
; $555 = $A0
	LDA #$A0
	STA BASE+$555

	RTS

	.MACRO RDADR
	STX TMPADR
	STY TMPADR+1
	TAY
	STA BANKREG,Y
	LDY #0
	LDA (TMPADR),Y
	.ENDM

SETREAD	LDX #5
	JSR WAIT
	JSR SIGREAD
	JSR SENDSIG
	LDX #5
	JSR WAIT
	RTS

SETID	LDX #5
	JSR WAIT
	JSR SIGID
	JSR SENDSIG
	LDX #5
	JSR WAIT
	RTS

; erase bank in bankno (0-7)
; 255 = erase complete chip

ERASE	JSR SIGERAS
	JSR SENDSIG
	LDA BANKNO
	CMP #$FF
	BEQ ERCHP

; block erase

	LDA TYPE
	CMP #TSSTWIN
	BNE NESST
; SST/Winbond don't support block erase
	LDA #$FF
	RTS

NESST	LDX BANKNO
	STA BANKREG,X
	LDA #0
	STA DSTADR
	LDA #>BASE
	STA DSTADR+1
	LDY #0
	LDA #$30
	STA (DSTADR),Y
	LDA #$FF
	JMP WTDATA

; complete chip erase

ERCHP	LDA TYPE
	CMP #TAMD40
	BEQ ERCHA40

; AMD 29F010 erase

	STA BANKREG+2
	LDX #$55
	LDY #$15+(>BASE)
	BNE ERCH2

; AMD 29F040 / ST 29F010 erase

ERCHA40	STA BANKREG
	LDX #$55
	LDY #$05+(>BASE)

ERCH2	STX DSTADR
	STY DSTADR+1
	LDY #0
	LDA #$10
	STA (DSTADR),Y

	LDA TYPE
	CMP #TSSTWIN
	BEQ ERCHSST

	LDA #$FF
	JMP WTDATA

ERCHSST	LDA 20
	CLC
	ADC #5
ERWT	CMP 20
	BNE ERWT
	LDA #0
	RTS

; DQ7 polling algorithm

WTDATA	AND #$80
	STA WTBYTE
WTDLP	LDA (DSTADR),Y
	EOR WTBYTE
	BPL WTDOK
	AND #$20
	BEQ WTDLP
	LDA (DSTADR),Y
	EOR WTBYTE
	BPL WTDOK
	JSR SETREAD
	LDY #$FF
	RTS

WTDOK	LDY #$00
	RTS

WTBYTE  .BYTE 0


DETECT	STA MODE8K
	STA MODEROM
	STA MODRES
	STA WREN
	STA ENABLE

	LDA #16
	STA NUMFLSH

.IF .DEF CARTFLOPPY
	LDA #64
.ELSE
	LDA #14
.ENDIF
	STA NUMRAM
	
	LDA BASE8k
	EOR #$FF
	STA DISABLE
	STA BASE
	STA ENABLE
	CMP BASE
	BNE DET1

	PRINT 0,NOFLTXT
	LDA #$FF
	RTS

; initialize flash chip

DET1	LDA #TAMD
	STA TYPE
	JSR SETREAD
	JSR SETID

	STA BANKREG
	LDA BASE
	CMP #$01
	BNE NOAMD
	LDA BASE+1
	CMP #$20
	BNE NOAMD

	PRINT 0, DETAMDT
	LDA #1
	STA NEEDERA
	LDA #2
	STA BLKSIZE
	LDA #0
	RTS

NOAMD	LDA #TAMD40
	STA TYPE
	JSR SETREAD
	JSR SETID
	
	STA BANKREG
	LDA BASE
	CMP #$01
	BNE NOAMD40
	LDA BASE+1
	CMP #$A4
	BNE NOAMD40

	PRINT 0, DETA40T
	LDA #1
	STA NEEDERA
	LDA #64
	STA NUMFLSH
	LDA #8
	STA BLKSIZE
	LDA #0
	RTS

NOAMD40	LDA BASE
	CMP #$20
	BNE NOST
	LDA BASE+1
	CMP #$20
	BNE NOST1

	PRINT 0, DETSTT
	LDA #1
	STA NEEDERA
	LDA #2
	STA BLKSIZE
	LDA #0
	RTS

NOST1	CMP #$E2
	BNE NOST

	PRINT 0, DETS40T
	LDA #1
	STA NEEDERA
	LDA #64
	STA NUMFLSH
	LDA #8
	STA BLKSIZE
	LDA #0
	RTS

NOST	LDA #TSSTWIN
	STA TYPE
	JSR SETREAD
	JSR SETID

	STA BANKREG
	LDA BASE
	CMP #$BF
	BEQ DSST1
	CMP #$DA
	BNE NOSST

	LDA BASE+1
	CMP #$C1
	BNE NOSST

	PRINT 0, DETWINT
	LDA #1
	STA BLKSIZE
	LDA #0
	STA NEEDERA
	RTS

DSST1	LDA BASE+1
	CMP #$07
	BNE NOSST

	PRINT 0, DETSSTT
	LDA #1
	STA BLKSIZE
	LDA #0
	STA NEEDERA
	RTS

NOSST	PRINT 0, UNKFL
	LDA #$FF
	RTS

; check software version

CHKVER	BPUT 0, VERTXTL, VERTXT

	SEC
        LDA NUMFLSH
        SBC #4
        TAX
        STA BANKREG,X

; check for signature "Hias"
	LDA BASE+VEROFS
        CMP #'H
        BNE CHKVER0
	LDA BASE+VEROFS+1
        CMP #'i
        BNE CHKVER0
	LDA BASE+VEROFS+2
        CMP #'a
        BNE CHKVER0
	LDA BASE+VEROFS+3
        CMP #'s
        BNE CHKVER0

        LDX #0
CHKVER1 LDA BASE+VEROFS+4,X
        BEQ CHKVER2
        STA BUF,X
        INX
        CPX #$16
        BNE CHKVER1
CHKVER2	LDA #155
	STA BUF,X

	PRINT 0,BUF
	RTS

CHKVER0 PRINT 0,VERNA
	RTS


PUTCHAR	TAY
	LDA $E407
	PHA
	LDA $E406
	PHA
	TYA
	RTS

GETCHAR	LDA $E425
	PHA
	LDA $E424
	PHA
	RTS

PUTHEX	PHA
	LSR
	LSR
	LSR
	LSR
	TAX
	LDA HEXTAB,X
	JSR PUTCHAR
	PLA
	AND #$0F
	TAX
	LDA HEXTAB,X
	JMP PUTCHAR

POK	PRINT 0, OKT
	RTS

PERROR	PRINT 0, ERRT
	RTS

; print bank number

PBANK	CLC
	LDA BANKNO
	JSR TODEC
	TXA
	CLC
	ADC #'0
	ORA #$80
	STA BANKCH
	TYA
	CLC
	ADC #'0
	ORA #$80
	STA BANKCH+1
	PRINT 0, BNKTXT
	RTS

TODEC	TAY
	LDX #0
TDLP	CPY #10
	BCC TDEND
	INX
	TYA
	SEC
	SBC #10
	TAY
	JMP TDLP
TDEND	RTS

PRDEC	JSR TODEC
	TYA
	PHA
	CPX #0
	BEQ ONEDIG
	TXA
	CLC
	ADC #'0
	JSR PUTCHAR
ONEDIG	PLA
	CLC
	ADC #'0
	JMP PUTCHAR

M106	.BYTE 0
M740	.BYTE 0
MD301	.BYTE 0

; flash type
TYPE	.BYTE 0

; program mode: 
PMODE	.BYTE 0

; need block erase 0=no 1=yes
NEEDERA	.BYTE 0

; number of 8k flash banks
NUMFLSH	.BYTE 0

; number of 8k RAM banks
NUMRAM	.BYTE 0

; Block size in 8k
BLKSIZE	.BYTE 0
BLKMSK1	.BYTE 0
BLKMSK2	.BYTE 0

; bank number limits
MINBANK	.BYTE 0
MAXBANK	.BYTE 0
BMASK	.BYTE 0
LBANK	.BYTE 0

; current bank number
BANKNO	.BYTE 0

; saved bank number (for running cartridge)
BANKNOR	.BYTE 0


HEXTAB	.BYTE "0123456789ABCDEF"
	
TITLE	.BYTE 125,"Turbo Freezer Flash Writer V1.7b",155
	.BYTE "(c) 2005-2011 by Matthias Reichl",155,155
TITLEN	= * - TITLE

MENU	.BYTE 155
	.BYTE "1) Program flash ROM",155
	.BYTE "2) Write flash ROM to file",155
	.BYTE "3) Erase flash ROM",155
	.BYTE "4) Program Freezer RAM",155
	.BYTE "5) Write Freezer RAM to file",155
	.BYTE "6) Erase freezer RAM",155
	.BYTE "7) Start cartridge emulation menu",155,155
	.BYTE "0) Exit program",155
	.BYTE "> "
MENULEN	= * - MENU

REALLYT	.BYTE "Completely erase flash ROM (y/n)? "
REALLYL	= * - REALLYT

REALLYR	.BYTE "Completely erase freezer RAM (y/n)? "
REALLYRL	= * - REALLYR

AGAT	.BYTE 155
	.BYTE "Press any key to continue > "
AGATL	= * - AGAT

AGART	.BYTE 155
	.BYTE "Press any key to continue or 'R'",155
	.BYTE "to run cartridge at R"
RUNSRC	.BYTE "OM bank "
RUNBNK	.BYTE "00 > "
AGATRL	= * - AGART

RUNCTT	.BYTE 155,"Mode (8=8k, 1=16k, O=OSS, S=SDX)? "
RUNCTTL	= * - RUNCTT

STBK1	.BYTE "Starting bank ("
STBKL1	= * - STBK1
STBK2	.BYTE ") > "
STBKL2	= * - STBK2

ENBK1	.BYTE "Ending bank ("
ENBKL1	= * - ENBK1

FNTXT	.BYTE "Filename > "
FNTXTL	= * - FNTXT

EDITOR	.BYTE "E:",155
REMCART	.BYTE "Remove cartridges!",155
DET8K	.BYTE "Flash is in 8k mode",155
DET16K	.BYTE "Flash is in 16k mode",155
NOFLTXT	.BYTE "No flash chip detected",155
UNKFL	.BYTE "Unknown flash, check write jumper",155

DETAMDT	.BYTE "Detected ", $99
	.BYTE +$80,"AMD 29F010"
	.BYTE $19,155

DETA40T	.BYTE "Detected ", $99
	.BYTE +$80,"AMD 29F040"
	.BYTE $19,155

DETSTT	.BYTE "Detected ", $99
	.BYTE +$80,"ST 29F010"
	.BYTE $19,155

DETS40T	.BYTE "Detected ", $99
	.BYTE +$80,"ST 29F040B"
	.BYTE $19,155

DETSSTT	.BYTE "Detected ", $99
	.BYTE +$80,"SST 29EE010"
	.BYTE $19,155

DETWINT	.BYTE "Detected ", $99
	.BYTE +$80,"Winbond 29EE011"
	.BYTE $19,155	

BSIZT	.BYTE "Blocksize: "
BSIZTL	= * - BSIZT

VERTXT	.BYTE 155,"SW Version: "
VERTXTL	= * - VERTXT

VERNA	.BYTE "n/a",155

BNKTXT	.BYTE $99
	.BYTE +$80,"Bank "
BANKCH	.BYTE +$80,"00"
	.BYTE $19,155

BNKRD	.BYTE "reading data: "
BNKRDL	= * - BNKRD

BNKWR	.BYTE "writing data: "
BNKWRL	= * - BNKWR

ERAS	.BYTE "     "
ERAS2	.BYTE "erasing: "
ERASL	= * - ERAS
ERAS2L	= * - ERAS2

PROG	.BYTE " programming: "
PROGL	= * - PROG

VFYT	.BYTE "   verifying: "
VFYTL	= * - VFYT

OKT	.BYTE "OK", 155
ERRT	.BYTE "ERROR", 253, 155

OPENERR	.BYTE "Error opening file!",155

PRGERRT	.BYTE 155, "Error programming address "
PRGERRL	= * - PRGERRT

VFYERRT	.BYTE 155, "Error verifying address "
VFYERRL	= * - VFYERRT

IBANK	.BYTE "Invalid bank number",155
IBANKL	= * -IBANK

IBANKB	.BYTE "Number is not multiple of block size",155
IBANKBL	= * - IBANKB

BANKCOL	.BYTE 0

BUF	.DC 128 0

	* = (*+255) & $FF00
DATA	= *

	* = $2E0
	.WORD ORG

