	.include "LDDBOEQ.M65"
	.include "LDDBOPR.M65"

	* = $1000

FRZCODE	= *

;CHIP	= *
;SGTIA	.DC 32 0          ; GTIA SHADOW
;SPOKEY	.DC 16 0          ; POKEY SHADOW
;SANTIC	.DC 16 0          ; ANTIC SHADOW
;SPORTA	.BYTE 0           ; PORTA OUT
;SPORTB	.BYTE 0           ; PORTB OUT
;SDIRA	.BYTE 0           ; PORTA DIRC
;SDIRB	.BYTE 0           ; PORTB DIRC
;SCTLA	.BYTE 0           ; PORTA CONTROL
;SCTLB	.BYTE 0           ; PORTB CONTROL
;REGA	.BYTE 0           ; CPU ACCU
;REGX	.BYTE 0           ; CPU X
;REGY	.BYTE 0           ; CPU Y
;REGS	.BYTE 0           ; CPU SP
;VCNT	.BYTE 0           ; VCOUNT
;NMIF	.BYTE 0           ; NMI STATUS
;IRQF	.BYTE 0           ; IRQ STATUS
;RSVECL	.BYTE 0           ; RESTART VECTOR
;RSVECH	.BYTE 0

;CHIPLN	= * - CHIP

FRZMAIN	LDA #0
	STA ADR
	STA ADR+1
	STA DSEC+1

; load sector 4 (hardware registers)

	LDA #4
	STA DSEC
	JSR IOPRG
	LDY #CHIPLN-1
CPCHIP	LDA SECBUF,Y
ABS00	STA CHIP,Y
	DEY
	BPL CPCHIP

FRZLOOP	JSR IOPRG

STORE	LDA ADR
	STA DEST
	LDA ADR+1
	STA DEST+1
	CMP #5
	BCS ABS02

; store first 4 pages in shadow buffer
	CLC
	LDA ADR
	ADC #<SHBUF
	STA DEST
	LDA ADR+1
ABS01	ADC #>SHBUF
	STA DEST+1
	BNE STOROK
	
; check if destination address would overwrite loader code
; if yes, skip this block

ABS02	CMP #>FRZCODE
	BCC STOROK
ABS02A	CMP #(>FRZEND)
	BEQ NEXT
	BCC NEXT
STOROK	LDY #0
	LDX DBYT
MOVLP	LDA SECBUF,Y
	STA (DEST),Y
	INY
	DEX
	BNE MOVLP

NEXT	ADVADR

	LDA ADR
	BNE FRZLOOP
	LDA ADR+1
	BEQ ENDLD
	CMP #$D0
	BNE FRZLOOP
	LDA #$D8
	STA ADR+1
	BNE FRZLOOP

; copy shadowed pages 0-4

ENDLD	LDX #0
ABS03	LDA SHBUF,X
	STA 0,X
ABS04	LDA SHBUF+$0100,X
	STA $0100,X
ABS05	LDA SHBUF+$0200,X
	STA $0200,X
ABS06	LDA SHBUF+$0300,X
	STA $0300,X
ABS07	LDA SHBUF+$0400,X
	STA $0400,X
	DEX
	BNE ABS03

; push registers for last restart phase

ABS08	LDX REGS
	TXS
ABS09	LDA REGA
	PHA
ABS10	LDA SANTIC+14
	PHA
ABS11	LDA VCNT
	SEC
	SBC #1
	PHA
ABS11A	LDA SANTIC
	PHA
ABS12	LDA SCTLB
	PHA
ABS13	LDA SPORTB
	PHA
ABS14	LDA SDIRB
	PHA

; push restart code onto stack

	LDX #RESLEN-1
ABS15	LDA RESTART,X
	PHA
	DEX
	BPL ABS15
	TSX
	INX
ABS16	STX GO+1

	SEC
ABS17	LDA REGS
	SBC #7
	TAX
	TXS

; set hardware registers, except DMACTL and NMIEN
	LDX #$0F
SETHW	CPX #$0E
	BEQ ABS19
	CPX #$00
	BEQ ABS19
ABS18	LDA SANTIC,X
	STA $D400,X
ABS19	LDA SGTIA,X
	STA $D000,X
ABS20	LDA SGTIA+$10,X
	STA $D010,X
ABS21	LDA SPOKEY,X
	STA $D200,X
	DEX
	BPL SETHW
	LDA #$38
	STA $D302
ABS22	LDA SDIRA
	STA $D300
	LDA #$3C
	STA $D302
ABS23	LDA SPORTA
	STA $D300
ABS24	LDA SCTLA
	STA $D302
ABS25	LDX REGX
ABS26	LDY REGY
	LDA #3
VWAIT	CMP $D40B
	BNE VWAIT
	STA $D40A

GO	JMP $0100

RESTART	LDA #$38
	STA $D303
	PLA
	STA $D301
	LDA #$3C
	STA $D303
	PLA
	STA $D301
	PLA
	STA $D303
	PLA
	STA $D40A
	STA $D400
	PLA
WLP1	CMP $D40B
	BNE WLP1
	PLA
	STA $D40E
	PLA
	RTI
RESLEN	= * - RESTART

CHIP	= *
SGTIA	* = *+32          ; GTIA SHADOW
SPOKEY	* = *+16          ; POKEY SHADOW
SANTIC	* = *+16          ; ANTIC SHADOW
SPORTA	* = *+1           ; PORTA OUT
SPORTB	* = *+1           ; PORTB OUT
SDIRA	* = *+1           ; PORTA DIRC
SDIRB	* = *+1           ; PORTB DIRC
SCTLA	* = *+1           ; PORTA CONTROL
SCTLB	* = *+1           ; PORTB CONTROL
REGA	* = *+1           ; CPU ACCU
REGX	* = *+1           ; CPU X
REGY	* = *+1           ; CPU Y
REGS	* = *+1           ; CPU SP
VCNT	* = *+1           ; VCOUNT
NMIF	* = *+1           ; NMI STATUS
IRQF	* = *+1           ; IRQ STATUS
RSVECL	* = *+1           ; RESTART VECTOR
RSVECH	* = *+1

CHIPLN	= * - CHIP

SHBUF	= *

FRZEND	= * + $0500

	* = CHIP

; relocate loader

RELOC	LDX #0
	LDY #0
RELLP	INY
	LDA (DEST),Y
	CMP #$FF
	BEQ ABS27
	DEY
	LDA (DEST),Y
	STA ADR
	INY
	LDA (DEST),Y
	SEC
	SBC #>FRZCODE
	CLC
	ADC RELPG
	STA ADR+1
	SEC
	LDA (ADR,X)
	SBC #>FRZCODE
	CLC
	ADC RELPG
	STA (ADR,X)
	INY
	BNE RELLP
ABS27	JMP FRZMAIN

RELTAB  .WORD ABS00+2, ABS01+1, ABS02+1, ABS02A+1
	.WORD ABS03+2, ABS04+2, ABS05+2, ABS06+2
	.WORD ABS07+2, ABS08+2, ABS09+2, ABS10+2
	.WORD ABS11+2, ABS11A+2, ABS12+2, ABS13+2, ABS14+2
	.WORD ABS15+2, ABS16+2, ABS17+2, ABS18+2
	.WORD ABS19+2, ABS20+2, ABS21+2, ABS22+2
	.WORD ABS23+2, ABS24+2, ABS25+2, ABS26+2
	.WORD ABS27+2
	.WORD $FFFF

RELTEND	= *

        .IF (*&255)<>0
        .DC (256-(*&255)) 0
        .ENDIF

FRZ2END	= *
