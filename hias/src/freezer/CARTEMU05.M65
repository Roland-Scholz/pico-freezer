; cartridge emulation commands

COMK	CMP #'O-$20	; on/off/oss
	BNE COMK1
	CPX #'N-$20
	BNE COMKO1

	LDA #KTXON	; on
	JSR COMKTXT
	STA ENABLE
COMKO0	JMP DEBU3
	
COMKO1	CPX #'F-$20
	BNE COMKO2

	LDA #KTXOFF	; off
	JSR COMKTXT
	STA DISABLE
	JMP DEBU3

COMKO2	CPX #'S-$20	; oss bank
	BNE COMKO0
	INC NCOUNT
	INC NCOUNT
	JSR EATSPC

	LDA #'O		; oss off
	JSR MATCH
	BCC COMKO3

	LDA #KTXOSS
	JSR COMKTXT
	LDA #KTXTOFF
	JSR COMKTX0

	STA OSSOFF
	JMP DEBU3

COMKO3	LDA #0
	JSR MATCH
	BCC COMKO0

	CMP #0
	BEQ COMKO0
	CMP #4
	BCS COMKO0

	PHA
	TAX
	DEX
	LDY OSSOFS,X
	STA $D500,Y

	LDA #KTXOSS
	JSR COMKTXT
	PLA
	CLC
	ADC #'0
	JSR PUTBYT
	JMP DEBU3

; bank select registers for OSS cartridges
OSSOFS	.BYTE <OSSBNK1, <OSSBNK2, <OSSBNK3

COMK1	CMP #'R-$20	; ram/rom/reset
	BNE COMK2
	CPX #'A-$20
	BNE COMKR1

	LDA #KTXRAM	; ram
	JSR COMKTXT
	STA MODERAM
COMKR0	JMP DEBU3

COMKR1	CPX #'O-$20
	BNE COMKR2

	LDA #KTXROM	; rom
	JSR COMKTXT
	STA MODEROM
	JMP DEBU3

COMKR2	CPX #'E-$20
	BNE COMKR0

	LDA #KTXRES	; reset
	JSR COMKTXT
	STA MODRES
	JMP DEBU3

COMK2	CMP #'K-$20	; keep
	BNE COMK3

	LDA #KTXKEEP	; rom
	JSR COMKTXT
	STA MODKEEP
	JMP DEBU3

COMK3	CMP #'M-$20	; mode
	BEQ COMKM0
	JMP COMK4
COMKM0	INC NCOUNT
	JSR EATSPC

	LDA #'8		; mode 8k
	JSR MATCH
	BCC COMKM1

	LDA #KTXMODE
	JSR COMKTXT
	LDA #'8
	JSR PUTBYT
	LDA #'k
	JSR PUTBYT

	STA MODE8K
	JMP DEBU3

COMKM1	LDA #'1		; mode 16k
	JSR MATCH
	BCC COMKM2

	LDA #KTXMODE
	JSR COMKTXT
	LDA #'1
	JSR PUTBYT
	LDA #'6
	JSR PUTBYT
	LDA #'k
	JSR PUTBYT

	STA MODE16K
	JMP DEBU3

COMKM2	LDA #'O		; mode oss
	JSR MATCH
	BCC COMKM3

	LDA #KTXMODE
	JSR COMKTXT
	LDA #'O
	JSR PUTBYT
	LDA #'S
	JSR PUTBYT
	LDA #'S
	JSR PUTBYT
		
	STA MODEOSS
	STA OSSBNK1
	JMP DEBU3

COMKM3	LDA #'S		; mode sdx
	JSR MATCH
	BCC COMKM4

	LDA #KTXMODE
	JSR COMKTXT
	LDA #'S
	JSR PUTBYT
	LDA #'D
	JSR PUTBYT
	LDA #'X
	JSR PUTBYT
		
	STA MODESDX
	STA SDXBANK

COMKM4	JMP DEBU3

COMK4	CMP #'B-$20	; bank
	BNE COMK5

	INC NCOUNT
	LDA #0
	JSR MATCH
	BCC COMKB0
	CMP #$40
	BCS COMKB0
	PHA
	TAX
	STA BANKREG,X

	LDA #KTXBANK
	JSR COMKTXT

	PLA
	JSR PRTBYT
COMKB0	JMP DEBU3

COMK5	CMP #'S-$20	; sdx bank
	BNE COMK6
	CPX #'D-$20
	BNE COMKS0

	INC NCOUNT
	INC NCOUNT
	JSR EATSPC

	LDA #'O		; sdx off
	JSR MATCH
	BCC COMKS1

	LDA #KTXSDX
	JSR COMKTXT
	LDA #KTXTOFF
	JSR COMKTX0

	STA SDXBANK+8
COMKS0	JMP DEBU3

COMKS1	LDA #0
	JSR MATCH
	BCC COMKS0

	CMP #8
	BCS COMKS0
	PHA
	TAX
	STA SDXBANK,X

	LDA #KTXSDX
	JSR COMKTXT

	PLA
	CLC
	ADC #'0
	JSR PUTBYT
	JMP DEBU3

COMK6	CMP #'D-$20	; default (on, 8k, bank 62, ROM, keep on)
	BNE COMK7
	CPX #'E-$20
	BNE COMKD0
	
	LDA #KTXDEF
	JSR COMKTXT

	STA WRDIS
	STA MODKEEP
	STA ENABLE
	STA MODEROM
	STA MODE8K
	STA SELBANK
	
COMKD0	JMP DEBU3

COMK7	CMP #'W-$20	; write enable/disable
	BNE COMKW0
	CPX #'E-$20
	BNE COMKW1

	LDA #KTXWE
	JSR COMKTXT

	STA WREN
COMKW0	JMP DEBU3

COMKW1	CPX #'P-$20
	BNE COMKW0

	LDA #KTXWP
	JSR COMKTXT

	STA WRDIS
	JMP DEBU3

; print cartemu texts

COMKTXT	PHA
	JSR SCROLL
	LDA #$20
	JSR PUTBYT
	PLA
COMKTX0	TAX
COMKTX1	LDA KTSTART,X
	CMP #$FF
	BEQ COMKTX2
	JSR PUTBYT
	INX
	BNE COMKTX1
COMKTX2	RTS

; cartemu texts for monitor screen
KTSTART
KTXON	= * - KTSTART
	.BYTE "KON",$FF

KTXOFF	= * - KTSTART
	.BYTE "KOFF",$FF

KTXRAM	= * - KTSTART
	.BYTE "KRAM",$FF

KTXROM	= * - KTSTART
	.BYTE "KROM",$FF

KTXRES	= * - KTSTART
	.BYTE "KRESET",$FF

KTXKEEP	= * - KTSTART
	.BYTE "KKEEP",$FF

KTXMODE	= * - KTSTART
	.BYTE "KM ",$FF

KTXBANK	= * - KTSTART
	.BYTE "KB ",$FF

KTXOSS	= * - KTSTART
	.BYTE "KOS ",$FF

KTXSDX	= * - KTSTART
	.BYTE "KSD ",$FF

KTXDEF	= * - KTSTART
	.BYTE "KDEFAULT",$FF

KTXWE	= * - KTSTART
	.BYTE "KWE - write enable",$FF

KTXWP	= * - KTSTART
	.BYTE "KWP - write protect",$FF

KTXTOFF	= * - KTSTART
	.BYTE "OFF",$FF

