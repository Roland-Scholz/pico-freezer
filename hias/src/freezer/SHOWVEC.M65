; display OS vectors from page 2

SHOWVEC LDA #<SHVTAB
	STA TPNT2
	LDA #>SHVTAB
	STA TPNT2+1

; flag: 0 means first column, $80 means second column
	LDA #0
	STA TPNT

SHVEC1	LDY #0
	LDA (TPNT2),Y
	STA RPNT
	INY
	AND (TPNT2),Y
	CMP #$FF	; $FFFF means skipp
	BNE SHVEC2
	LDA #2
	BNE SHVEC91

SHVEC2	LDA (TPNT2),Y
	STA RPNT+1

	LDA #2
	JSR BLKGET	; copy 2 bytes from VECTOR into BLKBUF

	BIT TPNT
	BMI SHVEC3	; odd index, just print a space

	JSR SCROLL	; even index, begin new line
	LDY #1
	BNE SHVEC4

SHVEC3	LDY #3
SHVEC4	LDA #32
	JSR PUTBYT
	DEY
	BNE SHVEC4

; print vector name (6 chars each)
	LDY #2
SHVEC5	LDA (TPNT2),Y
	JSR PUTBYT
	INY
	CPY #8
	BNE SHVEC5

; print vector address
SHVEC6
	LDA #32
	JSR PUTBYT
;	LDA #'(
;	JSR PUTBYT
	LDA RPNT+1
	JSR PRTBYT
	LDA RPNT
	JSR PRTBYT
;	LDA #')
;	JSR PUTBYT
	LDA #':
	JSR PUTBYT
	LDA #32
	JSR PUTBYT
	
; print content of vector
	LDA BLKBUF+1
	JSR PRTBYT
	LDA BLKBUF
	JSR PRTBYT

; advance offset pointer

SHVEC90	LDA #8

SHVEC91 CLC
	ADC TPNT2
	STA TPNT2
	BCC SHVEC92
	INC TPNT2+1
SHVEC92	LDA TPNT
	EOR #$80
	STA TPNT
	LDA TPNT2
	CMP #<SHVEND
	BNE SHVEC1
	LDA TPNT2+1
	CMP #>SHVEND
	BNE SHVEC1
	JMP DEBU3

; offset and name of vectors

SHVTAB	
	.WORD $000C
	.BYTE "DOSINI"
	.WORD $0002
	.BYTE "CASINI"
	
	.WORD $000A
	.BYTE "DOSVEC"
	.WORD $FFFF

	.WORD $0202
	.BYTE "VPRCED"
	.WORD $0204
	.BYTE "VINTER"

	.WORD $0206
	.BYTE "VBREAK"
	.WORD $0208
	.BYTE "VKEYBD"

	.WORD $0236
	.BYTE "BRKKY "
	.WORD $020A
	.BYTE "VSERIN"

	.WORD $020C
	.BYTE "VSEROR"
	.WORD $020E
	.BYTE "VSEROC"

	.WORD $0216
	.BYTE "VIMIRQ"
	.WORD $FFFF

	.WORD $0218
	.BYTE "CDTMV1"
	.WORD $0226
	.BYTE "CDTMA1"

	.WORD $021A
	.BYTE "CDTMV2"
	.WORD $0228
	.BYTE "CDTMA2"

	.WORD $021C
	.BYTE "CDTMV3"
	.WORD $0210
	.BYTE "VTIMR1"

	.WORD $021E
	.BYTE "CDTMV4"
	.WORD $0212
	.BYTE "VTIMR2"

	.WORD $0220
	.BYTE "CDTMV5"
	.WORD $0214
	.BYTE "VTIMR4"

	.WORD $0222
	.BYTE "VVBLKI"
	.WORD $0200
	.BYTE "VDSLST"

	.WORD $0224
	.BYTE "VVBLKD"	
	.WORD $0230
	.BYTE "SDLSTL"

	.WORD $02E7
	.BYTE "MEMLO "
	.WORD $02E0
	.BYTE "RUNAD "

	.WORD $02E5
	.BYTE "MEMTOP"
	.WORD $02E2
	.BYTE "INITAD"

SHVEND	= *

