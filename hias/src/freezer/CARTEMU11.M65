; cartridge emulation commands

COMK	CMP #'B-$20
	BNE COMK1
	CPX #'E-$20
	BNE COMKB2

	INC NCOUNT
	INC NCOUNT
	LDA #'<
	JSR MATCH
	BCC COMKBX

	LDA #'0
	JSR MATCH
	BCC COMKB1
	LDA #0
	STA CE_ENABLE
	BEQ COMKBX

COMKB1	LDA #'1
	JSR MATCH
	BCC COMKBX1
	LDA #1
	STA CE_ENABLE
	BNE COMKBX

COMKB2	CPX #'<-$20
	BNE COMKBX

	INC NCOUNT
	INC NCOUNT
	LDA #0
	JSR MATCH
	BCC COMKBX1
	
	AND #$7F
	STA CE_BANK

COMKBX	JSR PKBANK
COMKBX1	JMP DEBU3

COMK1	CMP #'R-$20
	BNE COMK2
	CPX #'E-$20
	BNE COMKR2

	INC NCOUNT
	INC NCOUNT
	LDA #'<
	JSR MATCH
	BCC COMKRX

	LDA #'0
	JSR MATCH
	BCC COMKR1
	LDA #0
	STA CE_RENABLE
	BEQ COMKRX

COMKR1	LDA #'1
	JSR MATCH
	BCC COMKRX1
	LDA #1
	STA CE_ENABLE
	BNE COMKRX

COMKR2	CPX #'<-$20
	BNE COMKRX

	INC NCOUNT
	INC NCOUNT
	LDA #0
	JSR MATCH
	BCC COMKRX1
	
	AND #$3F
	STA CE_RBANK

COMKRX	JSR PKRBANK
COMKRX1	JMP DEBU3

COMK2	CMP #'O-$20
	BNE COMK3
	LDA CE_MODE
	CMP #CE_MODE_OSS
	BNE COMKOX1
	CPX #'<-$20
	BNE COMKOX1

	INC NCOUNT
	INC NCOUNT
	LDA #0
	JSR MATCH
	BCC COMKOX1
	
	CMP #4
	BCS COMKOX1
	PHA
	TAX
	LDA KOSSB,X
	TAX
	STA $D500,X
	JSR SCROLL
	DPTEXT PKTSOSS
	PLA
	ORA #$30
	JSR PUTBYT
COMKOX1	JMP DEBU3

COMK3	CMP #'X-$20
	BEQ COMKX0
	JMP COMK4
COMKX0	CPX #'B-$20
	BNE COMKX1

	LDA CE_SDX
	AND #3
	CMP #CE_SDX_OFF
	BNE COMKX02
COMKX01	JMP COMKXX1

COMKX02	INC NCOUNT
	INC NCOUNT
	LDA #'<
	JSR MATCH
	BCS COMKX04
COMKX03	JMP COMKXX
COMKX04	LDA #0
	JSR MATCH
	BCC COMKX01

	AND #$3F
	STA TPNT2
	LDA SDXBANKCTL
	AND #$C0
	ORA TPNT2
	STA SDXBANKCTL
	JMP COMKXX

COMKX1	
	CPX #'M-$20
	BNE COMKX4

	LDA CE_SDX
	AND #3
	CMP #CE_SDX_OFF
	BEQ COMKX01

	INC NCOUNT
	INC NCOUNT
	LDA #'<
	JSR MATCH
	BCC COMKXX
	LDA #'0
	JSR MATCH
	BCC COMKX2

	LDA SDXBANKCTL
	AND #$3F
	ORA #$C0
	STA SDXBANKCTL
	JMP COMKXX
COMKX2
	LDA #'1
	JSR MATCH
	BCC COMKX3

	LDA SDXBANKCTL
	AND #$3F
	STA SDXBANKCTL
	JMP COMKXX

COMKX3	LDA #'C
	JSR MATCH
	BCC COMKXX1

	LDA SDXBANKCTL
	AND #$3F
	ORA #$80
	STA SDXBANKCTL
	JMP COMKXX

COMKX4	CPX #'<-$20
	BNE COMKXX

	INC NCOUNT
	INC NCOUNT
	LDA #'0
	JSR MATCH
	BCC COMKX5
	LDA #CE_SDX_OFF
	STA CE_SDX
	JMP COMKXX
COMKX5	LDA #'1
	JSR MATCH
	BCC COMKX6
	LDA #CE_SDX_ROM1
	STA CE_SDX
	JMP COMKXX
COMKX6	LDA #'2
	JSR MATCH
	BCC COMKX7
	LDA #CE_SDX_ROM2
	STA CE_SDX
	JMP COMKXX
COMKX7	LDA #'R
	JSR MATCH
	BCC COMKXX1
	LDA #CE_SDX_RAM
	STA CE_SDX

COMKXX	JSR PKSDX
COMKXX1	JMP DEBU3

COMK4	CMP #'M-$20
	BNE COMK5
	CPX #'<-$20
	BNE COMKMX
	INC NCOUNT
	INC NCOUNT
	LDA #'0
	JSR MATCH
	BCC COMKM1

	LDA #CE_MODE_OFF
	STA CE_MODE
	JMP COMKMX

COMKM1	LDA #'1
	JSR MATCH
	BCC COMKM2

	LDA #CE_MODE_16K
	STA CE_MODE
	JMP COMKMX

COMKM2	LDA #'O
	JSR MATCH
	BCC COMKM3

	LDA #CE_MODE_OSS
	STA CE_MODE
	JMP COMKMX

COMKM3	LDA #'A
	JSR MATCH
	BCC COMKM4

	LDA #CE_MODE_AMAX
	STA CE_MODE
	JMP COMKMX

COMKM4	LDA #'8
	JSR MATCH
	BCC COMKMX1

	LDA #'R
	JSR MATCH
	BCC COMKM5

	LDA #CE_MODE_8K_RAM
	STA CE_MODE
	JMP COMKMX

COMKM5	LDA #'O
	JSR MATCH
	BCC COMKM6

	LDA #CE_MODE_8K_OLD
	STA CE_MODE
	JMP COMKMX

COMKM6	LDA #CE_MODE_8K
	STA CE_MODE

COMKMX	JSR PKMODE
COMKMX1	JMP DEBU3

COMK5	CMP #'W-$20
	BNE COMK6
	CPX #'<-$20
	BNE COMKWX

	INC NCOUNT
	INC NCOUNT
	LDA #'0
	JSR MATCH
	BCC COMKW1

	LDA CE_CFG
	AND #CE_CFG_WE_MSK
	STA CE_CFG
	JMP COMKWX

COMKW1	LDA #'1
	JSR MATCH
	BCC COMKWX1
	LDA CE_CFG
	ORA #CE_CFG_WE
	STA CE_CFG

COMKWX	JSR PKSTAT
COMKWX1	JMP DEBU3

COMK6	CMP #'N-$20
	BNE COMK7
	CPX #'<-$20
	BNE COMKNX

	INC NCOUNT
	INC NCOUNT
	LDA #'0
	JSR MATCH
	BCC COMKN1

	LDA CE_CFG
	AND #CE_CFG_MENU_MSK
	STA CE_CFG
	JMP COMKNX

COMKN1	LDA #'1
	JSR MATCH
	BCC COMKNX1
	LDA CE_CFG
	ORA #CE_CFG_MENU
	STA CE_CFG

COMKNX	JSR PKSTAT
COMKNX1	JMP DEBU3

COMK7	CMP #'S-$20
	BNE COMK8
	CPX #'<-$20
	BNE COMKSX

	INC NCOUNT
	INC NCOUNT
	LDA #'0
	JSR MATCH
	BCC COMKS1

	LDA CE_CFG
	AND #CE_CFG_SRC_MSK
	STA CE_CFG
	JMP COMKSX

COMKS1	LDA #'1
	JSR MATCH
	BCC COMKSX1
	LDA CE_CFG
	ORA #CE_CFG_SRC
	STA CE_CFG

COMKSX	JSR PKSTAT
COMKSX1	JMP DEBU3


COMK8	CMP #'<-$20
	BNE COMK9

	INC NCOUNT
	LDA #'0
	JSR MATCH
	BCC COMK81

	LDA #CE_SDX_ROM1
	STA CE_SDX
	LDA #0
	STA SDXBANKCTL
	LDA #CE_SDX_OFF
	STA CE_SDX
	LDA #CE_MODE_OSS
	STA CE_MODE
	STA OSSBANK1
	LDA #CE_MODE_OFF
	STA CE_MODE

	LDA #0
	STA CE_BANK
	STA CE_ENABLE
	STA CE_RBANK
	STA CE_RENABLE
	STA CE_CFG
	JMP COMKPRT

COMK81	JMP DEBU3

COMK9

COMKPRT
; print full cartemu status
	JSR PKMODE
	JSR PKBANK
	JSR PKRBANK
	JSR PKSTAT
	JSR PKSDX
	JMP DEBU3

; print mode
PKMODE	JSR SCROLL
	DPTEXT PKTMODE
	LDA CE_MODE
	CMP #CE_MODE_8K
	BNE PKMODE1
	DPTEXT PKTM8K
	RTS
PKMODE1
	CMP #CE_MODE_8K_RAM
	BNE PKMODE2
	DPTEXT PKTM8KR
	RTS

PKMODE2
	CMP #CE_MODE_8K_OLD
	BNE PKMODE3
	DPTEXT PKTM8KO
	RTS

PKMODE3
	CMP #CE_MODE_16K
	BNE PKMODE4
	DPTEXT PKTM16K
	RTS

PKMODE4
	CMP #CE_MODE_OSS
	BNE PKMODE5
	DPTEXT PKTMOSS
	RTS

PKMODE5
	CMP #CE_MODE_AMAX
	BNE PKMODE6
	DPTEXT PKTMAMX
	RTS
PKMODE6
	LDA #0
	JMP PKONOFF

; print main bank + enable
PKBANK	JSR SCROLL
	DPTEXT PKTBNK
	LDA CE_BANK
	AND #$7F
	JSR PRTBYT
	DPSPACE 1

	LDA CE_ENABLE
	AND #1
	JSR PKONOFF
	RTS

; print ram bank + enable
PKRBANK	JSR SCROLL
	DPTEXT PKTRBNK
	LDA CE_RBANK
	AND #$7F
	JSR PRTBYT
	DPSPACE 1

	LDA CE_RENABLE
	AND #1
	JSR PKONOFF
	RTS

; print SDX config
PKSDX	JSR SCROLL
	DPTEXT PKTSDX

	LDA CE_SDX
	AND #3
	CMP #CE_SDX_OFF
	BNE PKSDX1
	LDA #0
	JMP PKONOFF
PKSDX1	CMP #CE_SDX_RAM
	BNE PKSDX2
	DPTEXT PKTRAM
	DPSPACE 4
	JMP PKSDX4
PKSDX2	CMP #CE_SDX_ROM1
	BNE PKSDX3
	DPTEXT PKTSR1
	JMP PKSDX4
PKSDX3	DPTEXT PKTSR2

PKSDX4	DPTEXT PKTMODE
	LDA SDXBANKCTL
	PHA
	ASL
	BCS PKSDX6	; SDX off
	LDA #1
PKSDX41	JSR PKONOFF
	DPSPACE 2
	JMP PKSDX8

PKSDX6	ASL
	BCC PKSDX7	; ext cart on
	LDA #0
	BEQ PKSDX41

PKSDX7	DPTEXT PKTSCAR

PKSDX8	DPTEXT PKTBANK
	PLA
	AND #$3F
	JMP PRTBYT

PKSTAT	JSR SCROLL
	DPTEXT PKTSRC
	LDA CE_CFG
	PHA
	AND #CE_CFG_SRC
	BEQ PKSTAT1
	DPTEXT PKTRAM
	JMP PKSTAT2
PKSTAT1
	DPTEXT PKTROM
PKSTAT2
	DPSPACE 5
	DPTEXT PKTWRIT
	PLA
	PHA
	AND #CE_CFG_WE
	JSR PKONOFF
	DPTEXT PKTMENU
	PLA
	AND #CE_CFG_MENU

; print on/off
PKONOFF	CMP #0
	BEQ PKOFF
	DPTEXT PKTON
	RTS
PKOFF	DPTEXT PKTOFF
	RTS

PKTMODE	.BYTE " MODE ",$FF
PKTM8K	.BYTE "8K",$FF
PKTM8KR	.BYTE "8K+RAM",$FF
PKTM8KO	.BYTE "8K OLD/2005",$FF
PKTM16K	.BYTE "16K",$FF
PKTMOSS	.BYTE "OSS",$FF
PKTMAMX	.BYTE "ATARIMAX",$FF

PKTBNK	.BYTE " MAIN BANK ",$FF
PKTRBNK	.BYTE "  RAM BANK ",$FF

PKTON	.BYTE "ON ", $FF
PKTOFF	.BYTE "OFF", $FF
PKTBANK	.BYTE " BANK ",$FF

PKTSDX	.BYTE "  SDX ",$FF
PKTSR1	.BYTE "ROM 0  ",$FF
PKTSR2	.BYTE "ROM 64 ",$FF
PKTSCAR	.BYTE "CART ",$FF
PKTRAM	.BYTE "RAM",$FF
PKTROM	.BYTE "ROM",$FF

PKTSRC	.BYTE "  SRC ",$FF
PKTWRIT	.BYTE "WRITE ",$FF
PKTMENU	.BYTE "  MENU ",$FF

PKTSOSS	.BYTE " KO<",$FF

KOSSB	.BYTE <OSSOFF, <OSSBANK1, <OSSBANK2, <OSSBANK3

