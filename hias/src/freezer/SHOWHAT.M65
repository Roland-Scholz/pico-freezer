; print HATABS table

SHOWHAT LDA #3
        STA RPNT+1
        LDA #0
        STA RPNT
        LDA #$40
        JSR BLKGET	; copy $0300-$033F to BLKBUF

	LDA #$1A
	STA TPNT

SHHAT1	JSR SCROLL

; print address
	LDA #32
	JSR PUTBYT
	LDA #3
	JSR PRTBYT
	LDA TPNT
	JSR PRTBYT
	LDA #32
	JSR PUTBYT
	LDA #32
	JSR PUTBYT

; print memory bytes

	LDY #3
	LDX TPNT
SHHAT2	LDA BLKBUF,X
	JSR PRTBYT
	LDA #32
	JSR PUTBYT
	INX
	DEY
	BNE SHHAT2

	LDA #32
	JSR PUTBYT

	LDX TPNT
	LDA BLKBUF,X
	BNE SHHAT3

; empty entry
	LDA #'-
	JSR PUTBYT
	LDA #'-
	JSR PUTBYT
	JMP SHHAT4

SHHAT3	JSR PUTBYT
	LDA #':
	JSR PUTBYT

SHHAT4	LDA #32
	JSR PUTBYT
	LDA BLKBUF+2,X
	JSR PRTBYT
	LDA BLKBUF+1,X
	JSR PRTBYT

	CLC
	LDA TPNT
	ADC #3
	STA TPNT
	CMP #$3B
	BNE SHHAT1
	JMP DEBU3
