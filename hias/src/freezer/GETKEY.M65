;WAIT FOR KEY, CODE TO A

GETKEYH LDA #1            ; also check for HELP key
      BNE GETKEH
GETKEY LDA #0
GETKEH STA HELPFLG
GETKEY0 LDA #3
      STA SSKCTL
      STA SKCTL
      LDA #$40
      STA NMIEN
GETKE1 LDA KEYTIM         ; WAIT FOR KEY
      CMP RTCLOK+2        ; RELEASED OR TIMER
      BNE GETKE2
      ADC #4
      STA KEYTIM
      JMP GETKE4
GETKE2 LDA SKSTAT
      AND #4
      BEQ GETKE1

GETKE3 LDA RTCLOK+2       ; WAIT FOR KEY
      CLC 
      ADC #25
      STA KEYTIM
      LDA SKSTAT
      AND #4
      BNE GETKE3

GETKE4 LDA #0
      STA NMIEN
      LDY #$7F            ; CLICK
GETKE5 STY CONSOL
      STY WSYNC
      DEY 
      BPL GETKE5

      LDA KBCODE          ; DETERMINE KEY CODE
      CMP #$C0
      BCC GETKE6
      AND #$BF            ; CONTROL OVERRIDES SHIFT

GETKE6 TAX 
      CMP #$11            ; help
      BEQ GETKE91
      CMP #$3C            ; caps
      BNE GETKE61
      LDA KBCAPS
      EOR #$40
      STA KBCAPS
      JMP GETKEY0
GETKE61 CMP #$7C          ; shift-caps
      BNE GETKE62
      LDA KBCAPS
      AND #$B0
      STA KBCAPS
      JMP GETKEY0
GETKE62 
      CMP #$A0
      BNE GETKE63
      LDA #0
      BEQ GETKE65

GETKE63 AND #$3F
      CMP #$27
      BNE GETKE64
      LDA KBCAPS
      EOR #$80
      STA KBCAPS
      JMP GETKEY0

GETKE64 LDA KEYCOD,X
      BNE GETKE65
      JMP GETKEY0
GETKE65 BMI GETKE9          ; don't change return
      CMP #$61
      BCC GETKE7
      CMP #$7B
      BCS GETKE7
      BIT KBCAPS          ; check for caps
      BVS GETKE7
      AND #$DF
; set inverse - but only for 0-1a,20-7c
GETKE7 CMP #$1B
      BCC GETKE8
      CMP #$20
      BCC GETKE9
      CMP #$7D
      BCS GETKE9
GETKE8 BIT KBCAPS
      BPL GETKE9
      ORA #$80
GETKE9 RTS

; help key pressed - check if we should handle it
GETKE91 LDA HELPFLG
      BNE GETKE92
      JMP GETKEY0
GETKE92 LDA #$80
      STA HELPFLG
      RTS

KEYCOD .BYTE $6C,$6A,$3B,0,0,$6B,$2B,$2A
      .BYTE $6F,0,$70,$75,$9B,$69,$2D,$3D
      .BYTE $76,0,$63,0,0,$62,$78,$7A
      .BYTE $34,0,$33,$36,$1B,$35,$32,$31
      .BYTE $2C,$20,$2E,$6E,0,$6D,$2F,0
      .BYTE $72,0,$65,$79,0,$74,$77,$71
      .BYTE $39,0,$30,$37,$7E,$38,$3C,$3E
      .BYTE $66,$68,$64,0,0,$67,$73,$61

      .BYTE $4C,$4A,$3A,0,0,$4B,$5C,$5E
      .BYTE $4F,0,$50,$55,$9B,$49,$5F,$7C
      .BYTE $56,0,$43,0,0,$42,$58,$5A
      .BYTE $24,0,$23,$26,$1B,$25,$22,$21
      .BYTE $5B,$20,$5D,$4E,$00,$4D,$3F,0
      .BYTE $52,0,$45,$59,0,$54,$57,$51
      .BYTE $28,0,$29,$27,$9C,$40,$7D,$9D
      .BYTE $46,$48,$44,0,0,$47,$53,$41

      .BYTE $0C,$0A,$7B,0,0,$0B,$1E,$1F
      .BYTE $0F,0,$10,$15,$9B,$09,$1C,$1D
      .BYTE $16,0,$03,0,0,$02,$18,$1A
      .BYTE 0,0,0,0,0,0,0,0
      .BYTE 0,$20,$60,$0E,0,$0D,0,0
      .BYTE $12,0,$05,$19,0,$14,$17,$11
      .BYTE 0,0,0,0,$FE,0,$7D,$FF
      .BYTE $06,$08,$04,0,0,$07,$13,$01

