; general memory access functions:
; read/write bytes/blocks of Atari memory

; block operations

; common subroutines for copying a block:
; A=byte count (0=256 bytes), RPNT=block address
; BLKGET copies (RPNT) to BLKBUF,
; BLKPUT copies BLKBUF to (RPNT)

BLKPUT	LDY #$00
	BEQ BLKPUT0

BLKGET	LDY #$40
BLKPUT0	STY BLKMOD
	TAY
        LDA #0
        BEQ BLKGET0

; like BLKGET/BLKPUT, but advance RPNT

BLKPUTA	LDY #$00
	BEQ BLKPUT1

BLKGETA	LDY #$40
BLKPUT1	STY BLKMOD
	TAY
	CMP #0
	BEQ BLKGET1
BLKGET0	CLC
	ADC RPNT
	PHA
	LDA RPNT+1
	ADC #0
	PHA
	JMP BLKGET2
BLKGET1	LDA RPNT
	PHA
	CLC
	LDA RPNT+1
	ADC #1
	PHA
BLKGET2 LDX #0
	JSR BLKRW
	PLA
	STA RPNT+1
	PLA
	STA RPNT
	RTS

; general block r/w routine
; set RPNT to address of data block
; X = offset in BLKBUF
; Y = number of bytes to transfer (0 means 256 bytes)
; note: PBMEM is now used for all memory accesses above $4000

BLKRW	STY BLKBYT	; length

; calc end of block, store it in BLKEND
	DEY
	TYA
	CLC
	ADC RPNT
	STA BLKEND
	LDA RPNT+1
	ADC #0
	STA BLKEND+1

BLKRW2
;	TXA
;	PHA
;	DBGADR 0,RPNT
;	DBGADR 4,BLKEND
;	PLA
;	TAX

	LDA RPNT+1
	CMP #$3F
	BCS BLKRW3
	JMP BLKCLO
BLKRW3	BNE BLKRW5
	JMP BLKCHK0	; check if block overlaps with $40

BLKRW5	CMP #$CF
	BCC BLKCSTD
	BNE BLKRW6
	JMP BLKCHK1	; check if block overlaps with $D0

BLKRW6	CMP #$D7
	BCS BLKRW7
	JMP BLKCCH

BLKRW7	BNE BLKRW8
	JMP BLKCHK2	; check if block overlaps with $D8

BLKRW8	CMP #$FF
	BNE BLKCSTD
	JMP BLKCHK3	; check if block wraps around $FFFF

; access standard RAM and OS/BASIC ROM area
BLKCSTD	LDA PBMEM	; check if OS is disabled during memory access
	AND #1
	BNE BLKCSTD0
	JSR BLKDMA0	; yes, so disable DMA
BLKCSTD0 LDA PBMEM	; setup portb
	STA PORTB

	LDY #0
	BIT BLKMOD
	BVC BLKCST2	; branch if write
; read from memory
BLKCST1	LDA (RPNT),Y
	STA BLKBUF,X
	INY
	INX
	DEC BLKBYT
	BNE BLKCST1
BLKDMA1	LDA #$FF
	STA PORTB
	LDA #$22
	STA DMACTL
	RTS

BLKDMA0	LDA BLKBYT
	CMP #1
	BEQ BLKDMAF
BLKDMAW	LDA VCOUNT
	CMP #94
	BNE BLKDMAW
	BEQ BLKDMAE
BLKDMAF	LDA VCOUNT
	CMP #93
	BCC BLKDMAF
BLKDMAE	LDA #0
	STA DMACTL
	RTS

; write to memory
BLKCST2	LDA BLKBUF,X
	STA (RPNT),Y
	INY
	INX
	DEC BLKBYT
	BNE BLKCST2
	JMP BLKDMA1

; access $0000-$3FFF with CPAGE helper program

BLKCLO	LDA #$FF
	STA PORTB

	BIT BLKMOD
	BVC BLKCLOW	; branch if write

; read from low memory
	LDY #RBLKCL-1
BLKCLO1	LDA CPAGE,Y
	STA USEMAP,Y
	LDA RBLKCP,Y
	STA CPAGE,Y
	DEY
	BPL BLKCLO1
	INY
	LDA RPNT
	STA CPAGE+(RBLKADR-RBLKCP)+1
	LDA RPNT+1
	STA CPAGE+(RBLKADR-RBLKCP)+2
	JSR BLKDMA0
	JMP CPAGE

RBLKCP	STA BRKCTL
RBLKADR	LDA $EEEE,Y
	STA BRKCTL
	STA BLKBUF,X
	INX
	INY
	DEC BLKBYT
	BNE RBLKCP
	JMP BLKCLO2
RBLKCL	= * - RBLKCP

BLKCLO2	LDY #RBLKCL-1
BLKCLO3	LDA USEMAP,Y
	STA CPAGE,Y
	DEY
	BPL BLKCLO3
	JMP BLKDMA1

; write to low memory
BLKCLOW	LDY #WBLKCL-1
BLKCLO4	LDA CPAGE,Y
	STA USEMAP,Y
	LDA WBLKCP,Y
	STA CPAGE,Y
	DEY
	BPL BLKCLO4
	INY
	LDA RPNT
	STA CPAGE+(WBLKADR-WBLKCP)+1
	LDA RPNT+1
	STA CPAGE+(WBLKADR-WBLKCP)+2
	JSR BLKDMA0
	JMP CPAGE

WBLKCP	LDA BLKBUF,X
	STA BRKCTL
WBLKADR	STA $EEEE,Y
	STA BRKCTL
	INX
	INY
	DEC BLKBYT
	BNE WBLKCP
	JMP BLKCLO5
WBLKCL	= * - WBLKCP

BLKCLO5	LDY #WBLKCL-1
BLKCLO6	LDA USEMAP,Y
	STA CPAGE,Y
	DEY
	BPL BLKCLO6
	JMP BLKDMA1

; access custom chip area $D000-$D7FF

; pia
BLKCCHI	LDA BLPNT
	AND #$07
	TAY
	BIT BLKMOD
	BVC BLKCCWI
	CPY #6
	BCC BLKCC1I
	LDA #$FF
	BNE BLKCC2I
BLKCC1I	LDA SPORTA,Y
BLKCC2I	STA BLKBUF,X
	JMP BLKCCHN
BLKCCWI	CPY #6
	BCS BLKCC3I
	LDA BLKBUF,X
	STA SPORTA,Y
BLKCC3I	JMP BLKCCHN

; antic
BLKCCHA	LDA BLPNT
	AND #$0F
	TAY
	BIT BLKMOD
	BVC BLKCCWA
	LDA SANTIC,Y
	STA BLKBUF,X
	JMP BLKCCHN
BLKCCWA	LDA BLKBUF,X
	STA SANTIC,Y
	JMP BLKCCHN

; cart area $D5xx
BLKCCHC	BIT BLKMOD
	BVC BLKCCWC
	LDA #$FF
	STA BLKBUF,X
	JMP BLKCCHN
BLKCCWC	LDA BLKBUF,X
	STA (BLPNT),Y
	JMP BLKCCHN


BLKCCH	LDA RPNT
	STA BLPNT
	LDA RPNT+1
	STA BLPNT+1
BLKCCHL	LDY #0
	LDA BLPNT+1
	CMP #$D7	; sector buffer
	BEQ BLKCCHS
	BIT DIOMODE
	BMI BLKCCHD	; direct I/O access

	CMP #$D0
	BEQ BLKCCHG	; GTIA
	CMP #$D2
	BEQ BLKCCHP	; POKEY
	CMP #$D3
	BEQ BLKCCHI	; PIA
	CMP #$D4
	BEQ BLKCCHA	; ANTIC
	CMP #$D5
	BEQ BLKCCHC	; cart area

	BIT BLKMOD
	BVC BLKCCHN	; ignore write to unknown area
	LDA #$FF
	STA BLKBUF,X

BLKCCHN	INX		; next byte
	INC BLPNT
	BNE BLKCCH9
	INC BLPNT+1
BLKCCH9	DEC BLKBYT
	BNE BLKCCHL
	RTS

; access sector buffer
BLKCCHS	LDY BLPNT
	BIT BLKMOD
	BVC BLKCCWS
	LDA DBUF,Y	; read
	STA BLKBUF,X
	JMP BLKCCHN

BLKCCWS	LDA BLKBUF,X	; write
	STA DBUF,Y
	JMP BLKCCHN

; direct I/O access
BLKCCHD	BIT BLKMOD
	BVC BLKCCWD
	LDA (BLPNT),Y
	STA BLKBUF,X
	JMP BLKCCHN

BLKCCWD	LDA BLKBUF,X
	STA (BLPNT),Y
	JMP BLKCCHN

; gtia
BLKCCHG	LDA BLPNT
	AND #$1F
	TAY
	BIT BLKMOD
	BVC BLKCCWG
	LDA SGTIA,Y
	STA BLKBUF,X
	JMP BLKCCHN
BLKCCWG	LDA BLKBUF,X
	STA SGTIA,Y
	JMP BLKCCHN
	
; pokey
BLKCCHP	LDA BLPNT
	AND #$0F
	TAY
	LDA BLPNT
	AND #$10	; possibly accessing second pokey?
	BEQ BLKCCHP1	; no, first pokey, no need for further checks
	LDA DPOKEYF	; currently in dual pokey mode?
	BEQ BLKCCHP2	; yes, access secondary pokey

; access main pokey shadow
BLKCCHP1
	BIT BLKMOD
	BVC BLKCCWP
	LDA SPOKEY,Y
	STA BLKBUF,X
	JMP BLKCCHN
BLKCCWP	LDA BLKBUF,X
	STA SPOKEY,Y
	JMP BLKCCHN

; access second pokey shadow
BLKCCHP2
	BIT BLKMOD
	BVC BLKCCWP2
	LDA SPOKEY2,Y
	STA BLKBUF,X
	JMP BLKCCHN
BLKCCWP2
	LDA BLKBUF,X
	STA SPOKEY2,Y
	JMP BLKCCHN


; check for overlap with $4000

BLKCHK0	LDA BLKEND+1
	CMP #$3F
	BNE BLKCH41
	JMP BLKCLO	; all below $4000 - OK

BLKCH41	SEC
	LDA #0		; copy adr-$3FFF
	SBC RPNT
	STA BLKBYT
	JSR BLKCLO
	LDA #0		; copy $4000-end
	STA RPNT
	LDA #$40
	STA RPNT+1
	LDA BLKEND
	STA BLKBYT
	INC BLKBYT
	JMP BLKCSTD

; check for overlap with $D000

BLKCHK1	LDA BLKEND+1
	CMP #$CF
	BNE BLKCH11
	JMP BLKCSTD	; all below $D000 - OK

BLKCH11	SEC
	LDA #0		; copy adr-$CFFF
	SBC RPNT
	STA BLKBYT
	JSR BLKCSTD
	LDA #0		; copy $D000-end
	STA RPNT
	LDA #$D0
	STA RPNT+1
	LDA BLKEND
	STA BLKBYT
	INC BLKBYT
	JMP BLKCCH

; check for overlap with $D800

BLKCHK2	LDA BLKEND+1
	CMP #$D7
	BNE BLKCH21
	JMP BLKCCH	; all below $D800 - OK

BLKCH21	SEC
	LDA #0		; copy adr-$D7FF
	SBC RPNT
	STA BLKBYT
	JSR BLKCCH
	LDA #0		; copy $D800-end
	STA RPNT
	LDA #$D8
	STA RPNT+1
	LDA BLKEND
	STA BLKBYT
	INC BLKBYT
	JMP BLKCSTD

; check for wrap-around at $FFFF

BLKCHK3	LDA BLKEND+1
	BEQ BLKCH31
	JMP BLKCSTD	; all below $10000 - OK

BLKCH31	SEC
	LDA #0		; copy adr-$FFFF
	SBC RPNT
	STA BLKBYT
	JSR BLKCSTD
	LDA #0		; copy $0000-end
	STA RPNT
	STA RPNT+1
	LDA BLKEND
	STA BLKBYT
	INC BLKBYT
	JMP BLKCLO

; memory byte operations

;GET BYTE FROM (RPNT),Y

GETBYT LDA RPNT
      PHA
      LDA RPNT+1
      PHA
      TYA                ; CALC ADDRESS
      CLC 
      ADC RPNT
      STA RPNT
      BCC GETBY1
      INC RPNT+1
GETBY1 LDA #1
      JSR BLKGET
      PLA
      STA RPNT+1
      PLA
      STA RPNT
      LDA BLKBUF
      RTS

NOJERK LDA VCOUNT
      CMP #93
      BCC NOJERK
      LDA #$FE
      STA PORTB
      RTS 

;STORE BYTE TO (RPNT),Y

STOBYT STA BLKBUF
      LDA RPNT
      PHA
      LDA RPNT+1
      PHA
      TYA                ; CALC ADDRESS
      CLC 
      ADC RPNT
      STA RPNT
      LDA RPNT+1
      BCC STOBY1
      INC RPNT+1
STOBY1 LDA #1
      JSR BLKPUT
      PLA
      STA RPNT+1
      PLA
      STA RPNT
      RTS


