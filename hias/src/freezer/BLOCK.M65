; block compare / set / move commands
COMB  LDY #$82 
      CMP #'C-$20
      BEQ COMB1
      LDY #0
      CMP #'S-$20
      BEQ COMB1
      LDY #$80
      CMP #'M-$20
      BEQ COMB1
COMB0 JMP DEBU3

COMB1 STY BLKMOD
      INC NCOUNT
      JSR EATSPC
      LDA #0
      JSR MATCH
      BCC COMB0
      STA BLKSRC
      STX BLKSRC+1
      LDA #',
      JSR MATCH
      BCC COMB0
      
      LDA #0
      JSR MATCH
      BCC COMB0
      STA BLKEND
      STX BLKEND+1

      SEC		; calculate blklen from end-src+1
      LDA BLKEND
      SBC BLKSRC
      STA BLKLEN
      LDA BLKEND+1
      SBC BLKSRC+1
      STA BLKLEN+1
      INC BLKLEN
      BNE COMB12
      INC BLKLEN+1

COMB12 LDA #',
      JSR MATCH
      BCC COMB0

      LDA #0
      JSR MATCH
      BCC COMB0
      STA BLKDST
      STX BLKDST+1

      JSR SCROLL
      LDA #$20
      JSR PUTBYT
      LDA #'B
      JSR PUTBYT

      LDA #'S
      LDY BLKMOD
      BPL COMB2
      LDA #'M
      CPY #$82
      BNE COMB2
      LDA #'C
COMB2 JSR PUTBYT

      LDA BLKSRC
      LDX BLKSRC+1
      JSR PRTADR
      LDA #',
      JSR PUTBYT

      LDA BLKEND
      LDX BLKEND+1
      JSR PRTADR
      LDA #',
      JSR PUTBYT

      LDA BLKDST
      LDX BLKDST+1
      BIT BLKMOD
      BMI COMB4	; copy/move mode

      JSR PRTBYT

; block set mode: setup BLKBUF

      LDX #0
      LDA BLKDST
COMB3 STA BLKBUF,X
      INX
      BNE COMB3

; move address from BLKSRC to BLKDST

      LDA BLKSRC
      STA BLKDST
      LDA BLKSRC+1
      STA BLKDST+1
      JMP BLKLOOP

; block move/diff

COMB4 JSR PRTADR

      LDA BLKMOD
      CMP #$82
      BNE BLKCOP
      JMP BLKDIFF

BLKCOP	LDA BLKDST+1
	CMP BLKSRC+1
	BCC BLKLOOP
	BNE BLKREV
	LDA BLKDST
	CMP BLKSRC
	BCC BLKLOOP

; reverse direction

BLKREV	INC BLKMOD
	CLC
	LDA BLKSRC
	ADC BLKLEN
	STA BLKSRC
	LDA BLKSRC+1
	ADC BLKLEN+1
	STA BLKSRC+1
	CLC
	LDA BLKDST
	ADC BLKLEN
	STA BLKDST
	LDA BLKDST+1
	ADC BLKLEN+1
	STA BLKDST+1

BLKLOOP	
;	DBGADR 0, BLKLEN

	LDA BLKLEN
	ORA BLKLEN+1
	BNE BLKLOP1

BLKXIT	JMP DEBU3

BLKLOP1	LDA BLKMOD
	BPL BLKNGET
	ORA #$40
	STA BLKMOD
	LDX #0
	JSR BLKNXT	; calc next src address
	JSR BLKCBUF	; read buffer
BLKNGET	LDX #2
	JSR BLKNXT	; calc next dest address
	LDA BLKMOD
	AND #$BF
	STA BLKMOD
	JSR BLKCBUF	; write buffer
	LDA BLKLEN+1
	BEQ BLKXIT
	DEC BLKLEN+1
	LDX #3
BLKLOP2	LDA BLKSRCN,X	; move on to next address
	STA BLKSRC,X
	DEX
	BPL BLKLOP2
	BMI BLKLOOP

; calc next address (X=0: SRC X=2: DST)

BLKNXT	LDA #1
	BIT BLKMOD
	BNE BLKNXR	; branch if reverse

	LDA BLKLEN+1
	BNE BLKNX1

	CLC		; add remaining len
	LDA BLKSRC,X
	ADC BLKLEN
	STA BLKSRCN,X
	LDA BLKSRC+1,X
	ADC #0
	STA BLKSRCN+1,X
	RTS

BLKNX1	LDA BLKSRC,X	; next page
	STA BLKSRCN,X
	CLC
	LDA BLKSRC+1,X
	ADC #1
	STA BLKSRCN+1,X
	RTS

BLKNXR	LDA BLKLEN+1
	BNE BLKNXR1

	SEC		; sub remaining len
	LDA BLKSRC,X
	SBC BLKLEN
	STA BLKSRCN,X
	LDA BLKSRC+1,X
	SBC #0
	STA BLKSRCN+1,X
	RTS

BLKNXR1	LDA BLKSRC,X	; prev page
	STA BLKSRCN,X
	SEC
	LDA BLKSRC+1,X
	SBC #1
	STA BLKSRCN+1,X
	RTS

; copy data from/to BLKBUF

BLKCBUF	
;	TXA
;	PHA
;	LDA BLKMOD
;	LDX #4
;	DBGA
;	PLA
;	TAX

	LDA #1
	BIT BLKMOD
	BVC BLKSTOR	; branch if write

; copy (BLKSRC) to BLKBUF
	BNE BLKGR	; branch if reverse
	LDA BLKSRC
	LDX BLKSRC+1
	JMP BLKGGO
BLKGR	LDA BLKSRCN
	LDX BLKSRCN+1
	JMP BLKGGO

; copy BLKBUF to (BLKDST)
BLKSTOR	BNE BLKSR	; branch if reverse
	LDA BLKDST
	LDX BLKDST+1
	JMP BLKGGO
BLKSR	LDA BLKDSTN
	LDX BLKDSTN+1

BLKGGO	STA RPNT
	STX RPNT+1

	LDX #0

	LDY BLKLEN
	LDA BLKLEN+1
	BEQ BLKG1
	LDY #0

BLKG1	JMP BLKRW	; copy buffer

; compare two memory blocks and print differences

BLKDIFF	LDA #$40
	STA BLKMOD
	LDA BLKLEN
	ORA BLKLEN+1
	BNE BLKDIF0
	JMP DEBU3

BLKDIF0	LDY BLKLEN
	LDA BLKLEN+1
	BEQ BLKDIF1
	LDY #0

BLKDIF1	STY TPNT
	LDA BLKSRC
	STA RPNT
	LDA BLKSRC+1
	STA RPNT+1
	LDX #0
	JSR BLKRW

	LDX #0
BLKDIF2	LDA BLKBUF,X
	STA SRBUF1,X
	INX
	BNE BLKDIF2

	LDA BLKDST
	STA RPNT
	LDA BLKDST+1
	STA RPNT+1
	LDX #0
	LDY TPNT
	JSR BLKRW

	LDX #0
BLKDIF3	LDA SRBUF1,X
	CMP BLKBUF,X
	BEQ BLKDIF4

	STX TPNT+1

	JSR SCROLL
	LDX TPNT+1
	LDA SRBUF1,X
	LDY #0
	JSR BLKDIFP

	LDA #$20
	JSR PUTBYT
	LDA #$20
	JSR PUTBYT

	LDX TPNT+1
	LDA BLKBUF,X
	LDY #2
	JSR BLKDIFP

	LDX TPNT+1

BLKDIF4	INX
	CPX TPNT
	BNE BLKDIF3

	INC BLKSRC+1
	INC BLKDST+1
	DEC BLKLEN+1
	LDA BLKLEN+1
	CMP #$FF
	BEQ BLKDIF5
	JMP BLKDIFF
BLKDIF5	JMP DEBU3

BLKDIFP	PHA
	PHA
	TXA
	CLC
	ADC BLKSRC,Y
	PHA
	LDA BLKSRC+1,Y
	ADC #0
	PHA
	LDA #$20
	JSR PUTBYT
	PLA
	TAX
	PLA
	JSR PRTADR
	LDA #$20
	JSR PUTBYT
	LDA #$20
	JSR PUTBYT
	PLA
	JSR PRTBYT
	LDA #$20
	JSR PUTBYT
	PLA
	JSR PUTBYT
	RTS

