	.include "cio.inc"

ORG	= $2000

;DEBUG	= 1

; flash destiniation address ($0000-$3fff)
CRC	= $E0 ; $E1 - CRC 16
CONFIG	= $E2 ; $E3 - patch configuration
TMPADR	= $E4 ; $E5
TMPCNT	= $E6

	* = ORG

	JSR INICTAB

MAINLP	BPUT 0, TITLEN, TITLE
MENULP	JSR GETCHAR
	CMP #'0
	BNE NEXIT
EXIT	JMP ($A)
NEXIT	CMP #'1
	BCC MENULP
	CMP #'5
	BCS MENULP

	PHA
	JSR PUTCHAR
	LDA #155
	JSR PUTCHAR
	PLA

	SEC
	SBC #'1
	ASL
	TAX
	LDA MODTAB,X
	STA CONFIG
	LDA MODTAB+1,X
	STA CONFIG+1

IFN	BPUT 0, FNTXTL, FNTXT
	INPUT 0, BUF
	BPL IOK
ABRT	JMP AGAIN
IOK	LDA BUF
	CMP #155
	BEQ ABRT
	OPEN 1,4,0,BUF
	BPL CHKIMG
OPERR	CLOSE 1
	PRINT 0, OPENERR
	JMP AGAIN

CHKIMG	BPUT 0, CHKTL, CHKT
	LDY #0
	LDA (CONFIG),Y
	STA BANKCNT
	STA OKCNT
	STA PATCNT
	INC CONFIG
	BNE CHKLP
	INC CONFIG+1

CHKLP	BGET 1, 8192, DATA
	BPL RDOK1
	JMP RDERR
RDOK1	JSR INITCRC

	LDA #<DATA
	STA TMPADR
	LDA #>DATA
	STA TMPADR+1
	LDA #32
	STA TMPCNT
	LDY #0
CRCLP	LDA (TMPADR),Y
	JSR UPDCRC
	INY
	BNE CRCLP
	INC TMPADR+1
	DEC TMPCNT
	BNE CRCLP

	.IF .DEF DEBUG
	LDA CRC+1
	JSR PUTHEX
	LDA CRC
	JSR PUTHEX
	LDA #155
	JSR PUTCHAR
	.ENDIF

	LDY #0
	LDA CRC
	CMP (CONFIG),Y
	BNE NCRC1
	INY
	LDA CRC+1
	CMP (CONFIG),Y
	BNE NCRC1
	DEC OKCNT

NCRC1	LDY #2
	LDA CRC
	CMP (CONFIG),Y
	BNE NCRC2
	INY
	LDA CRC+1
	CMP (CONFIG),Y
	BNE NCRC2
	DEC PATCNT
	
NCRC2	CLC
	LDA CONFIG
	ADC #4
	STA CONFIG
	LDA CONFIG+1
	ADC #0
	STA CONFIG+1

	DEC BANKCNT
	BEQ ENDCHK
	JMP CHKLP

ENDCHK	BGET 1, 1, DATA
	BMI RDEOF
	JMP FTOLONG

RDEOF	CLOSE 1
	LDA OKCNT
	BEQ CRCOK
	LDA PATCNT
	BNE ILLFIL
	PRINT 0, ALRPAT
	JMP AGAIN
ILLFIL	PRINT 0, CRCERR
	JMP AGAIN

CRCOK	JSR POK
	BPUT 0, PATTL, PATT
	OPEN 1, 12, 0, BUF
	BPL OPENOK1
	JMP OPERR

OPENOK1	LDA #0
	STA FILEPOS
	STA FILEPOS+1
PATCHLP	LDY #0
	LDA (CONFIG),Y
	BEQ ENDPAT
	INY
	LDA (CONFIG),Y
	STA SEEKPOS
	INY
	LDA (CONFIG),Y
	STA SEEKPOS+1

	JSR SEEK
	BPL SOK
	JMP RDERR
SOK	JSR PATCHIT
	BPL PAOK
	JMP WRERR
PAOK	LDY #0
	CLC
	LDA (CONFIG),Y
	ADC #3
	CLC
	ADC CONFIG
	STA CONFIG
	LDA CONFIG+1
	ADC #0
	STA CONFIG+1
	JMP PATCHLP

ENDPAT	CLOSE 1
	JSR POK

AGAIN	BPUT 0, AGATL, AGAT
AGALP	JSR GETCHAR
	CMP #'Y
	BEQ YAGA
	CMP #'y
	BEQ YAGA
	CMP #'n
	BEQ NAGA
	CMP #'N
	BNE AGALP
NAGA	JMP EXIT
YAGA	JMP MAINLP

SEEK	SEC
	LDA SEEKPOS
	SBC FILEPOS
	STA SEEKTMP
	LDA SEEKPOS+1
	SBC FILEPOS+1
	STA SEEKTMP+1

SEEKLP	LDA SEEKTMP
	ORA SEEKTMP+1
	BEQ ENDSEEK

	LDA SEEKTMP+1
	CMP #32
	BCC NSEEK1
	BGET 1, 8192, DATA
	BPL SOK1
SEEKERR	LDA #$FF
	RTS

SOK1	CLC
	LDA FILEPOS+1
	ADC #32
	STA FILEPOS+1
	SEC
	LDA SEEKTMP+1
	SBC #32
	STA SEEKTMP+1
	JMP SEEKLP

NSEEK1	BGET2 1, SEEKTMP, DATA
	BMI SEEKERR
	CLC
	LDA FILEPOS
	ADC SEEKTMP
	STA FILEPOS
	LDA FILEPOS+1
	ADC SEEKTMP+1
	STA FILEPOS+1

ENDSEEK	LDA #0
	RTS

PATCHIT	LDX #$10
	LDA #CPBIN
	STA ICCOM,X
	CLC
	LDA CONFIG
	ADC #3
	STA ICBAL,X
	LDA CONFIG+1
	ADC #0
	STA ICBAH,X
	LDY #0
	LDA (CONFIG),Y
	STA ICBLL,X
	TYA
	STA ICBLH,X
	JSR CIOV
	BPL PATCH1
	LDA #$FF
	RTS

PATCH1	CLC
	LDY #0
	LDA (CONFIG),Y
	ADC FILEPOS
	STA FILEPOS
	LDA FILEPOS+1
	ADC #0
	STA FILEPOS+1
	LDA #0
	RTS

RDERR	CLOSE 1
	PRINT 0, READERR
	JMP AGAIN

WRERR	CLOSE 1
	PRINT 0, WRITERR
	JMP AGAIN

FTOLONG	CLOSE 1
	PRINT 0, TOOLNGT
	JMP AGAIN

PUTCHAR	TAY
	LDA $E407
	PHA
	LDA $E406
	PHA
	TYA
	RTS

GETCHAR	LDA $E425
	PHA
	LDA $E424
	PHA
	RTS

PUTHEX	PHA
	LSR
	LSR
	LSR
	LSR
	TAX
	LDA HEXTAB,X
	JSR PUTCHAR
	PLA
	AND #$0F
	TAX
	LDA HEXTAB,X
	JMP PUTCHAR

POK	PRINT 0, OKT
	RTS

PERROR	PRINT 0, ERRT
	RTS

BANKCNT	.BYTE 0
OKCNT	.BYTE 0
PATCNT	.BYTE 0

FILEPOS	.WORD 0
SEEKPOS	.WORD 0
SEEKTMP	.WORD 0

; patch configuration:
; number of 8k blocks
; crc orig / crc patched ...
; patch offset ...
; $FFFF

BXE41	.BYTE 2
	.WORD $8EC3, $1E48
	.WORD $A401, $A401

	.BYTE 3
	.WORD $1FA5
	.BYTE $EA, $EA, $EA

	.BYTE 3
	.WORD $1FB2
	.BYTE $EA, $EA, $EA

	.WORD 0

SDX419	.BYTE 8
	.WORD $974C, $974C
	.WORD $18C2, $18C2
	.WORD $536C, $536C
	.WORD $E97E, $E97E
	.WORD $6D3F, $6D3F
	.WORD $615C, $615C
	.WORD $CA56, $CA56
	.WORD $B056, $8E90

	.BYTE 3
	.WORD $E0F1,
	.BYTE $EA, $EA, $EA

	.WORD 0

SDX421	.BYTE 8
	.WORD $70AE, $70AE
	.WORD $2A32, $2A32
	.WORD $BA2A, $BA2A
	.WORD $E97E, $E97E
	.WORD $6D3F, $6D3F
	.WORD $26FF, $26FF
	.WORD $4909, $4909
	.WORD $6C97, $5251

	.BYTE 3
	.WORD $E0F1
	.BYTE $EA, $EA, $EA

	.WORD 0

SDX422	.BYTE 8
	.WORD $49C5, $49C5
	.WORD $7584, $7584
	.WORD $867D, $867D
	.WORD $BB0B, $BB0B
	.WORD $6D3F, $6D3F
	.WORD $98A3, $98A3
	.WORD $3ACC, $3ACC
	.WORD $C967, $F7A1

	.BYTE 3
	.WORD $E0F1
	.BYTE $EA, $EA, $EA

	.WORD 0

MODTAB	.WORD BXE41
	.WORD SDX419, SDX421, SDX422

	.include crc16.src

EAEAEA	.BYTE $EA, $EA, $EA

HEXTAB	.BYTE "0123456789ABCDEF"
	
TITLE	.BYTE 125,"Freezer Cartridge ROM Patcher V1.0",155
	.BYTE "(c) 2005 by Matthias Reichl",155,155

	.BYTE "1) Basic XE 4.1",155
	.BYTE "2) SpartaDosX 4.19",155
	.BYTE "3) SpartaDosX 4.21",155
	.BYTE "4) SpartaDosX 4.22",155
	.BYTE 155,"0) exit program",155
	.BYTE "> "
TITLEN	= * - TITLE

AGAT	.BYTE 155
	.BYTE "restart program (y/n)? "
AGATL	= * - AGAT

FNTXT	.BYTE "Filename > "
FNTXTL	= * - FNTXT

OKT	.BYTE "OK", 155
ERRT	.BYTE "ERROR", 253, 155

OPENERR	.BYTE "error opening file!",155
READERR	.BYTE "error reading file!",155
WRITERR	.BYTE "error writing file!",155
TOOLNGT	.BYTE "error - file too long!", 155

CRCERR	.BYTE "error - invalid file?",155
ALRPAT	.BYTE "file already patched",155

CHKT	.BYTE "CRC check: "
CHKTL	= * - CHKT

PATT	.BYTE " patching: "
PATTL	= * - PATT

BUF	.DC 128 0


	* = (*+255) & $FF00
CRCLO	* = * + 256
CRCHI	* = * + 256
DATA	= *

	* = $2E0
	.WORD ORG
